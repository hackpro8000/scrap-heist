end, nil, RUBBER)
part("Bars", nil, BARE_METAL, function(mesh)
	cylinder(mesh, 0.92, 0, 2.85, 0.07, 1.5, "y", 8)
	sphere(mesh, 1.25, 0, 2.5, 0.3, 0.3, 0.3, 6, 12)
