	end
end, nil, 0.05)
part("Body", nil, SKY, function(mesh)
	box(mesh, -0.9, 0, 1.3, 1.5, 0.7, 0.9)
	box(mesh, 0.1, 0, 1.2, 0.9, 0.6, 0.3)
	-- The leg shield and the fork up to the bars.
	box(mesh, 0.9, 0, 1.3, 0.2, 0.8, 1.3)
	strut(mesh, 1.25, 0, 1.1, 0.95, 0, 2.7, 0.2)
end, nil, 0.15)
