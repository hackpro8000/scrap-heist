end, nil, 0.7)

part("Frame", nil, DARK_STEEL, function(mesh)
	for _, x in { -1.82, 1.82 } do
		box(mesh, x + (if x < 0 then -0.08 else 0.08), 0, 0.7, 0.16, 1.2, 0.4)
