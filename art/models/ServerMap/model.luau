	box(mesh, 0, 0, 0.2, 0.35, 0.35, 6.8)
	box(mesh, 1.2, 0, 6.6, 2.6, 0.2, 0.2)
	strut(mesh, 0.1, 0, 5.6, 1.1, 0, 6.6, 0.12)
