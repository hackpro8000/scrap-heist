		{ SOCKET_OUTER, SOCKET_FRONT },
		{ SOCKET_OUTER, SOCKET_BACK },
	}
	local rows = {}
	for i = 0, SOCKET_SIDES - 1 do
		local t = i / SOCKET_SIDES * 2 * math.pi
		local row = {}
		for k, p in profile do
			row[k] = mesh:vertex(x + math.sin(t) * p[1], p[2], z + math.cos(t) * p[1])
