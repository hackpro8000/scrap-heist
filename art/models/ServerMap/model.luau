local FACE = { { -0.3, -0.5, 3.05, 0.24 }, { 0.3, -0.5, 3.1, 0.27 } }
local FEET = { 0.9, 0.5 }
part("Shell", nil, { 0.95, 0.96, 0.98 }, function(mesh)
