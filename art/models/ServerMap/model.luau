end, nil, 0)
part("Caps", nil, BARE_METAL, function(mesh)
	for k = -2, 2 do
		sphere(mesh, k * 0.3, 0.62 + math.abs(k) * 0.05, 3.76 - math.abs(k) * 0.15, 0.13, 0.13, 0.1, 4, 8)
