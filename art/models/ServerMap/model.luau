	tube(mesh, { { 0, 2.55, 0.42 }, { 0, 2.1, 0.42 }, { 0, 1.8, 0.36 } }, 0.07, 6)
	for _, x in { -0.4, 0.4 } do
		bolt(mesh, x, 2.75, 0.8, "z", 0.05)
