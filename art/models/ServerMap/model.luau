end, nil, 0.4)
part("Dials", nil, { 0.85, 0.82, 0.72 }, function(mesh)
	for _, x in { -0.95, 0.95 } do
		cylinder(mesh, x, -0.5, 1.2, 0.22, 0.12, "y", 12)
