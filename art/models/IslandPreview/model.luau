local SHARD_COSTS = {  } local PAINT_COSTS: { [string]: number } = {  } local PAINT_DEAL = ""
-- Layout prelude: lets a layout build other models in place. Each model's
-- script is wrapped as build<Name>(), and place() runs it with every vertex
-- moved, turned about z, optionally scaled up or down as a whole and
-- optionally stretched along one axis. Parts are
-- renamed <Label>_<Part> so game code can find each placed piece by label.
local placeX, placeY, placeZ, placeTurn, placeStretch, placeAxis = 0, 0, 0, 0, 1, "x"
local placeScale = 1
local placeLabel = ""
local RealMesh, realPart = Mesh, model.part

-- Set further down, with the shard deal: whether this shard paints a part.
local paintsPart: (name: string, image: any) -> boolean

-- While a split model builds, every image it creates is noted in order, so
-- its parts can be dealt by texels before any is painted (see ownsPart).
local RealImage = Image
local splitImages: { any }? = nil

-- While a split model builds, an image is a promise of one: its size is known
-- at once, for the deal, and its pixels are made when something first paints
-- or reads them. A shard keeps only its share of a split model's parts, so it
-- never makes the pixels of the rest.
local function promisedImage(width: number, height: number, ...)
	local made = nil
	local colour = table.pack(...)
	local function real()
		if not made then
			made = RealImage.new(width, height, table.unpack(colour, 1, colour.n))
		end
		return made
	end
	return setmetatable({
		_real = real,
		width = function()
			return width
		end,
		height = function()
			return height
		end,
		size = function()
			return width, height
		end,
	}, {
		__index = function(_, key)
			return function(_, ...)
				local image = real()
				return image[key](image, ...)
			end
		end,
	})
end

local function unwrapImage(image)
	return if type(image) == "table" and image._real then image._real() else image
end

Image = setmetatable({
	new = function(width, height, ...)
		if splitImages then
			local image = promisedImage(width, height, ...)
			table.insert(splitImages, image)
			return image
		end
		return RealImage.new(width, height, ...)
	end,
}, { __index = RealImage })

local function unwrapMesh(mesh)
	return if type(mesh) == "table" and mesh._mesh then mesh._mesh else mesh
end

Mesh = {
	new = function()
		local real = RealMesh.new()
		local c, s = math.cos(placeTurn), math.sin(placeTurn)
		local ox, oy, oz = placeX, placeY, placeZ
		local scale = placeScale
		local stretchX = scale * (if placeAxis == "x" then placeStretch else 1)
		local stretchY = scale * (if placeAxis == "y" then placeStretch else 1)
		return setmetatable({
			_mesh = real,
			vertex = function(_, x, y, z)
				x, y = x * stretchX, y * stretchY
				return real:vertex(x * c - y * s + ox, x * s + y * c + oy, z * scale + oz)
			end,
			paintShading = function(_, image, options)
				-- A model split across shards paints only this shard's parts.
				if options and options.name and not paintsPart(options.name, image) then
					return
				end
				for _, list in { "occluders", "group" } do
					if options and options[list] then
						local real = {}
						for i, other in options[list] do
							real[i] = unwrapMesh(other)
						end
						options[list] = real
					end
				end
				return real:paintShading(unwrapImage(image), options)
			end,
			paint = function(_, image, ...)
				return real:paint(unwrapImage(image), ...)
			end,
		}, {
			__index = function(_, key)
				return function(_, ...)
					return real[key](real, ...)
				end
			end,
		})
	end,
}

-- A placed item caches its shell entries, which hold meshes; the cache
-- stores real meshes only, so unwrap them first. Inside a place() build the
-- placement cache already stores the item, so skip the item's own cache.
local realCached = model.cached
local builtParts = nil
model.cached = function(key, build)
	if builtParts then
		return build()
	end
	return realCached(key, function()
		local result = build()
		if type(result) == "table" then
			for _, entry in result do
				if type(entry) == "table" and entry.mesh then
					entry.mesh = unwrapMesh(entry.mesh)
				end
			end
		end
		return result
	end)
end

-- Layouts override this to leave out parts, such as fill levels.
local function skipPart(_name: string): boolean
	return false
end

-- The assembler fills this with a hash of each used model's source, so
-- place() can build each model once and reuse it at every placement.
local buildKeys = {}
-- And a hash of each slab body with the code around it, by the line its
-- function starts on, so placeSlab() can reuse an unchanged slab.
local slabKeys = {}

-- With modelkit --shard, each placement goes to the shard with the least work
-- dealt so far, by its measured build time (SHARD_COSTS, from the assembler's
-- <Layout>Costs.txt; unmeasured ones count as the median). A model a shard has
-- already built costs it almost nothing to place again, so repeats of a prop
-- gather on one shard. Every machine runs the same deal in the same order, so
-- between them the shards build each placement once. A placement inside
-- another one's build belongs to it, and isn't dealt: whether it runs depends
-- on that build being cached.
--
-- A model build costing well over half an even share, and marked "#split"
-- (most of its parts are shaded through a named paint, as finishParts does),
-- is split into pieces of about half an even share across the least-loaded
-- shards: small pieces leave the deal room to even the shards out. Each piece's
-- shard builds the geometry, which is cheap, but paints and keeps only its
-- share of the parts. Parts are dealt by
-- texels: a build creates every image before painting any, so the images are
-- sorted largest first and each goes to the share with the fewest texels so
-- far. Every shard in the split deals the same images the same way. Placing
-- that model again goes to the same shards, each keeping the same parts.
--
-- Texels are a poor guide to paint time (a ground chunk paints seven times
-- faster than a dirt chunk of the same size), so once paint times have been
-- measured (PAINT_COSTS, from the assembler's <Layout>PaintCosts.txt, which
-- scripts/paint-costs.sh writes from a build's logs) parts are dealt by those
-- instead. A chunk's paint also shades the chunks next to it unless this
-- shard has shaded them already (bake.rs), so neighbours belong on one shard:
-- the measured parts named for a place on the chunk grid (<Kind>_<x>_<y>_<z>,
-- as chunkedPart names them) are put in order by 2 x 2 block of cells, then
-- cell, and that line is cut into one run of equal paint time per share
-- (plannedShares). Any other part, as its paint is asked for, goes to the
-- share with the least paint time so far; one with no measured time counts as
-- its texels at the measured average rate. Every shard asks for the same
-- paints in the same order, so they still deal alike.
local REPEAT_COST = 0.01
-- Pieces are about this much of an even share; a model splits once it costs
-- a quarter more than one piece.
local SPLIT_PIECE = 0.5
local SPLIT_ABOVE = 1.25
local shardLoads, shardModels, splitModels = {}, {}, {}
local medianCost, totalCost = 1, 0
do
	local costs = {}
	for key, seconds in SHARD_COSTS do
		if not string.find(key, " #split$") then
			table.insert(costs, seconds)
			totalCost += seconds
		end
	end
	table.sort(costs)
	if #costs > 0 then
		medianCost = costs[(#costs + 1) // 2]
	end
end

-- While a split model builds: this shard's share, out of how many, and once
-- its images are dealt, which share keeps each image and each share's texels.
type PartShare = { index: number, count: number, owners: { [any]: number }?, texels: { number } }
local partShare: PartShare? = nil
-- Parts seen while building, and how many were shaded through a named paint,
-- so a build can tell whether splitting it would save any paint.
local partsEmitted, partsGated = 0, 0

local function texelsOf(image: any): number
	local width, height = image:size()
	return width * height
end

local paintRate: number? = PAINT_COSTS["#rate"]

-- What a part's paint weighs in the deal: its measured seconds, or its texels
-- when no paint times have been measured.
local function paintWeight(name: string?, image: any): number
	if not paintRate then
		return texelsOf(image)
	end
	return (name and PAINT_COSTS[name]) or texelsOf(image) * paintRate
end

-- The measured chunk parts' shares for a split into `count`, by name, and the
-- paint time each share is given by them.
local sharePlans: { [number]: { owners: { [string]: number }, loads: { number } } } = {}
local function plannedShares(count: number)
	if sharePlans[count] then
		return sharePlans[count]
	end
	local chunks, total = {}, 0
	for name, seconds in PAINT_COSTS do
		local x, y, z = string.match(name, "^%a+_(%-?%d+)_(%-?%d+)_(%-?%d+)")
		if x then
			x, y, z = tonumber(x) :: number, tonumber(y) :: number, tonumber(z) :: number
			table.insert(chunks, { name = name, seconds = seconds, key = { x // 2, y // 2, x, y, z } })
			total += seconds
		end
	end
	table.sort(chunks, function(a, b)
		for i = 1, 5 do
			if a.key[i] ~= b.key[i] then
				return a.key[i] < b.key[i]
			end
		end
		return a.name < b.name
	end)
	local plan = { owners = {}, loads = table.create(count, 0) }
	local before = 0
	for _, chunk in chunks do
		-- By the middle of its own time, so a long paint lands on the run it mostly lies in.
		local share = math.min(count, (before + chunk.seconds / 2) * count // total + 1)
		plan.owners[chunk.name] = share
		plan.loads[share] += chunk.seconds
		before += chunk.seconds
	end
	sharePlans[count] = plan
	return plan
end

-- Gives an image to the share with the least weight (texels, or seconds) so far.
local function dealImage(share: PartShare, image: any, texels: number): number
	local lightest = 1
	for index = 2, share.count do
		if share.texels[index] < share.texels[lightest] then
			lightest = index
		end
	end
	(share.owners :: { [any]: number })[image] = lightest
	share.texels[lightest] += texels
	return lightest
end

-- Deals every image the split build has made, largest first; ties go by the
-- order they were made, so every shard deals them alike.
local function dealImages(share: PartShare)
	local images = {}
	for order, image in splitImages or {} do
		table.insert(images, { image = image, texels = texelsOf(image), order = order })
	end
	table.sort(images, function(a, b)
		return if a.texels ~= b.texels then a.texels > b.texels else a.order < b.order
	end)
	share.owners = {}
	for _, entry in images do
		dealImage(share, entry.image, entry.texels)
	end
end

-- Whether this shard keeps a part of the split model being built: by its
-- texture's share when it has one (an image made after the deal goes to the
-- lightest share then), else by a hash of its name.
local function ownsPart(name: string, image: any?): boolean
	if not partShare then
		return true
	end
	if image then
		if not partShare.owners then
			if paintRate then
				-- By measured paint time: the chunk parts' runs are planned,
				-- and the rest are dealt one by one, as each is asked for.
				partShare.owners = {}
				partShare.texels = table.clone(plannedShares(partShare.count).loads)
			else
				dealImages(partShare)
			end
		end
		local owners = partShare.owners :: { [any]: number }
		local owner = owners[image]
		if not owner then
			local planned = if paintRate then plannedShares(partShare.count).owners[name] else nil
			if planned then
				owners[image] = planned
				owner = planned
			else
				owner = dealImage(partShare, image, paintWeight(name, image))
			end
		end
		return owner == partShare.index
	end
	local hash = 5381
	for i = 1, #name do
		hash = (hash * 33 + string.byte(name, i)) % 4294967296
	end
	return hash % partShare.count + 1 == partShare.index
end
-- Every named shading paint (finishParts in common.luau passes the part's
-- name) asks this first, through the Mesh wrapper above.
paintsPart = function(name: string, image: any): boolean
	partsGated += 1
	return ownsPart(name, image)
end

-- The shards a split takes, and which of them this one is.
local function shareOf(shards: { number }): (boolean, number?, number?)
	local index = table.find(shards, SHARD_INDEX)
	return index ~= nil, index, #shards
end

-- Deals one placement: whether this shard builds it, and for a split model
-- which share of its parts this shard keeps, out of how many. `reuses`, when
-- given, names the model build this placement reuses.
local function inThisShard(costKey: string, reuses: string?): (boolean, number?, number?)
	if builtParts or SHARD_COUNT == nil then
		return true
	end
	local cost = SHARD_COSTS[costKey] or medianCost
	local split = reuses and splitModels[reuses]
	if split then
		for _, shard in split do
			shardLoads[shard] = (shardLoads[shard] or 0) + REPEAT_COST
		end
		return shareOf(split)
	end
	local fairShare = if totalCost > 0 then totalCost / SHARD_COUNT else medianCost
	local piece = fairShare * SPLIT_PIECE
	if reuses and SHARD_COSTS[`{costKey} #split`] and cost > piece * SPLIT_ABOVE then
		local order = {}
		for shard = 1, SHARD_COUNT do
			order[shard] = shard
		end
		table.sort(order, function(a, b)
			local loadA, loadB = shardLoads[a] or 0, shardLoads[b] or 0
			return if loadA ~= loadB then loadA < loadB else a < b
		end)
		split = table.move(order, 1, math.min(SHARD_COUNT, math.ceil(cost / piece)), 1, {})
		for _, shard in split do
			shardLoads[shard] = (shardLoads[shard] or 0) + cost / #split
		end
		splitModels[reuses] = split
		return shareOf(split)
	end
	local best, bestLoad = 1, math.huge
	for shard = 1, SHARD_COUNT do
		shardModels[shard] = shardModels[shard] or {}
		local extra = if reuses and shardModels[shard][reuses] then REPEAT_COST else cost
		local load = (shardLoads[shard] or 0) + extra
		if load < bestLoad then
			best, bestLoad = shard, load
		end
	end
	shardLoads[best] = bestLoad
	if reuses then
		shardModels[best][reuses] = true
	end
	return best == SHARD_INDEX
end

-- Times a cached build when sharding, printing lines the build workflow
-- gathers into <Layout>Costs.txt for the next deal: its time, and "#split"
-- when most of its parts are shaded through a named paint, so splitting pays.
-- A split's own build (`splitHere`) paints only its share, so its time is
-- scaled up by its share of the texels; builds nested in a split aren't timed.
local function timedBuild(costKey: string, build: () -> any, splitHere: boolean?): any
	if SHARD_COUNT == nil then
		return build()
	end
	local started, emitted, gated = os.clock(), partsEmitted, partsGated
	local result = build()
	local seconds = os.clock() - started
	if splitHere and partShare then
		local all = 0
		for _, texels in partShare.texels do
			all += texels
		end
		local mine = partShare.texels[partShare.index]
		seconds = if mine > 0 then seconds * all / mine else -1
	elseif partShare then
		seconds = -1
	end
	if seconds >= 0 then
		print(string.format("SHARD_COST\t%s\t%.3f", costKey, seconds))
	end
	emitted, gated = partsEmitted - emitted, partsGated - gated
	if emitted > 0 and gated * 2 >= emitted then
		print(string.format("SHARD_COST\t%s #split\t1", costKey))
	end
	return result
end

local function addPart(name, mesh, image, preview, emissive)
	if skipPart(name) then
		return
	end
	realPart(placeLabel .. "_" .. name, mesh, image, { preview = preview, emissive = emissive })
end

model.part = function(name, mesh, image, options)
	local preview = if options and options.preview ~= nil then options.preview else true
	if builtParts then
		partsEmitted += 1
		if skipPart(name) or not ownsPart(name, image) then
			return
		end
		table.insert(builtParts, { name = name, mesh = unwrapMesh(mesh), image = unwrapImage(image), preview = preview, emissive = options and options.emissive })
		return
	end
	addPart(name, unwrapMesh(mesh), unwrapImage(image), preview, options and options.emissive)
end

-- Says which object a placement is, for the upload (scripts/export-objects.py
-- reads these lines from the build's output): its label, its turn in
-- degrees, and the key its build is cached under, or "-" when it has none.
-- Placements with one key are copies of one object, uploaded once. A
-- placement inside another's build is part of that object, and isn't told.
local function tellPlacement(label: string, turn: number, key: string)
	if not builtParts then
		print(string.format("PLACED\t%s\t%s\t%s", label, tostring(turn), key))
	end
end

-- `scale` builds the model that many times its own size, so its textures
-- keep their density instead of being stretched with it.
-- Set while a slab builds. A slab's cache key leaves out the models the
-- layout uses (scripts/assemble-model.sh), so a slab must not place one.
local slabBuilding: string? = nil

local function place(label: string, build: () -> (), x: number, y: number, z: number?, turn: number?, stretch: number?, axis: string?, scale: number?)
	if slabBuilding then
		error(`slab {slabBuilding} places {label}: place models outside slabs, as a slab's cache key doesn't follow model changes`)
	end
	local key = buildKeys[build]
	if not key then
		if not inThisShard(`place {label}`) then
			return
		end
		tellPlacement(label, turn or 0, "-")
		placeLabel = label
		placeX, placeY, placeZ, placeTurn = x, y, z or 0, math.rad(turn or 0)
		placeStretch, placeAxis, placeScale = stretch or 1, axis or "x", scale or 1
		build()
		placeScale = 1
		return
	end
	-- Built once at the origin per model, scale and stretch, then moved into
	-- place, so moving a prop never rebuilds it. Eye previews size textures by
	-- distance, so there placements share a build per distance band.
	local variant = if (scale or 1) == 1 then `{stretch or 1} {axis or "x"}` else `{stretch or 1} {axis or "x"} x{scale}`
	-- Costs are keyed by model name, not source hash, so an edited model keeps
	-- its last measured cost until it's measured again.
	local costKey = `{string.match(key, "^(.-)%-%x+$") or key} {variant}`
	local owns, share, shares = inThisShard(costKey, `{key} {variant}`)
	if not owns then
		return
	end
	placeLabel = label
	placeX, placeY, placeZ, placeTurn = x, y, z or 0, math.rad(turn or 0)
	placeStretch, placeAxis, placeScale = stretch or 1, axis or "x", scale or 1
	key = `{key} {variant}`
	if previewBand then
		key = `{key} band {previewBand(x, y, z or 0)}`
	end
	-- A split build keeps only its share of the parts, so it caches apart. The
	-- texel deal follows from the model's source, already in the key.
	if share then
		key = `{key} part {share}/{shares}`
		-- The deal by measured paint times follows from those too.
		if PAINT_DEAL ~= "" then
			key = `{key} deal {PAINT_DEAL}`
		end
	end
	tellPlacement(label, turn or 0, key)
	local x0, y0, z0, turn0 = placeX, placeY, placeZ, placeTurn
	for _, part in model.cached(key, function()
		local outerShare, outerImages = partShare, splitImages
		if share then
			partShare = { index = share, count = shares :: number, texels = table.create(shares :: number, 0) }
			splitImages = {}
		end
		local built = timedBuild(costKey, function()
			placeX, placeY, placeZ, placeTurn = 0, 0, 0, 0
			if previewPlacing then
				previewPlacing(x0, y0, z0, turn0)
			end
			builtParts = {}
			build()
			if previewPlacing then
				previewPlacing()
			end
			local built = builtParts
			builtParts = nil
			return built
		end, share ~= nil)
		partShare, splitImages = outerShare, outerImages
		return built
	end) do
		addPart(part.name, part.mesh:moved(turn0, x0, y0, z0), part.image, part.preview, part.emissive)
	end
	placeX, placeY, placeZ, placeTurn = x0, y0, z0, turn0
	placeScale = 1
end

-- Places a piece built where it stands. Its paint can depend on where it
-- stands, so it is cached in place, keyed on its source and placement.
-- finish(), if given, runs after build() inside the cached build.
local function placeSlab(label: string, build: () -> (), x: number, y: number, turn: number?, finish: (() -> ())?)
	local key = slabKeys[debug.info(build, "l")]
	if not key then
		error(`slab {label} has no cache key; start its body on a line ending in "function()"`)
	end
	local costKey = `slab {label}`
	if not inThisShard(costKey) then
		return
	end
	-- A slab is built where it stands, so it is its own object, unturned.
	tellPlacement(label, 0, `{key} {label} {x} {y} {turn or 0}`)
	placeLabel = label
	placeX, placeY, placeZ, placeTurn = x, y, 0, math.rad(turn or 0)
	placeStretch, placeAxis, placeScale = 1, "x", 1
	for _, part in model.cached(`{key} {label} {x} {y} {turn or 0}`, function()
		return timedBuild(costKey, function()
			builtParts = {}
			slabBuilding = label
			build()
			if finish then
				finish()
			end
			slabBuilding = nil
			local built = builtParts
			builtParts = nil
			return built
		end)
	end) do
		addPart(part.name, part.mesh, part.image, part.preview, part.emissive)
	end
end
-- Rarity accents, in sRGB: grey common, green uncommon, blue rare, gold
-- legendary.
local COMMON = { 0.62, 0.62, 0.6 }
local UNCOMMON = { 0.3, 0.72, 0.3 }
local RARE = { 0.25, 0.5, 0.95 }
local LEGENDARY = { 1.0, 0.72, 0.18 }
local STEEL = { 0.62, 0.64, 0.66 }
local DARK_STEEL = { 0.3, 0.3, 0.32 }
local COPPER = { 0.85, 0.5, 0.25 }
local TAU = 2 * math.pi

-- Edge highlight and feathering, matching the salvage machine.
local EDGE_HIGHLIGHT = 0.6
local CONTACT_SHADOW = 0.425
-- Scales every part's wear (rust, grime, scratches): 57% of what each part asks for.
local WEAR = 0.57
local GRADIENT = 0.5
local EDGE_BLEND = 0.7
local SMOOTH_ANGLE = 30
local TEXTURE = 256

-- Faces are split into a grid about every 0.4 studs so the warp in
-- `part` can bend and dent flat panels.
local GRID = 0.4

-- When set, every part sizes its texture to this many pixels per stud
-- instead of the fixed TEXTURE, so a layout reads at one texel density.
-- A part's own `texture` size still wins.
local texelDensity: number? = nil
-- The density the layout asked for, before TEXEL_SCALE: chunk sizes follow
-- this one, so a max-detail preview keeps the chunks it would ship with.
local layoutDensity: number? = nil

-- Previews build at a fraction of the density the layout asks for (TEXEL_SCALE).
local function useTexelDensity(pixelsPerStud: number)
	layoutDensity = pixelsPerStud
	texelDensity = pixelsPerStud * (TEXEL_SCALE or 1)
end

local function gridFace(mesh, origin, u, v, nu, nv)
	local rows = {}
	for j = 0, nv do
		rows[j] = {}
		for i = 0, nu do
			local a, b = i / nu, j / nv
			rows[j][i] = mesh:vertex(
				origin[1] + u[1] * a + v[1] * b,
				origin[2] + u[2] * a + v[2] * b,
				origin[3] + u[3] * a + v[3] * b
			)
		end
	end
	for j = 0, nv - 1 do
		for i = 0, nu - 1 do
			mesh:face({ rows[j][i], rows[j][i + 1], rows[j + 1][i + 1], rows[j + 1][i] })
		end
	end
end

local function box(mesh, cx, cy, cz, sx, sy, sz)
	local x0, y0, z0 = cx - sx / 2, cy - sy / 2, cz
	local nx = math.clamp(math.ceil(sx / GRID), 1, 8)
	local ny = math.clamp(math.ceil(sy / GRID), 1, 8)
	local nz = math.clamp(math.ceil(sz / GRID), 1, 8)
	gridFace(mesh, { x0, y0, z0 }, { 0, sy, 0 }, { sx, 0, 0 }, ny, nx)
	gridFace(mesh, { x0, y0, z0 + sz }, { sx, 0, 0 }, { 0, sy, 0 }, nx, ny)
	gridFace(mesh, { x0, y0, z0 }, { sx, 0, 0 }, { 0, 0, sz }, nx, nz)
	gridFace(mesh, { x0, y0 + sy, z0 }, { 0, 0, sz }, { sx, 0, 0 }, nz, nx)
	gridFace(mesh, { x0, y0, z0 }, { 0, 0, sz }, { 0, sy, 0 }, nz, ny)
	gridFace(mesh, { x0 + sx, y0, z0 }, { 0, sy, 0 }, { 0, 0, sz }, ny, nz)
end

-- Cylinder centered at (cx, cy, cz) along axis "x", "y" or "z".
local function cylinder(mesh, cx, cy, cz, radius, length, axis, sides)
	sides = sides or 16
	local a, b = {}, {}
	for i = 0, sides - 1 do
		local t = i / sides * TAU
		local u, w = math.cos(t) * radius, math.sin(t) * radius
		local h = length / 2
		if axis == "x" then
			a[i + 1] = mesh:vertex(cx - h, cy + u, cz + w)
			b[i + 1] = mesh:vertex(cx + h, cy + u, cz + w)
		elseif axis == "y" then
			a[i + 1] = mesh:vertex(cx + w, cy - h, cz + u)
			b[i + 1] = mesh:vertex(cx + w, cy + h, cz + u)
		else
			a[i + 1] = mesh:vertex(cx + u, cy + w, cz - h)
			b[i + 1] = mesh:vertex(cx + u, cy + w, cz + h)
		end
	end
	for i = 1, sides do
		local j = i % sides + 1
		mesh:face({ a[i], a[j], b[j], b[i] })
	end
	local capA = {}
	for i = sides, 1, -1 do
		table.insert(capA, a[i])
	end
	mesh:face(capA)
	mesh:face(b)
end

-- UV sphere, squashed per axis by (rx, ry, rz).
local function sphere(mesh, cx, cy, cz, rx, ry, rz, rings, sides)
	rings, sides = rings or 8, sides or 16
	local grid = {}
	for r = 0, rings do
		local phi = r / rings * math.pi
		grid[r] = {}
		for s = 0, sides - 1 do
			local t = s / sides * TAU
			local x = math.sin(phi) * math.cos(t)
			local y = math.sin(phi) * math.sin(t)
			grid[r][s] = mesh:vertex(cx + x * rx, cy + y * ry, cz - math.cos(phi) * rz)
		end
	end
	for r = 0, rings - 1 do
		for s = 0, sides - 1 do
			local n = (s + 1) % sides
			mesh:face({ grid[r][s], grid[r][n], grid[r + 1][n], grid[r + 1][s] })
		end
	end
end

-- Flat ring (washer) facing along axis "x", "y" or "z": a rim round an eye,
-- a hub, a hose clamp.
local function ring(mesh, cx, cy, cz, inner, outer, depth, axis, sides)
	sides = sides or 16
	local function at(r, t, d)
		local u, w = math.cos(t) * r, math.sin(t) * r
		if axis == "x" then
			return mesh:vertex(cx + d, cy + u, cz + w)
		elseif axis == "y" then
			return mesh:vertex(cx + w, cy + d, cz + u)
		end
		return mesh:vertex(cx + u, cy + w, cz + d)
	end
	local rows = {}
	for i = 0, sides - 1 do
		local t = i / sides * TAU
		rows[i + 1] = { at(outer, t, -depth / 2), at(outer, t, depth / 2), at(inner, t, depth / 2), at(inner, t, -depth / 2) }
	end
	for i = 1, sides do
		local a, b = rows[i], rows[i % sides + 1]
		for k = 1, 4 do
			local l = k % 4 + 1
			mesh:face({ a[k], b[k], b[l], a[l] })
		end
	end
end

-- Bolt head: a squat hexagonal stud on a face pointing along axis.
local function bolt(mesh, cx, cy, cz, axis, size)
	size = size or 0.05
	cylinder(mesh, cx, cy, cz, size, size * 0.7, axis, 6)
end

-- Square beam from one point to another, for limbs and antennae.
local function strut(mesh, x0, y0, z0, x1, y1, z1, thick)
	local dx, dy, dz = x1 - x0, y1 - y0, z1 - z0
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	dx, dy, dz = dx / len, dy / len, dz / len
	local ax, ay, az = -dy, dx, 0
	if math.abs(dz) > 0.99 then
		ax, ay, az = 1, 0, 0
	end
	local al = math.sqrt(ax * ax + ay * ay + az * az)
	ax, ay, az = ax / al * thick / 2, ay / al * thick / 2, az / al * thick / 2
	local bx, by, bz = dy * az - dz * ay, dz * ax - dx * az, dx * ay - dy * ax
	local v = {}
	for i = 0, 7 do
		local sa = if i % 2 == 0 then -1 else 1
		local sb = if i // 2 % 2 == 0 then -1 else 1
		local x, y, z = if i // 4 == 0 then x0 else x1, if i // 4 == 0 then y0 else y1, if i // 4 == 0 then z0 else z1
		v[i + 1] = mesh:vertex(x + ax * sa + bx * sb, y + ay * sa + by * sb, z + az * sa + bz * sb)
	end
	for _, f in { { 1, 3, 4, 2 }, { 5, 6, 8, 7 }, { 1, 2, 6, 5 }, { 3, 7, 8, 4 }, { 1, 5, 7, 3 }, { 2, 4, 8, 6 } } do
		mesh:face({ v[f[1]], v[f[2]], v[f[3]], v[f[4]] })
	end
end

-- Points along a circular arc in the x-z plane, from angle a0 to a1 in
-- degrees. Feeds plate outlines; run the angles downward for a clockwise path.
local function arc(cx, cz, radius, a0, a1, steps)
	local points = {}
	for i = 0, steps do
		local a = math.rad(a0 + (a1 - a0) * i / steps)
		table.insert(points, { cx + math.cos(a) * radius, cz + math.sin(a) * radius })
	end
	return points
end

-- Splits a clockwise x-z outline into triangles by ear clipping, so concave
-- silhouettes cap cleanly. Returns index triples into the outline.
local function earClip(outline)
	local left, tris = {}, {}
	for i = 1, #outline do
		left[i] = i
	end
	local function cross(a, b, c)
		return (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
	end
	local guard = 0
	while #left > 3 and guard < 10000 do
		guard += 1
		local clipped = false
		for k = 1, #left do
			local i0, i1, i2 = left[(k - 2) % #left + 1], left[k], left[k % #left + 1]
			local a, b, c = outline[i0], outline[i1], outline[i2]
			if cross(a, b, c) < 0 then
				local inside = false
				for _, j in left do
					if j ~= i0 and j ~= i1 and j ~= i2 then
						local p = outline[j]
						if cross(a, b, p) <= 0 and cross(b, c, p) <= 0 and cross(c, a, p) <= 0 then
							inside = true
							break
						end
					end
				end
				if not inside then
					table.insert(tris, { i0, i1, i2 })
					table.remove(left, k)
					clipped = true
					break
				end
			end
		end
		if not clipped then
			break
		end
	end
	if #left == 3 then
		table.insert(tris, { left[1], left[2], left[3] })
	end
	return tris
end

-- Flat cut-out plate: a clockwise x-z outline extruded `depth` along y,
-- centred on y, with both faces chamfered inward by `bevel`. Use it for any
-- silhouette (signs, blades, brackets) instead of stacking boxes.
local function plate(mesh, outline, y, depth, bevel)
	local n = #outline
	local inset = {}
	for i = 1, n do
		local p0, p1, p2 = outline[(i - 2) % n + 1], outline[i], outline[i % n + 1]
		local function inward(a, b)
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local len = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
			return dz / len, -dx / len
		end
		local n1x, n1z = inward(p0, p1)
		local n2x, n2z = inward(p1, p2)
		local bx, bz = n1x + n2x, n1z + n2z
		local bl = math.max(math.sqrt(bx * bx + bz * bz), 1e-6)
		bx, bz = bx / bl, bz / bl
		local scale = math.min(1 / math.max(bx * n1x + bz * n1z, 0.34), 3) * bevel
		inset[i] = { p1[1] + bx * scale, p1[2] + bz * scale }
	end
	local h = depth / 2
	local layers = {
		{ inset, y - h },
		{ outline, y - h + bevel },
		{ outline, y + h - bevel },
		{ inset, y + h },
	}
	local rows = {}
	for l, layer in layers do
		rows[l] = {}
		for i = 1, n do
			rows[l][i] = mesh:vertex(layer[1][i][1], layer[2], layer[1][i][2])
		end
	end
	for l = 1, 3 do
		for i = 1, n do
			local j = i % n + 1
			mesh:face({ rows[l][i], rows[l][j], rows[l + 1][j], rows[l + 1][i] })
		end
	end
	for _, t in earClip(inset) do
		mesh:face({ rows[1][t[3]], rows[1][t[2]], rows[1][t[1]] })
		mesh:face({ rows[4][t[1]], rows[4][t[2]], rows[4][t[3]] })
	end
end

-- Unit tangent along (tx, ty, tz) plus two unit axes across it, right-handed,
-- the first level with the ground unless the tangent runs nearly vertical.
local function crossFrame(tx, ty, tz)
	local tl = math.sqrt(tx * tx + ty * ty + tz * tz)
	tx, ty, tz = tx / tl, ty / tl, tz / tl
	local ux, uy, uz = -ty, tx, 0
	if math.abs(tz) > 0.9 then
		ux, uy, uz = 0, tz, -ty
	end
	local ul = math.sqrt(ux * ux + uy * uy + uz * uz)
	ux, uy, uz = ux / ul, uy / ul, uz / ul
	return tx, ty, tz, ux, uy, uz, ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
end

-- Round tube through `points` ({x, y, z} each), capped at both ends: rope
-- strands, and bolts on curved faces.
local function tube(mesh, points, radius, sides)
	sides = sides or 8
	local function unit(a, b)
		local x, y, z = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local length = math.sqrt(x * x + y * y + z * z)
		if length < 1e-6 then
			return nil
		end
		return { x / length, y / length, z / length }
	end
	local rings = {}
	local carried
	for i, p in points do
		local before, after = points[math.max(i - 1, 1)], points[math.min(i + 1, #points)]
		local into, out = i > 1 and unit(before, p) or nil, i < #points and unit(p, after) or nil
		-- Each ring lies across the bisector of its bend.
		local dx, dy, dz = after[1] - before[1], after[2] - before[2], after[3] - before[3]
		if into and out then
			local x, y, z = into[1] + out[1], into[2] + out[2], into[3] + out[3]
			if x * x + y * y + z * z > 1e-6 then
				dx, dy, dz = x, y, z
			end
		end
		local tx, ty, tz, ux, uy, uz, vx, vy, vz = crossFrame(dx, dy, dz)
		-- Carry the last ring's frame round the bend, so the tube can't twist.
		if carried then
			local along = carried[1] * tx + carried[2] * ty + carried[3] * tz
			local x, y, z = carried[1] - tx * along, carried[2] - ty * along, carried[3] - tz * along
			local length = math.sqrt(x * x + y * y + z * z)
			if length > 1e-6 then
				ux, uy, uz = x / length, y / length, z / length
				vx, vy, vz = ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
			end
		end
		carried = { ux, uy, uz }
		-- A ring across a bend is widened toward the bend's outside, or the tube
		-- would pinch there.
		local stretch, bx, by, bz = 1, 0, 0, 0
		if into and out then
			local x, y, z = out[1] - into[1], out[2] - into[2], out[3] - into[3]
			local length = math.sqrt(x * x + y * y + z * z)
			if length > 1e-6 then
				bx, by, bz = x / length, y / length, z / length
				stretch = 1 / math.max(tx * out[1] + ty * out[2] + tz * out[3], 0.5)
			end
		end
		local ring = {}
		for k = 0, sides - 1 do
			local t = k / sides * TAU
			local c, n = math.cos(t) * radius, math.sin(t) * radius
			local x, y, z = ux * c + vx * n, uy * c + vy * n, uz * c + vz * n
			local extra = (x * bx + y * by + z * bz) * (stretch - 1)
			ring[k + 1] = mesh:vertex(p[1] + x + bx * extra, p[2] + y + by * extra, p[3] + z + bz * extra)
		end
		rings[i] = ring
	end
	for i = 1, #rings - 1 do
		local a, b = rings[i], rings[i + 1]
		for k = 1, sides do
			local n = k % sides + 1
			mesh:face({ a[k], a[n], b[n], b[k] })
		end
	end
	local cap = {}
	for k = sides, 1, -1 do
		table.insert(cap, rings[1][k])
	end
	mesh:face(cap)
	mesh:face(rings[#rings])
end

-- `points` with each inner corner replaced by a curve starting up to `reach`
-- studs before it, for wires and hoses that shouldn't have sharp elbows.
local function roundedPath(points, reach, steps)
	steps = steps or 4
	local path = { points[1] }
	for i = 2, #points - 1 do
		local a, p, b = points[i - 1], points[i], points[i + 1]
		local function towards(q)
			local x, y, z = q[1] - p[1], q[2] - p[2], q[3] - p[3]
			local length = math.sqrt(x * x + y * y + z * z)
			local r = math.min(reach, length / 2) / length
			return { p[1] + x * r, p[2] + y * r, p[3] + z * r }
		end
		local first, last = towards(a), towards(b)
		for s = 0, steps do
			local t = s / steps
			local m0, m1, m2 = (1 - t) ^ 2, 2 * t * (1 - t), t * t
			table.insert(path, {
				first[1] * m0 + p[1] * m1 + last[1] * m2,
				first[2] * m0 + p[2] * m1 + last[2] * m2,
				first[3] * m0 + p[3] * m1 + last[3] * m2,
			})
		end
	end
	table.insert(path, points[#points])
	return path
end

-- Point in the plane across `axis` at centre (cx, cy, cz): radius r, angle t,
-- offset d along the axis.
local function onAxis(cx, cy, cz, axis, r, t, d)
	local u, w = math.cos(t) * r, math.sin(t) * r
	if axis == "x" then
		return cx + d, cy + u, cz + w
	elseif axis == "y" then
		return cx + w, cy + d, cz + u
	end
	return cx + u, cy + w, cz + d
end

-- Spur gear turning about `axis`, with square teeth and a hole for its shaft.
local function gear(mesh, cx, cy, cz, radius, thick, teeth, axis)
	local steps = teeth * 4
	local rows = {}
	for i = 0, steps - 1 do
		local t = i / steps * TAU
		-- Two samples up on the tooth, two down in the gap.
		local r = if i % 4 < 2 then radius else radius * 0.82
		local hole = radius * 0.25
		rows[i + 1] = {
			mesh:vertex(onAxis(cx, cy, cz, axis, r, t, -thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, r, t, thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, hole, t, thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, hole, t, -thick / 2)),
		}
	end
	for i = 1, steps do
		local a, b = rows[i], rows[i % steps + 1]
		for k = 1, 4 do
			local l = k % 4 + 1
			mesh:face({ a[k], b[k], b[l], a[l] })
		end
	end
	-- Shaft through the middle.
	cylinder(mesh, cx, cy, cz, radius * 0.25, thick * 1.8, axis, 8)
end

-- Drive belt wrapped round two pulleys turning about `axis`, the first at
-- (ax, ay, az) with radius ra, the second at (bx, by, bz) with radius rb.
local function belt(mesh, axis, ax, ay, az, ra, bx, by, bz, rb, thick)
	thick = thick or 0.025
	-- Work in the plane across the axis as (u, w), matching onAxis.
	local function flat(x, y, z)
		if axis == "x" then
			return y, z
		elseif axis == "y" then
			return z, x
		end
		return x, y
	end
	local au, aw = flat(ax, ay, az)
	local bu, bw = flat(bx, by, bz)
	local heading = math.atan2(bw - aw, bu - au)
	local points = {}
	-- Round the far side of b, then back round the far side of a.
	for i = 0, 8 do
		local t = heading - math.pi / 2 + i / 8 * math.pi
		local x, y, z = onAxis(bx, by, bz, axis, rb + thick, t, 0)
		table.insert(points, { x, y, z })
	end
	for i = 0, 8 do
		local t = heading + math.pi / 2 + i / 8 * math.pi
		local x, y, z = onAxis(ax, ay, az, axis, ra + thick, t, 0)
		table.insert(points, { x, y, z })
	end
	table.insert(points, points[1])
	tube(mesh, points, thick, 4)
end

-- Exhaust pipe along `points`, ending in a flared, soot-black lip.
local function exhaust(mesh, points, radius)
	tube(mesh, points, radius, 10)
	local a, b = points[#points - 1], points[#points]
	local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local length = math.sqrt(dx * dx + dy * dy + dz * dz)
	dx, dy, dz = dx / length, dy / length, dz / length
	tube(mesh, {
		{ b[1] - dx * 0.06, b[2] - dy * 0.06, b[3] - dz * 0.06 },
		{ b[1], b[2], b[3] },
	}, radius * 1.3, 10)
end

-- Little engine block: a box crankcase with a finned cylinder on top.
local function engine(mesh, cx, cy, cz, size)
	box(mesh, cx, cy, cz, size * 1.4, size, size * 0.7)
	local top = cz + size * 0.7
	cylinder(mesh, cx, cy, top + size * 0.35, size * 0.3, size * 0.7, "z", 12)
	for i = 0, 3 do
		ring(mesh, cx, cy, top + size * (0.1 + i * 0.17), size * 0.28, size * 0.45, size * 0.05, "z", 12)
	end
	box(mesh, cx, cy, top + size * 0.7, size * 0.5, size * 0.5, size * 0.1)
end

-- Bolt head on a curved face, standing out along the normal (nx, ny, nz).
local function stud(mesh, x, y, z, nx, ny, nz, size)
	size = size or 0.04
	local a, b = -size * 0.2, size * 0.5
	tube(mesh, { { x + nx * a, y + ny * a, z + nz * a }, { x + nx * b, y + ny * b, z + nz * b } }, size, 6)
end

-- Rope along `points`: two strands twisted round each other.
local function rope(mesh, points, radius)
	-- Resample the path finely enough for the twist to turn smoothly.
	local path = {}
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local steps = math.max(1, math.ceil(math.sqrt(dx * dx + dy * dy + dz * dz) / (radius * 0.8)))
		for k = 0, steps - 1 do
			table.insert(path, { a[1] + dx * k / steps, a[2] + dy * k / steps, a[3] + dz * k / steps })
		end
	end
	table.insert(path, points[#points])
	for strand = 0, 1 do
		local twisted = {}
		for i, p in path do
			local a, b = path[math.max(i - 1, 1)], path[math.min(i + 1, #path)]
			local _, _, _, ux, uy, uz, vx, vy, vz = crossFrame(b[1] - a[1], b[2] - a[2], b[3] - a[3])
			local t = i * 0.7 + strand * math.pi
			local c, n = math.cos(t) * radius * 0.45, math.sin(t) * radius * 0.45
			twisted[i] = { p[1] + ux * c + vx * n, p[2] + uy * c + vy * n, p[3] + uz * c + vz * n }
		end
		tube(mesh, twisted, radius * 0.6, 6)
	end
end

-- Rope lashed round a box at height z, its corners at x = +-halfX and
-- y from y0 to y1, rounded so it sits snug round each corner.
local function lashing(mesh, halfX, y0, y1, z, radius)
	local bend = radius * 3
	-- Corner centres counter-clockwise from (+X, y0), each with its start angle.
	local corners = {
		{ halfX - bend, y0 + bend, -math.pi / 2 },
		{ halfX - bend, y1 - bend, 0 },
		{ -halfX + bend, y1 - bend, math.pi / 2 },
		{ -halfX + bend, y0 + bend, math.pi },
	}
	local points = {}
	for _, c in corners do
		for k = 0, 3 do
			local t = c[3] + k / 3 * math.pi / 2
			table.insert(points, { c[1] + math.cos(t) * bend, c[2] + math.sin(t) * bend, z })
		end
	end
	table.insert(points, points[1])
	rope(mesh, points, radius)
end

-- Flat sheet lying on the face of a box at `axis` = `at`, its outer side toward
-- `sign`, covering a0..a1 along the other level axis and z0..z1 up, bolted at
-- each corner.
local function sheet(mesh, axis, at, sign, a0, a1, z0, z1, thick, boltSize)
	thick, boltSize = thick or 0.03, boltSize or 0.035
	local c = at + sign * thick / 2
	if axis == "x" then
		box(mesh, c, (a0 + a1) / 2, z0, thick, a1 - a0, z1 - z0)
	else
		box(mesh, (a0 + a1) / 2, c, z0, a1 - a0, thick, z1 - z0)
	end
	local inset = boltSize * 2
	for _, a in { a0 + inset, a1 - inset } do
		for _, z in { z0 + inset, z1 - inset } do
			if axis == "x" then
				bolt(mesh, at + sign * thick, a, z, "x", boltSize)
			else
				bolt(mesh, a, at + sign * thick, z, "y", boltSize)
			end
		end
	end
end

-- Angle bracket bent round the vertical box corner at (x, y), outer faces
-- toward sx and sy, legs `size` long, bolted through each leg.
local function cornerBracket(mesh, x, y, sx, sy, z, height, size)
	local t = 0.025
	box(mesh, x + sx * t / 2, y - sy * (size - t) / 2, z, t, size + t, height)
	box(mesh, x - sx * (size - t) / 2, y + sy * t / 2, z, size + t, t, height)
	for _, dz in { 0.25, 0.75 } do
		bolt(mesh, x + sx * t, y - sy * size * 0.6, z + height * dz, "x", 0.03)
		bolt(mesh, x - sx * size * 0.6, y + sy * t, z + height * dz, "y", 0.03)
	end
end

-- Weathering colors, in sRGB. The bake paints the wear itself, stroke by
-- stroke: rust patches, drips, grime and scratches on metal, dust and scuffs
-- on rubber. These are for parts made of the stuff.
local RUST_DARK = { 0.3, 0.2, 0.12 }
local RUST_ORANGE = { 0.62, 0.36, 0.15 }
local RUST_FLAKE = { 0.78, 0.52, 0.3 }
local BARE_METAL = { 0.74, 0.73, 0.7 }

-- How rusty a part painted by its own paint fn is; `rusting` sets it.
local paintRust = setmetatable({}, { __mode = "k" })

-- Marks a paint fn as `rust` worn (0 clean, 1 eaten through), for parts
-- whose coat has its own look but should still rust.
local function rusting(rust, paint)
	paintRust[paint] = rust
	return paint
end

local RUBBER = -1
local DUST = { 0.55, 0.5, 0.42 }
-- Bindings, painted as RUBBER: duct tape and hemp rope.
local TAPE = { 0.58, 0.58, 0.56 }
local RUBBER_BLACK = { 0.12, 0.12, 0.13 }
local ROPE = { 0.62, 0.5, 0.32 }

-- Part following one bone. `smooth` overrides the auto-smooth angle (true
-- for fully round parts like the zapper's body). `rust` sets how worn it
-- is, default 0.4; 0 for glowing eyes and visors; RUBBER for tyres and treads.
local WARP = 0.0385

-- Low-frequency warp so no panel is perfectly flat or square: a smooth sum
-- of sines seeded by the part name, plus a couple of dents.
local function imperfect(mesh, name)
	local seed = 0
	for i = 1, #name do
		seed = (seed * 31 + string.byte(name, i)) % 9973
	end
	local function n(k)
		return math.sin(seed * 12.9898 + k * 78.233) * 0.5 + 0.5
	end
	local function noise(x, y, z, k)
		return math.sin(x * (1.7 + n(k)) + y * 0.9 + n(k + 1) * TAU) * 0.5
			+ math.sin(y * (2.3 + n(k + 2)) - z * 1.3 + n(k + 3) * TAU) * 0.3
			+ math.sin(z * (2.9 + n(k + 4)) + x * 1.1 + n(k + 5) * TAU) * 0.2
	end
	local dents = {}
	for d = 1, 2 do
		local k = d * 10
		dents[d] = { (n(k) - 0.5) * 3, (n(k + 1) - 0.5) * 3, n(k + 2) * 4, 0.3 + n(k + 3) * 0.4 }
	end
	return setmetatable({
		vertex = function(_, x, y, z)
			local dx, dy, dz = noise(x, y, z, 1), noise(y, z, x, 7), noise(z, x, y, 13)
			for _, dent in dents do
				local ox, oy, oz = x - dent[1], y - dent[2], z - dent[3]
				local fall = math.exp(-(ox * ox + oy * oy + oz * oz) / (dent[4] * dent[4]))
				dx -= ox * fall * 0.6
				dy -= oy * fall * 0.6
				dz -= oz * fall * 0.6
			end
			return mesh:vertex(x + dx * WARP, y + dy * WARP, z + dz * WARP)
		end,
	}, {
		__index = function(_, key)
			return function(_, ...)
				return mesh[key](mesh, ...)
			end
		end,
	})
end

local parts = {}

-- What the bake paints on a part: `paint` gives its coat colors, `rust` how
-- worn it is, and `rubber` that it gathers dust and scuffs instead.
local function setLook(entry, color, rust)
	rust = rust or 0.4
	if type(rust) == "function" then
		entry.paint, entry.rust, entry.custom = rust, paintRust[rust] or 0, true
		return
	end
	entry.paint = function()
		return color[1], color[2], color[3]
	end
	entry.rust = math.max(rust, 0)
	entry.rubber = rust == RUBBER
end

local HAND_EDGE_MOTION = { rock = "feather", wood = "flick", metal = "worn" }

-- `rust` can also be a paint fn for surfaces with their own look.
-- `texture` overrides the texture size for parts that need more detail.
-- `emissive` is a glow strength (like SurfaceAppearance.EmissiveStrength);
-- glowing parts skip painted shading. `flat` skips the warp, for parts so
-- thin it would visibly bend them. `edge` is how far highlights and contact
-- shadows reach from an edge, in studs: bigger surfaces take a wider band.
-- `shade` multiplies the contact shadow strength, for parts that should sit in
-- heavier shadow than the standard wear. `lit` scales the highlight strength
-- and `wide` the width of the highlight brush strokes. Set `painted` on an entry
-- to paint its highlights as bold, fully loaded strokes instead of dry ones,
-- `blend` (0-1) to tint them from cream toward a lighter part colour, and
-- `taper` (studs) to run them full width at corners, thinning along each edge.
-- `softLit` (0-1) adds a wide, very soft highlight under the strokes, fading
-- out over `softEdge` studs from each edge; `softUneven` (0-1) makes its width
-- wander along the edge and `softTaper` (studs) thins it away from corners.
-- `softToZero` lets that thinning reach nothing, and `softPower` steepens the fade.
-- `strokes` lists brush strokes painted over the coat ({start, along, normal,
-- length, width, tail, color, brush}, color in sRGB), such as cracks or dabs;
-- `brush` is "taper" (crisp lines, the default), "round" or "sponge".
-- `stamps` lays the coat with scanned stroke shapes instead of the flat brush.
-- `hand` ("rock", "wood" or "metal") paints the coat the way a hand would, and
-- `handFocus` ({x, y, z, radius}) is where it gathers its finest strokes.
-- `handTune` sets any of its numbers by name (settings! in tools/modelkit/src/hand.rs).
-- `litMotion` draws the hard edge highlight with a moving hand, `litTune` sets its
-- numbers by name (tools/modelkit/src/marks.rs). A hand-painted part gets its
-- material's motion unless it names another, or `false` for the default strokes.
-- `brushes` draws any layer with a motion: edge, shade, soft, coat, grime, rust,
-- drip or scratch, each {motion = "press", tune = {name = value}}. A `strokes`
-- entry takes `motion` and `tune` the same way.
-- With `hand` as well, `crisp` keeps the shapes exact and takes only the brushwork's tone.
-- `crisp` lays the coat on texel by texel in the paint fn's exact colours
-- instead of brush strokes, for machine finishes (hazard tape, ribbed
-- rubber) that strokes would smear; shading still goes over it.
local function part(name, bone, color, build, smooth, rust, texture: number?, emissive: number?, flat: boolean?, edge: number?, shade: number?, lit: number?, wide: number?)
	local mesh = Mesh.new()
	build(if rust == 0 or flat then mesh else imperfect(mesh, name))
	mesh:setSmooth(if smooth ~= nil then smooth else SMOOTH_ANGLE)
	local fit = mesh:unwrap()
	local size = if texture then texture
		elseif texelDensity then math.clamp(math.ceil(texelDensity / fit / 4) * 4, 16, 1024)
		else TEXTURE
	local image = Image.new(size, size, color[1], color[2], color[3])
	local entry = { name = name, bone = bone, mesh = mesh, image = image, emissive = emissive, edge = edge, shade = shade, lit = lit, wide = wide }
	setLook(entry, color, rust)
	-- Glowing parts skip the painted bake, so their colors go on as they are.
	if emissive then
		mesh:paint(image, entry.paint)
	end
	table.insert(parts, entry)
end

-- Large surfaces (terrain, roads, floors) are split into cubes 128 studs
-- across, or 1024 texels at the layout's texel density if that is smaller,
-- each its own part with a texture up to 1024, named <name>_<cx>_<cy>_<cz>. The
-- build runs once into a recorder, then each face goes to the chunk holding
-- its centre. Cells sit on the origin across, and centred on z = 0 up and
-- down, so ground near sea level stays in one layer. `flat` skips the warp,
-- as for part(). Every chunk shades against one height range, the whole
-- mesh's z-range or the `heightRange` {bottom, top} given, so the gradient runs
-- on across chunks instead of restarting in each (a flat chunk would go dark).
local function chunkedPart(name, bone, color, build, smooth, rust, flat: boolean?, edge: number?, shade: number?, lit: number?, heightRange: { number }?)
	local CHUNK = if layoutDensity then math.min(128, 1024 / layoutDensity) else 128
	-- Smallest cell a chunk is halved down to while looking for a split.
	local MIN_CELL = 2
	local positions, faces = {}, {}
	local recorder = {
		vertex = function(_, x, y, z)
			table.insert(positions, { x, y, z })
			return #positions
		end,
		-- A vertex the rust wobble leaves alone, for surfaces that must stay flat.
		exactVertex = function(_, x, y, z)
			table.insert(positions, { x, y, z })
			return #positions
		end,
		face = function(_, verts, uvs)
			table.insert(faces, { verts = verts, uvs = uvs })
		end,
	}
	build(if rust == 0 or flat then recorder else imperfect(recorder, name))
	if not heightRange then
		local bottom, top = math.huge, -math.huge
		for _, p in positions do
			bottom, top = math.min(bottom, p[3]), math.max(top, p[3])
		end
		heightRange = { bottom, top }
	end

	local chunks, order = {}, {}
	for _, f in faces do
		local cx, cy, cz = 0, 0, 0
		for _, v in f.verts do
			local p = positions[v]
			cx, cy, cz = cx + p[1], cy + p[2], cz + p[3]
		end
		local n = #f.verts
		local key = `{math.floor(cx / n / CHUNK)}_{math.floor(cy / n / CHUNK)}_{math.floor(cz / n / CHUNK + 0.5)}`
		if not chunks[key] then
			chunks[key] = {}
			table.insert(order, key)
		end
		table.insert(chunks[key], f)
	end

	-- Each chunk becomes a part. With a texel density set, a chunk whose
	-- texture would need more than 1024 texels to hold it is split into
	-- octants until every piece fits, so the whole surface reads at one density.
	local function chunkMesh(chunkFaces)
		local mesh, remap = Mesh.new(), {}
		for _, f in chunkFaces do
			local verts = {}
			for i, v in f.verts do
				if not remap[v] then
					local p = positions[v]
					remap[v] = mesh:vertex(p[1], p[2], p[3])
				end
				verts[i] = remap[v]
			end
			mesh:face(verts, f.uvs)
		end
		return mesh
	end
	local function emit(label, chunkFaces, size)
		local texture = 1024
		if texelDensity then
			local mesh = chunkMesh(chunkFaces)
			mesh:setSmooth(if smooth ~= nil then smooth else SMOOTH_ANGLE)
			-- Split by the layout's density; the scale only sizes the texture.
			local unwrap = mesh:unwrap()
			local needed = math.ceil((layoutDensity or texelDensity) / unwrap / 4) * 4
			if needed > 1024 and #chunkFaces > 1 then
				local half = size / 2
				local octants, octantOrder = {}, {}
				for _, f in chunkFaces do
					local cx, cy, cz = 0, 0, 0
					for _, v in f.verts do
						local p = positions[v]
						cx, cy, cz = cx + p[1], cy + p[2], cz + p[3]
					end
					local n = #f.verts
					local sub = `{math.floor(cx / n / half) % 2}{math.floor(cy / n / half) % 2}{math.floor(cz / n / half + 0.5) % 2}`
					if not octants[sub] then
						octants[sub] = {}
						table.insert(octantOrder, sub)
					end
					table.insert(octants[sub], f)
				end
				if #octantOrder > 1 then
					for _, sub in octantOrder do
						emit(`{label}_{sub}`, octants[sub], half)
					end
					return
				end
				-- Everything sits in one octant, such as a curved strip whose
				-- unwrap leaves most of the texture empty: halve the cell again
				-- until the faces part.
				if half >= MIN_CELL then
					emit(label, chunkFaces, half)
					return
				end
			end
			texture = math.clamp(math.ceil(texelDensity / unwrap / 4) * 4, 16, 1024)
		end
		part(label, bone, color, function(mesh)
			local handles = {}
			for _, f in chunkFaces do
				local verts = {}
				for i, v in f.verts do
					if not handles[v] then
						local p = positions[v]
						handles[v] = mesh:vertex(p[1], p[2], p[3])
					end
					verts[i] = handles[v]
				end
				mesh:face(verts, f.uvs)
			end
			-- The recorder hands over a triangle soup; weld so the crease angle
			-- can run smooth over a chunk instead of faceting every triangle.
			mesh:weld(1e-4)
		end, smooth, 0, texture, nil, nil, edge, shade, lit)
		-- The warp was applied while recording; the chunk still wears the look.
		setLook(parts[#parts], color, rust)
		-- Chunks of one part share a group, so their edges count as its own,
		-- and carry the part's name, so a finish never has to parse theirs.
		parts[#parts].group = name
		parts[#parts].chunkOf = name
		parts[#parts].heightRange = heightRange
	end
	for _, key in order do
		emit(`{name}_{key}`, chunks[key], CHUNK)
	end
end

-- Shades every part with all the others as occluders, so parts darken where
-- they touch or tuck under each other, then adds them to the model.
local function finishParts()
	for _, entry in parts do
		if entry.emissive then
			model.part(entry.name, entry.mesh, entry.image, { bone = entry.bone, preview = true, emissive = entry.emissive })
			continue
		end
		-- A grouped part (the chunks of one chunkedPart) is painted with every
		-- member of its group, itself included and in this order, so the bake
		-- lays one set of strokes over the whole part and each chunk takes the
		-- ones that fall on it; each member's texture size goes along for its
		-- shade layer.
		local occluders, group, groupSizes, groupIndex = {}, {}, {}, nil
		for _, other in parts do
			if entry.group and other.group == entry.group then
				table.insert(group, other.mesh)
				table.insert(groupSizes, { other.image:width(), other.image:height() })
				if other == entry then
					groupIndex = #group
				end
			elseif other ~= entry then
				table.insert(occluders, other.mesh)
			end
		end
		entry.mesh:paintShading(entry.image, {
			highlight = EDGE_HIGHLIGHT * (entry.lit or 1),
			shadow = CONTACT_SHADOW * (entry.shade or 1),
			gradient = entry.gradient or GRADIENT,
			blend = entry.blend or EDGE_BLEND,
			occluders = occluders,
			group = group,
			groupSizes = groupSizes,
			groupIndex = groupIndex,
			name = entry.name,
			paint = entry.paint,
			-- A custom paint fn is cached under the item's key, since its code is not hashed.
			custom = entry.custom,
			salt = if entry.custom then CACHE_KEY else nil,
			rust = entry.rust * WEAR,
			stamps = entry.stamps,
			hand = entry.hand,
			handFocus = entry.handFocus,
			handTune = entry.handTune,
			rubber = entry.rubber,
			rustEdges = entry.rustEdges,
			reach = entry.edge,
			bevelReach = entry.bevelReach,
			bevelFold = entry.bevelFold,
			bevelTilt = entry.bevelTilt,
			roughnessBase = entry.roughnessBase,
			roughnessEdge = entry.roughnessEdge,
			roughnessCrease = entry.roughnessCrease,
			roughnessWear = entry.roughnessWear,
			metalnessOn = entry.metalnessBase ~= nil,
			metalnessBase = entry.metalnessBase,
			metalnessEdge = entry.metalnessEdge,
			metalnessCrease = entry.metalnessCrease,
			metalnessWear = entry.metalnessWear,
			highlightWidth = entry.wide,
			highlightUneven = entry.litUneven,
			highlightUnevenStep = entry.litUnevenStep,
			highlightMotion = if entry.litMotion == nil then (entry.hand and HAND_EDGE_MOTION[entry.hand]) else (entry.litMotion or nil),
			highlightMotionTune = entry.litTune,
			highlightToZero = entry.litToZero,
			highlightEnd = entry.litEnd,
			paintedHighlights = entry.painted,
			cornerTaper = entry.taper,
			softHighlight = entry.softLit,
			softReach = entry.softEdge,
			softUneven = entry.softUneven,
			softTaper = entry.softTaper,
			softToZero = entry.softToZero,
			softPower = entry.softPower,
			softEnd = entry.softEnd,
			strokes = entry.strokes,
			brushes = entry.brushes,
			heightRange = entry.heightRange,
			crisp = entry.crisp,
		})
		model.part(entry.name, entry.mesh, entry.image, { bone = entry.bone, preview = true })
	end
end
-- The hand-painted finish for a model's parts: `coats` names a part's hand coat
-- ("metal", "wood" or "rock"), `plain` lists parts left alone, such as lamps. A
-- crisp part with a hand coat keeps its exact shapes and takes only the
-- brushwork's tone. `finish` maps coat names and part names to a preset below,
-- for props standing alone on open ground; the town models leave it nil.
-- Call it just before finishParts().
local SMALL_MARKS = {
	big_length_min = 0.4,
	big_length_max = 0.75,
	big_width_min = 0.14,
	big_width_max = 0.28,
	mid_length_min = 0.2,
	mid_length_max = 0.4,
	mid_width_min = 0.07,
	mid_width_max = 0.13,
	edge_opacity = 0,
}

-- One preset per material, so tuning concrete never moves steel. A number a
-- model set on the part before handFinish wins over the preset's. `bands`
-- paints the stepped gradient: `steps` (default by height), `drop` (how dark
-- the lowest step goes), `top` (the top step's brightness), `facing` (loose
-- pieces each lit from above) and `stain` (how far a short part's steps wander
-- as blotches instead of bands; high values fleck a dark surface).
local PRESETS = {
	-- Steel standing alone on open ground. Its coat is paint over metal: the
	-- roughness map polishes the worn rims and roughens creases and rust, and
	-- the metalness map shows bare metal where the edge wear cuts through,
	-- never under the rust.
	propMetal = { gradient = 0.2, shade = 2, rustEdges = true, edge = 0.3, lit = 1.6, litUneven = 0.85, bands = { drop = 0.48, top = 1 }, roughness = { base = 0.7, edge = -0.6, crease = 0.15, wear = 0.25 }, metalness = { base = 0.05, edge = 0.85, crease = 0, wear = -0.3 } },
	-- Concrete footings and plinths.
	propConcrete = { gradient = 0.4, shade = 2, rustEdges = true, edge = 0.3, lit = 1.28, litUneven = 0.85, bands = { drop = 0.48, top = 1 } },
	-- Stones on the map, banded from the turf up by the bandDepth the layout gives them.
	-- Stone's edges tilt hard in the normal map, along the highlight strokes,
	-- and its roughness map polishes those worn rims while the creases stay matte.
	rock = { gradient = 0.4, shade = 1, rustEdges = true, edge = 0.3, lit = 1.28, litUneven = 0.85, bands = { steps = 4, drop = 0.32, top = 1 }, bevel = { tilt = 8 }, roughness = { base = 0.85, edge = -0.7, crease = 0.1, wear = 0 } },
	-- Loose pieces lying on a heap, each banded on its own from the model's bandPieces.
	heapPiece = { gradient = 0.2, shade = 1.4, rustEdges = true, edge = 0.3, lit = 1.8, litUneven = 0.85, bands = { steps = 4, drop = 0.58, top = 1, facing = true } },
	-- The earth body of a heap: it darkens well under everything resting on it.
	heapBody = { gradient = 0.4, shade = 1.8, rustEdges = true, edge = 0.45, lit = 1.0, litUneven = 0.85, softLit = 0, bands = { drop = 0.48, top = 1, stain = 0.08 } },
}
-- The finish most props take.
local PROP_FINISH = { metal = "propMetal", rock = "propConcrete" }

-- Light at the top, stepping down to dark and cool at the base. The hand coat
-- samples this per stroke, so each step's edge comes out brushed, not ruled.
local function paintStepBands(entry, bands)
	if entry.crisp and not entry.bandCrisp then
		return
	end
	-- The part's height range, read off a scratch paint of its surface.
	local low, high = math.huge, -math.huge
	entry.mesh:paint(Image.new(32, 32), function(_x, _y, z)
		low, high = math.min(low, z), math.max(high, z)
		return 0, 0, 0
	end)
	if high - low < 0.25 then
		return
	end
	-- Loose pieces listed as { x, y, z, radius } each band from their own top to
	-- their own foot, instead of all sharing the part's height.
	if entry.bandPieces then
		local pieces = entry.bandPieces
		entry.bandDepth = function(x: number, y: number, z: number): number
			local nearest, best = pieces[1], math.huge
			for _, piece in pieces do
				local d = (x - piece[1]) ^ 2 + (y - piece[2]) ^ 2 + (z - piece[3]) ^ 2
				if d < best then
					nearest, best = piece, d
				end
			end
			return 1 - math.clamp((z - nearest[3] + nearest[4]) / (2 * nearest[4]), 0, 1)
		end
	end
	-- Tall parts get more steps, so any stretch of them shows some.
	local steps = bands.steps or math.clamp(math.round((high - low) / 1.5), 4, 8)
	local drop, top = bands.drop, bands.top
	local paint = entry.paint
	entry.custom = true
	entry.paint = function(x: number, y: number, z: number, nx: number, ny: number, nz: number)
		local r, g, b = paint(x, y, z, nx, ny, nz)
		local depth = if entry.bandDepth then entry.bandDepth(x, y, z) else 1 - (z - low) / (high - low)
		if bands.facing then
			depth = depth * 0.3 + (1 - nz) * 0.35
		end
		depth += 0.07 * math.noise(x * 0.7, y * 0.7, z * 0.35)
		-- A short part has no height to band, so it stains in steps instead.
		if high - low < 1.5 then
			depth += (bands.stain or 0.4) * math.noise(x * 0.5, y * 0.5, z * 0.3)
		end
		local step = math.clamp(math.floor(depth * steps), 0, steps - 1) / (steps - 1)
		-- A small lift at the top, so near-black paint still shows its steps.
		local lift = (1 - step) * 0.22 * (1 - math.max(r, g, b)) ^ 2
		return r * (top - drop * step) + lift, g * (top - (drop + 0.02) * step) + lift, b * (top - (drop - 0.08) * step) + lift
	end
end

local function applyPreset(entry, preset)
	entry.gradient = entry.gradient or preset.gradient
	entry.shade = entry.shade or preset.shade
	entry.edge = entry.edge or preset.edge
	entry.lit = entry.lit or preset.lit
	entry.litUneven = preset.litUneven
	if entry.rustEdges == nil then
		entry.rustEdges = preset.rustEdges
	end
	-- Earth has no edge for the soft highlight to glow along; it flecks the rim.
	if preset.softLit then
		entry.softLit = preset.softLit
	end
	-- The normal map's bevel field, where the material shapes it.
	if preset.bevel then
		entry.bevelReach = entry.bevelReach or preset.bevel.reach
		entry.bevelFold = entry.bevelFold or preset.bevel.fold
		entry.bevelTilt = entry.bevelTilt or preset.bevel.tilt
	end
	-- The roughness map, from the material's base and the layers already baked.
	if preset.roughness then
		entry.roughnessBase = entry.roughnessBase or preset.roughness.base
		entry.roughnessEdge = entry.roughnessEdge or preset.roughness.edge
		entry.roughnessCrease = entry.roughnessCrease or preset.roughness.crease
		entry.roughnessWear = entry.roughnessWear or preset.roughness.wear
	end
	if preset.metalness then
		entry.metalnessBase = entry.metalnessBase or preset.metalness.base
		entry.metalnessEdge = entry.metalnessEdge or preset.metalness.edge
		entry.metalnessCrease = entry.metalnessCrease or preset.metalness.crease
		entry.metalnessWear = entry.metalnessWear or preset.metalness.wear
	end
	entry.handTune = SMALL_MARKS
	paintStepBands(entry, preset.bands)
end

local function handFinish(coats, plain, finish)
	-- Every chunk of one part must come out with the same finish; a chunk
	-- that doesn't is a seam in the paint, so it stops the build.
	local finishes: { [string]: string } = {}
	for _, entry in parts do
		-- A chunked part takes the coat of the part it was built under
		-- (chunkedPart tags each chunk with it), not whatever its own name parses to.
		local name = entry.chunkOf or entry.name
		if plain[name] or plain[entry.name] then
			continue
		end
		entry.hand = coats[name]
		if entry.hand == nil then
			entry.litMotion = "worn"
		elseif entry.hand == "metal" then
			entry.handTune = SMALL_MARKS
		end
		entry.softLit, entry.softEdge, entry.softUneven, entry.softTaper = 0.25, 0.22, 0, 0.8
		entry.softToZero, entry.softPower = true, 2
		entry.taper = entry.taper or 0.5
		entry.litToZero, entry.litUneven, entry.litUnevenStep = true, 0.6, 0.5
		entry.brushes = { shade = { motion = "feather", tune = { width = 0.02 } } }
		local presetName = finish and (finish[name] or finish[entry.hand])
		if presetName then
			applyPreset(entry, PRESETS[presetName] or error(`no finish preset {presetName}`))
		end
		local signature = `{entry.hand or "-"}/{presetName or "-"}`
		if finishes[name] and finishes[name] ~= signature then
			error(`chunks of {name} would wear different finishes ({finishes[name]} and {signature}); the paint would seam`)
		end
		finishes[name] = signature
	end
end
function buildMainIsland()
local CACHE_KEY = "MainIsland-43404b9dd9aef88d"
-- Rarity accents, in sRGB: grey common, green uncommon, blue rare, gold
-- legendary.
local COMMON = { 0.62, 0.62, 0.6 }
local UNCOMMON = { 0.3, 0.72, 0.3 }
local RARE = { 0.25, 0.5, 0.95 }
local LEGENDARY = { 1.0, 0.72, 0.18 }
local STEEL = { 0.62, 0.64, 0.66 }
local DARK_STEEL = { 0.3, 0.3, 0.32 }
local COPPER = { 0.85, 0.5, 0.25 }
local TAU = 2 * math.pi

-- Edge highlight and feathering, matching the salvage machine.
local EDGE_HIGHLIGHT = 0.6
local CONTACT_SHADOW = 0.425
-- Scales every part's wear (rust, grime, scratches): 57% of what each part asks for.
local WEAR = 0.57
local GRADIENT = 0.5
local EDGE_BLEND = 0.7
local SMOOTH_ANGLE = 30
local TEXTURE = 256

-- Faces are split into a grid about every 0.4 studs so the warp in
-- `part` can bend and dent flat panels.
local GRID = 0.4

-- When set, every part sizes its texture to this many pixels per stud
-- instead of the fixed TEXTURE, so a layout reads at one texel density.
-- A part's own `texture` size still wins.
local texelDensity: number? = nil
-- The density the layout asked for, before TEXEL_SCALE: chunk sizes follow
-- this one, so a max-detail preview keeps the chunks it would ship with.
local layoutDensity: number? = nil

-- Previews build at a fraction of the density the layout asks for (TEXEL_SCALE).
local function useTexelDensity(pixelsPerStud: number)
	layoutDensity = pixelsPerStud
	texelDensity = pixelsPerStud * (TEXEL_SCALE or 1)
end

local function gridFace(mesh, origin, u, v, nu, nv)
	local rows = {}
	for j = 0, nv do
		rows[j] = {}
		for i = 0, nu do
			local a, b = i / nu, j / nv
			rows[j][i] = mesh:vertex(
				origin[1] + u[1] * a + v[1] * b,
				origin[2] + u[2] * a + v[2] * b,
				origin[3] + u[3] * a + v[3] * b
			)
		end
	end
	for j = 0, nv - 1 do
		for i = 0, nu - 1 do
			mesh:face({ rows[j][i], rows[j][i + 1], rows[j + 1][i + 1], rows[j + 1][i] })
		end
	end
end

local function box(mesh, cx, cy, cz, sx, sy, sz)
	local x0, y0, z0 = cx - sx / 2, cy - sy / 2, cz
	local nx = math.clamp(math.ceil(sx / GRID), 1, 8)
	local ny = math.clamp(math.ceil(sy / GRID), 1, 8)
	local nz = math.clamp(math.ceil(sz / GRID), 1, 8)
	gridFace(mesh, { x0, y0, z0 }, { 0, sy, 0 }, { sx, 0, 0 }, ny, nx)
	gridFace(mesh, { x0, y0, z0 + sz }, { sx, 0, 0 }, { 0, sy, 0 }, nx, ny)
	gridFace(mesh, { x0, y0, z0 }, { sx, 0, 0 }, { 0, 0, sz }, nx, nz)
	gridFace(mesh, { x0, y0 + sy, z0 }, { 0, 0, sz }, { sx, 0, 0 }, nz, nx)
	gridFace(mesh, { x0, y0, z0 }, { 0, 0, sz }, { 0, sy, 0 }, nz, ny)
	gridFace(mesh, { x0 + sx, y0, z0 }, { 0, sy, 0 }, { 0, 0, sz }, ny, nz)
end

-- Cylinder centered at (cx, cy, cz) along axis "x", "y" or "z".
local function cylinder(mesh, cx, cy, cz, radius, length, axis, sides)
	sides = sides or 16
	local a, b = {}, {}
	for i = 0, sides - 1 do
		local t = i / sides * TAU
		local u, w = math.cos(t) * radius, math.sin(t) * radius
		local h = length / 2
		if axis == "x" then
			a[i + 1] = mesh:vertex(cx - h, cy + u, cz + w)
			b[i + 1] = mesh:vertex(cx + h, cy + u, cz + w)
		elseif axis == "y" then
			a[i + 1] = mesh:vertex(cx + w, cy - h, cz + u)
			b[i + 1] = mesh:vertex(cx + w, cy + h, cz + u)
		else
			a[i + 1] = mesh:vertex(cx + u, cy + w, cz - h)
			b[i + 1] = mesh:vertex(cx + u, cy + w, cz + h)
		end
	end
	for i = 1, sides do
		local j = i % sides + 1
		mesh:face({ a[i], a[j], b[j], b[i] })
	end
	local capA = {}
	for i = sides, 1, -1 do
		table.insert(capA, a[i])
	end
	mesh:face(capA)
	mesh:face(b)
end

-- UV sphere, squashed per axis by (rx, ry, rz).
local function sphere(mesh, cx, cy, cz, rx, ry, rz, rings, sides)
	rings, sides = rings or 8, sides or 16
	local grid = {}
	for r = 0, rings do
		local phi = r / rings * math.pi
		grid[r] = {}
		for s = 0, sides - 1 do
			local t = s / sides * TAU
			local x = math.sin(phi) * math.cos(t)
			local y = math.sin(phi) * math.sin(t)
			grid[r][s] = mesh:vertex(cx + x * rx, cy + y * ry, cz - math.cos(phi) * rz)
		end
	end
	for r = 0, rings - 1 do
		for s = 0, sides - 1 do
			local n = (s + 1) % sides
			mesh:face({ grid[r][s], grid[r][n], grid[r + 1][n], grid[r + 1][s] })
		end
	end
end

-- Flat ring (washer) facing along axis "x", "y" or "z": a rim round an eye,
-- a hub, a hose clamp.
local function ring(mesh, cx, cy, cz, inner, outer, depth, axis, sides)
	sides = sides or 16
	local function at(r, t, d)
		local u, w = math.cos(t) * r, math.sin(t) * r
		if axis == "x" then
			return mesh:vertex(cx + d, cy + u, cz + w)
		elseif axis == "y" then
			return mesh:vertex(cx + w, cy + d, cz + u)
		end
		return mesh:vertex(cx + u, cy + w, cz + d)
	end
	local rows = {}
	for i = 0, sides - 1 do
		local t = i / sides * TAU
		rows[i + 1] = { at(outer, t, -depth / 2), at(outer, t, depth / 2), at(inner, t, depth / 2), at(inner, t, -depth / 2) }
	end
	for i = 1, sides do
		local a, b = rows[i], rows[i % sides + 1]
		for k = 1, 4 do
			local l = k % 4 + 1
			mesh:face({ a[k], b[k], b[l], a[l] })
		end
	end
end

-- Bolt head: a squat hexagonal stud on a face pointing along axis.
local function bolt(mesh, cx, cy, cz, axis, size)
	size = size or 0.05
	cylinder(mesh, cx, cy, cz, size, size * 0.7, axis, 6)
end

-- Square beam from one point to another, for limbs and antennae.
local function strut(mesh, x0, y0, z0, x1, y1, z1, thick)
	local dx, dy, dz = x1 - x0, y1 - y0, z1 - z0
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	dx, dy, dz = dx / len, dy / len, dz / len
	local ax, ay, az = -dy, dx, 0
	if math.abs(dz) > 0.99 then
		ax, ay, az = 1, 0, 0
	end
	local al = math.sqrt(ax * ax + ay * ay + az * az)
	ax, ay, az = ax / al * thick / 2, ay / al * thick / 2, az / al * thick / 2
	local bx, by, bz = dy * az - dz * ay, dz * ax - dx * az, dx * ay - dy * ax
	local v = {}
	for i = 0, 7 do
		local sa = if i % 2 == 0 then -1 else 1
		local sb = if i // 2 % 2 == 0 then -1 else 1
		local x, y, z = if i // 4 == 0 then x0 else x1, if i // 4 == 0 then y0 else y1, if i // 4 == 0 then z0 else z1
		v[i + 1] = mesh:vertex(x + ax * sa + bx * sb, y + ay * sa + by * sb, z + az * sa + bz * sb)
	end
	for _, f in { { 1, 3, 4, 2 }, { 5, 6, 8, 7 }, { 1, 2, 6, 5 }, { 3, 7, 8, 4 }, { 1, 5, 7, 3 }, { 2, 4, 8, 6 } } do
		mesh:face({ v[f[1]], v[f[2]], v[f[3]], v[f[4]] })
	end
end

-- Points along a circular arc in the x-z plane, from angle a0 to a1 in
-- degrees. Feeds plate outlines; run the angles downward for a clockwise path.
local function arc(cx, cz, radius, a0, a1, steps)
	local points = {}
	for i = 0, steps do
		local a = math.rad(a0 + (a1 - a0) * i / steps)
		table.insert(points, { cx + math.cos(a) * radius, cz + math.sin(a) * radius })
	end
	return points
end

-- Splits a clockwise x-z outline into triangles by ear clipping, so concave
-- silhouettes cap cleanly. Returns index triples into the outline.
local function earClip(outline)
	local left, tris = {}, {}
	for i = 1, #outline do
		left[i] = i
	end
	local function cross(a, b, c)
		return (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
	end
	local guard = 0
	while #left > 3 and guard < 10000 do
		guard += 1
		local clipped = false
		for k = 1, #left do
			local i0, i1, i2 = left[(k - 2) % #left + 1], left[k], left[k % #left + 1]
			local a, b, c = outline[i0], outline[i1], outline[i2]
			if cross(a, b, c) < 0 then
				local inside = false
				for _, j in left do
					if j ~= i0 and j ~= i1 and j ~= i2 then
						local p = outline[j]
						if cross(a, b, p) <= 0 and cross(b, c, p) <= 0 and cross(c, a, p) <= 0 then
							inside = true
							break
						end
					end
				end
				if not inside then
					table.insert(tris, { i0, i1, i2 })
					table.remove(left, k)
					clipped = true
					break
				end
			end
		end
		if not clipped then
			break
		end
	end
	if #left == 3 then
		table.insert(tris, { left[1], left[2], left[3] })
	end
	return tris
end

-- Flat cut-out plate: a clockwise x-z outline extruded `depth` along y,
-- centred on y, with both faces chamfered inward by `bevel`. Use it for any
-- silhouette (signs, blades, brackets) instead of stacking boxes.
local function plate(mesh, outline, y, depth, bevel)
	local n = #outline
	local inset = {}
	for i = 1, n do
		local p0, p1, p2 = outline[(i - 2) % n + 1], outline[i], outline[i % n + 1]
		local function inward(a, b)
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local len = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
			return dz / len, -dx / len
		end
		local n1x, n1z = inward(p0, p1)
		local n2x, n2z = inward(p1, p2)
		local bx, bz = n1x + n2x, n1z + n2z
		local bl = math.max(math.sqrt(bx * bx + bz * bz), 1e-6)
		bx, bz = bx / bl, bz / bl
		local scale = math.min(1 / math.max(bx * n1x + bz * n1z, 0.34), 3) * bevel
		inset[i] = { p1[1] + bx * scale, p1[2] + bz * scale }
	end
	local h = depth / 2
	local layers = {
		{ inset, y - h },
		{ outline, y - h + bevel },
		{ outline, y + h - bevel },
		{ inset, y + h },
	}
	local rows = {}
	for l, layer in layers do
		rows[l] = {}
		for i = 1, n do
			rows[l][i] = mesh:vertex(layer[1][i][1], layer[2], layer[1][i][2])
		end
	end
	for l = 1, 3 do
		for i = 1, n do
			local j = i % n + 1
			mesh:face({ rows[l][i], rows[l][j], rows[l + 1][j], rows[l + 1][i] })
		end
	end
	for _, t in earClip(inset) do
		mesh:face({ rows[1][t[3]], rows[1][t[2]], rows[1][t[1]] })
		mesh:face({ rows[4][t[1]], rows[4][t[2]], rows[4][t[3]] })
	end
end

-- Unit tangent along (tx, ty, tz) plus two unit axes across it, right-handed,
-- the first level with the ground unless the tangent runs nearly vertical.
local function crossFrame(tx, ty, tz)
	local tl = math.sqrt(tx * tx + ty * ty + tz * tz)
	tx, ty, tz = tx / tl, ty / tl, tz / tl
	local ux, uy, uz = -ty, tx, 0
	if math.abs(tz) > 0.9 then
		ux, uy, uz = 0, tz, -ty
	end
	local ul = math.sqrt(ux * ux + uy * uy + uz * uz)
	ux, uy, uz = ux / ul, uy / ul, uz / ul
	return tx, ty, tz, ux, uy, uz, ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
end

-- Round tube through `points` ({x, y, z} each), capped at both ends: rope
-- strands, and bolts on curved faces.
local function tube(mesh, points, radius, sides)
	sides = sides or 8
	local function unit(a, b)
		local x, y, z = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local length = math.sqrt(x * x + y * y + z * z)
		if length < 1e-6 then
			return nil
		end
		return { x / length, y / length, z / length }
	end
	local rings = {}
	local carried
	for i, p in points do
		local before, after = points[math.max(i - 1, 1)], points[math.min(i + 1, #points)]
		local into, out = i > 1 and unit(before, p) or nil, i < #points and unit(p, after) or nil
		-- Each ring lies across the bisector of its bend.
		local dx, dy, dz = after[1] - before[1], after[2] - before[2], after[3] - before[3]
		if into and out then
			local x, y, z = into[1] + out[1], into[2] + out[2], into[3] + out[3]
			if x * x + y * y + z * z > 1e-6 then
				dx, dy, dz = x, y, z
			end
		end
		local tx, ty, tz, ux, uy, uz, vx, vy, vz = crossFrame(dx, dy, dz)
		-- Carry the last ring's frame round the bend, so the tube can't twist.
		if carried then
			local along = carried[1] * tx + carried[2] * ty + carried[3] * tz
			local x, y, z = carried[1] - tx * along, carried[2] - ty * along, carried[3] - tz * along
			local length = math.sqrt(x * x + y * y + z * z)
			if length > 1e-6 then
				ux, uy, uz = x / length, y / length, z / length
				vx, vy, vz = ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
			end
		end
		carried = { ux, uy, uz }
		-- A ring across a bend is widened toward the bend's outside, or the tube
		-- would pinch there.
		local stretch, bx, by, bz = 1, 0, 0, 0
		if into and out then
			local x, y, z = out[1] - into[1], out[2] - into[2], out[3] - into[3]
			local length = math.sqrt(x * x + y * y + z * z)
			if length > 1e-6 then
				bx, by, bz = x / length, y / length, z / length
				stretch = 1 / math.max(tx * out[1] + ty * out[2] + tz * out[3], 0.5)
			end
		end
		local ring = {}
		for k = 0, sides - 1 do
			local t = k / sides * TAU
			local c, n = math.cos(t) * radius, math.sin(t) * radius
			local x, y, z = ux * c + vx * n, uy * c + vy * n, uz * c + vz * n
			local extra = (x * bx + y * by + z * bz) * (stretch - 1)
			ring[k + 1] = mesh:vertex(p[1] + x + bx * extra, p[2] + y + by * extra, p[3] + z + bz * extra)
		end
		rings[i] = ring
	end
	for i = 1, #rings - 1 do
		local a, b = rings[i], rings[i + 1]
		for k = 1, sides do
			local n = k % sides + 1
			mesh:face({ a[k], a[n], b[n], b[k] })
		end
	end
	local cap = {}
	for k = sides, 1, -1 do
		table.insert(cap, rings[1][k])
	end
	mesh:face(cap)
	mesh:face(rings[#rings])
end

-- `points` with each inner corner replaced by a curve starting up to `reach`
-- studs before it, for wires and hoses that shouldn't have sharp elbows.
local function roundedPath(points, reach, steps)
	steps = steps or 4
	local path = { points[1] }
	for i = 2, #points - 1 do
		local a, p, b = points[i - 1], points[i], points[i + 1]
		local function towards(q)
			local x, y, z = q[1] - p[1], q[2] - p[2], q[3] - p[3]
			local length = math.sqrt(x * x + y * y + z * z)
			local r = math.min(reach, length / 2) / length
			return { p[1] + x * r, p[2] + y * r, p[3] + z * r }
		end
		local first, last = towards(a), towards(b)
		for s = 0, steps do
			local t = s / steps
			local m0, m1, m2 = (1 - t) ^ 2, 2 * t * (1 - t), t * t
			table.insert(path, {
				first[1] * m0 + p[1] * m1 + last[1] * m2,
				first[2] * m0 + p[2] * m1 + last[2] * m2,
				first[3] * m0 + p[3] * m1 + last[3] * m2,
			})
		end
	end
	table.insert(path, points[#points])
	return path
end

-- Point in the plane across `axis` at centre (cx, cy, cz): radius r, angle t,
-- offset d along the axis.
local function onAxis(cx, cy, cz, axis, r, t, d)
	local u, w = math.cos(t) * r, math.sin(t) * r
	if axis == "x" then
		return cx + d, cy + u, cz + w
	elseif axis == "y" then
		return cx + w, cy + d, cz + u
	end
	return cx + u, cy + w, cz + d
end

-- Spur gear turning about `axis`, with square teeth and a hole for its shaft.
local function gear(mesh, cx, cy, cz, radius, thick, teeth, axis)
	local steps = teeth * 4
	local rows = {}
	for i = 0, steps - 1 do
		local t = i / steps * TAU
		-- Two samples up on the tooth, two down in the gap.
		local r = if i % 4 < 2 then radius else radius * 0.82
		local hole = radius * 0.25
		rows[i + 1] = {
			mesh:vertex(onAxis(cx, cy, cz, axis, r, t, -thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, r, t, thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, hole, t, thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, hole, t, -thick / 2)),
		}
	end
	for i = 1, steps do
		local a, b = rows[i], rows[i % steps + 1]
		for k = 1, 4 do
			local l = k % 4 + 1
			mesh:face({ a[k], b[k], b[l], a[l] })
		end
	end
	-- Shaft through the middle.
	cylinder(mesh, cx, cy, cz, radius * 0.25, thick * 1.8, axis, 8)
end

-- Drive belt wrapped round two pulleys turning about `axis`, the first at
-- (ax, ay, az) with radius ra, the second at (bx, by, bz) with radius rb.
local function belt(mesh, axis, ax, ay, az, ra, bx, by, bz, rb, thick)
	thick = thick or 0.025
	-- Work in the plane across the axis as (u, w), matching onAxis.
	local function flat(x, y, z)
		if axis == "x" then
			return y, z
		elseif axis == "y" then
			return z, x
		end
		return x, y
	end
	local au, aw = flat(ax, ay, az)
	local bu, bw = flat(bx, by, bz)
	local heading = math.atan2(bw - aw, bu - au)
	local points = {}
	-- Round the far side of b, then back round the far side of a.
	for i = 0, 8 do
		local t = heading - math.pi / 2 + i / 8 * math.pi
		local x, y, z = onAxis(bx, by, bz, axis, rb + thick, t, 0)
		table.insert(points, { x, y, z })
	end
	for i = 0, 8 do
		local t = heading + math.pi / 2 + i / 8 * math.pi
		local x, y, z = onAxis(ax, ay, az, axis, ra + thick, t, 0)
		table.insert(points, { x, y, z })
	end
	table.insert(points, points[1])
	tube(mesh, points, thick, 4)
end

-- Exhaust pipe along `points`, ending in a flared, soot-black lip.
local function exhaust(mesh, points, radius)
	tube(mesh, points, radius, 10)
	local a, b = points[#points - 1], points[#points]
	local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local length = math.sqrt(dx * dx + dy * dy + dz * dz)
	dx, dy, dz = dx / length, dy / length, dz / length
	tube(mesh, {
		{ b[1] - dx * 0.06, b[2] - dy * 0.06, b[3] - dz * 0.06 },
		{ b[1], b[2], b[3] },
	}, radius * 1.3, 10)
end

-- Little engine block: a box crankcase with a finned cylinder on top.
local function engine(mesh, cx, cy, cz, size)
	box(mesh, cx, cy, cz, size * 1.4, size, size * 0.7)
	local top = cz + size * 0.7
	cylinder(mesh, cx, cy, top + size * 0.35, size * 0.3, size * 0.7, "z", 12)
	for i = 0, 3 do
		ring(mesh, cx, cy, top + size * (0.1 + i * 0.17), size * 0.28, size * 0.45, size * 0.05, "z", 12)
	end
	box(mesh, cx, cy, top + size * 0.7, size * 0.5, size * 0.5, size * 0.1)
end

-- Bolt head on a curved face, standing out along the normal (nx, ny, nz).
local function stud(mesh, x, y, z, nx, ny, nz, size)
	size = size or 0.04
	local a, b = -size * 0.2, size * 0.5
	tube(mesh, { { x + nx * a, y + ny * a, z + nz * a }, { x + nx * b, y + ny * b, z + nz * b } }, size, 6)
end

-- Rope along `points`: two strands twisted round each other.
local function rope(mesh, points, radius)
	-- Resample the path finely enough for the twist to turn smoothly.
	local path = {}
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local steps = math.max(1, math.ceil(math.sqrt(dx * dx + dy * dy + dz * dz) / (radius * 0.8)))
		for k = 0, steps - 1 do
			table.insert(path, { a[1] + dx * k / steps, a[2] + dy * k / steps, a[3] + dz * k / steps })
		end
	end
	table.insert(path, points[#points])
	for strand = 0, 1 do
		local twisted = {}
		for i, p in path do
			local a, b = path[math.max(i - 1, 1)], path[math.min(i + 1, #path)]
			local _, _, _, ux, uy, uz, vx, vy, vz = crossFrame(b[1] - a[1], b[2] - a[2], b[3] - a[3])
			local t = i * 0.7 + strand * math.pi
			local c, n = math.cos(t) * radius * 0.45, math.sin(t) * radius * 0.45
			twisted[i] = { p[1] + ux * c + vx * n, p[2] + uy * c + vy * n, p[3] + uz * c + vz * n }
		end
		tube(mesh, twisted, radius * 0.6, 6)
	end
end

-- Rope lashed round a box at height z, its corners at x = +-halfX and
-- y from y0 to y1, rounded so it sits snug round each corner.
local function lashing(mesh, halfX, y0, y1, z, radius)
	local bend = radius * 3
	-- Corner centres counter-clockwise from (+X, y0), each with its start angle.
	local corners = {
		{ halfX - bend, y0 + bend, -math.pi / 2 },
		{ halfX - bend, y1 - bend, 0 },
		{ -halfX + bend, y1 - bend, math.pi / 2 },
		{ -halfX + bend, y0 + bend, math.pi },
	}
	local points = {}
	for _, c in corners do
		for k = 0, 3 do
			local t = c[3] + k / 3 * math.pi / 2
			table.insert(points, { c[1] + math.cos(t) * bend, c[2] + math.sin(t) * bend, z })
		end
	end
	table.insert(points, points[1])
	rope(mesh, points, radius)
end

-- Flat sheet lying on the face of a box at `axis` = `at`, its outer side toward
-- `sign`, covering a0..a1 along the other level axis and z0..z1 up, bolted at
-- each corner.
local function sheet(mesh, axis, at, sign, a0, a1, z0, z1, thick, boltSize)
	thick, boltSize = thick or 0.03, boltSize or 0.035
	local c = at + sign * thick / 2
	if axis == "x" then
		box(mesh, c, (a0 + a1) / 2, z0, thick, a1 - a0, z1 - z0)
	else
		box(mesh, (a0 + a1) / 2, c, z0, a1 - a0, thick, z1 - z0)
	end
	local inset = boltSize * 2
	for _, a in { a0 + inset, a1 - inset } do
		for _, z in { z0 + inset, z1 - inset } do
			if axis == "x" then
				bolt(mesh, at + sign * thick, a, z, "x", boltSize)
			else
				bolt(mesh, a, at + sign * thick, z, "y", boltSize)
			end
		end
	end
end

-- Angle bracket bent round the vertical box corner at (x, y), outer faces
-- toward sx and sy, legs `size` long, bolted through each leg.
local function cornerBracket(mesh, x, y, sx, sy, z, height, size)
	local t = 0.025
	box(mesh, x + sx * t / 2, y - sy * (size - t) / 2, z, t, size + t, height)
	box(mesh, x - sx * (size - t) / 2, y + sy * t / 2, z, size + t, t, height)
	for _, dz in { 0.25, 0.75 } do
		bolt(mesh, x + sx * t, y - sy * size * 0.6, z + height * dz, "x", 0.03)
		bolt(mesh, x - sx * size * 0.6, y + sy * t, z + height * dz, "y", 0.03)
	end
end

-- Weathering colors, in sRGB. The bake paints the wear itself, stroke by
-- stroke: rust patches, drips, grime and scratches on metal, dust and scuffs
-- on rubber. These are for parts made of the stuff.
local RUST_DARK = { 0.3, 0.2, 0.12 }
local RUST_ORANGE = { 0.62, 0.36, 0.15 }
local RUST_FLAKE = { 0.78, 0.52, 0.3 }
local BARE_METAL = { 0.74, 0.73, 0.7 }

-- How rusty a part painted by its own paint fn is; `rusting` sets it.
local paintRust = setmetatable({}, { __mode = "k" })

-- Marks a paint fn as `rust` worn (0 clean, 1 eaten through), for parts
-- whose coat has its own look but should still rust.
local function rusting(rust, paint)
	paintRust[paint] = rust
	return paint
end

local RUBBER = -1
local DUST = { 0.55, 0.5, 0.42 }
-- Bindings, painted as RUBBER: duct tape and hemp rope.
local TAPE = { 0.58, 0.58, 0.56 }
local RUBBER_BLACK = { 0.12, 0.12, 0.13 }
local ROPE = { 0.62, 0.5, 0.32 }

-- Part following one bone. `smooth` overrides the auto-smooth angle (true
-- for fully round parts like the zapper's body). `rust` sets how worn it
-- is, default 0.4; 0 for glowing eyes and visors; RUBBER for tyres and treads.
local WARP = 0.0385

-- Low-frequency warp so no panel is perfectly flat or square: a smooth sum
-- of sines seeded by the part name, plus a couple of dents.
local function imperfect(mesh, name)
	local seed = 0
	for i = 1, #name do
		seed = (seed * 31 + string.byte(name, i)) % 9973
	end
	local function n(k)
		return math.sin(seed * 12.9898 + k * 78.233) * 0.5 + 0.5
	end
	local function noise(x, y, z, k)
		return math.sin(x * (1.7 + n(k)) + y * 0.9 + n(k + 1) * TAU) * 0.5
			+ math.sin(y * (2.3 + n(k + 2)) - z * 1.3 + n(k + 3) * TAU) * 0.3
			+ math.sin(z * (2.9 + n(k + 4)) + x * 1.1 + n(k + 5) * TAU) * 0.2
	end
	local dents = {}
	for d = 1, 2 do
		local k = d * 10
		dents[d] = { (n(k) - 0.5) * 3, (n(k + 1) - 0.5) * 3, n(k + 2) * 4, 0.3 + n(k + 3) * 0.4 }
	end
	return setmetatable({
		vertex = function(_, x, y, z)
			local dx, dy, dz = noise(x, y, z, 1), noise(y, z, x, 7), noise(z, x, y, 13)
			for _, dent in dents do
				local ox, oy, oz = x - dent[1], y - dent[2], z - dent[3]
				local fall = math.exp(-(ox * ox + oy * oy + oz * oz) / (dent[4] * dent[4]))
				dx -= ox * fall * 0.6
				dy -= oy * fall * 0.6
				dz -= oz * fall * 0.6
			end
			return mesh:vertex(x + dx * WARP, y + dy * WARP, z + dz * WARP)
		end,
	}, {
		__index = function(_, key)
			return function(_, ...)
				return mesh[key](mesh, ...)
			end
		end,
	})
end

local parts = {}

-- What the bake paints on a part: `paint` gives its coat colors, `rust` how
-- worn it is, and `rubber` that it gathers dust and scuffs instead.
local function setLook(entry, color, rust)
	rust = rust or 0.4
	if type(rust) == "function" then
		entry.paint, entry.rust, entry.custom = rust, paintRust[rust] or 0, true
		return
	end
	entry.paint = function()
		return color[1], color[2], color[3]
	end
	entry.rust = math.max(rust, 0)
	entry.rubber = rust == RUBBER
end

local HAND_EDGE_MOTION = { rock = "feather", wood = "flick", metal = "worn" }

-- `rust` can also be a paint fn for surfaces with their own look.
-- `texture` overrides the texture size for parts that need more detail.
-- `emissive` is a glow strength (like SurfaceAppearance.EmissiveStrength);
-- glowing parts skip painted shading. `flat` skips the warp, for parts so
-- thin it would visibly bend them. `edge` is how far highlights and contact
-- shadows reach from an edge, in studs: bigger surfaces take a wider band.
-- `shade` multiplies the contact shadow strength, for parts that should sit in
-- heavier shadow than the standard wear. `lit` scales the highlight strength
-- and `wide` the width of the highlight brush strokes. Set `painted` on an entry
-- to paint its highlights as bold, fully loaded strokes instead of dry ones,
-- `blend` (0-1) to tint them from cream toward a lighter part colour, and
-- `taper` (studs) to run them full width at corners, thinning along each edge.
-- `softLit` (0-1) adds a wide, very soft highlight under the strokes, fading
-- out over `softEdge` studs from each edge; `softUneven` (0-1) makes its width
-- wander along the edge and `softTaper` (studs) thins it away from corners.
-- `softToZero` lets that thinning reach nothing, and `softPower` steepens the fade.
-- `strokes` lists brush strokes painted over the coat ({start, along, normal,
-- length, width, tail, color, brush}, color in sRGB), such as cracks or dabs;
-- `brush` is "taper" (crisp lines, the default), "round" or "sponge".
-- `stamps` lays the coat with scanned stroke shapes instead of the flat brush.
-- `hand` ("rock", "wood" or "metal") paints the coat the way a hand would, and
-- `handFocus` ({x, y, z, radius}) is where it gathers its finest strokes.
-- `handTune` sets any of its numbers by name (settings! in tools/modelkit/src/hand.rs).
-- `litMotion` draws the hard edge highlight with a moving hand, `litTune` sets its
-- numbers by name (tools/modelkit/src/marks.rs). A hand-painted part gets its
-- material's motion unless it names another, or `false` for the default strokes.
-- `brushes` draws any layer with a motion: edge, shade, soft, coat, grime, rust,
-- drip or scratch, each {motion = "press", tune = {name = value}}. A `strokes`
-- entry takes `motion` and `tune` the same way.
-- With `hand` as well, `crisp` keeps the shapes exact and takes only the brushwork's tone.
-- `crisp` lays the coat on texel by texel in the paint fn's exact colours
-- instead of brush strokes, for machine finishes (hazard tape, ribbed
-- rubber) that strokes would smear; shading still goes over it.
local function part(name, bone, color, build, smooth, rust, texture: number?, emissive: number?, flat: boolean?, edge: number?, shade: number?, lit: number?, wide: number?)
	local mesh = Mesh.new()
	build(if rust == 0 or flat then mesh else imperfect(mesh, name))
	mesh:setSmooth(if smooth ~= nil then smooth else SMOOTH_ANGLE)
	local fit = mesh:unwrap()
	local size = if texture then texture
		elseif texelDensity then math.clamp(math.ceil(texelDensity / fit / 4) * 4, 16, 1024)
		else TEXTURE
	local image = Image.new(size, size, color[1], color[2], color[3])
	local entry = { name = name, bone = bone, mesh = mesh, image = image, emissive = emissive, edge = edge, shade = shade, lit = lit, wide = wide }
	setLook(entry, color, rust)
	-- Glowing parts skip the painted bake, so their colors go on as they are.
	if emissive then
		mesh:paint(image, entry.paint)
	end
	table.insert(parts, entry)
end

-- Large surfaces (terrain, roads, floors) are split into cubes 128 studs
-- across, or 1024 texels at the layout's texel density if that is smaller,
-- each its own part with a texture up to 1024, named <name>_<cx>_<cy>_<cz>. The
-- build runs once into a recorder, then each face goes to the chunk holding
-- its centre. Cells sit on the origin across, and centred on z = 0 up and
-- down, so ground near sea level stays in one layer. `flat` skips the warp,
-- as for part(). Every chunk shades against one height range, the whole
-- mesh's z-range or the `heightRange` {bottom, top} given, so the gradient runs
-- on across chunks instead of restarting in each (a flat chunk would go dark).
local function chunkedPart(name, bone, color, build, smooth, rust, flat: boolean?, edge: number?, shade: number?, lit: number?, heightRange: { number }?)
	local CHUNK = if layoutDensity then math.min(128, 1024 / layoutDensity) else 128
	-- Smallest cell a chunk is halved down to while looking for a split.
	local MIN_CELL = 2
	local positions, faces = {}, {}
	local recorder = {
		vertex = function(_, x, y, z)
			table.insert(positions, { x, y, z })
			return #positions
		end,
		-- A vertex the rust wobble leaves alone, for surfaces that must stay flat.
		exactVertex = function(_, x, y, z)
			table.insert(positions, { x, y, z })
			return #positions
		end,
		face = function(_, verts, uvs)
			table.insert(faces, { verts = verts, uvs = uvs })
		end,
	}
	build(if rust == 0 or flat then recorder else imperfect(recorder, name))
	if not heightRange then
		local bottom, top = math.huge, -math.huge
		for _, p in positions do
			bottom, top = math.min(bottom, p[3]), math.max(top, p[3])
		end
		heightRange = { bottom, top }
	end

	local chunks, order = {}, {}
	for _, f in faces do
		local cx, cy, cz = 0, 0, 0
		for _, v in f.verts do
			local p = positions[v]
			cx, cy, cz = cx + p[1], cy + p[2], cz + p[3]
		end
		local n = #f.verts
		local key = `{math.floor(cx / n / CHUNK)}_{math.floor(cy / n / CHUNK)}_{math.floor(cz / n / CHUNK + 0.5)}`
		if not chunks[key] then
			chunks[key] = {}
			table.insert(order, key)
		end
		table.insert(chunks[key], f)
	end

	-- Each chunk becomes a part. With a texel density set, a chunk whose
	-- texture would need more than 1024 texels to hold it is split into
	-- octants until every piece fits, so the whole surface reads at one density.
	local function chunkMesh(chunkFaces)
		local mesh, remap = Mesh.new(), {}
		for _, f in chunkFaces do
			local verts = {}
			for i, v in f.verts do
				if not remap[v] then
					local p = positions[v]
					remap[v] = mesh:vertex(p[1], p[2], p[3])
				end
				verts[i] = remap[v]
			end
			mesh:face(verts, f.uvs)
		end
		return mesh
	end
	local function emit(label, chunkFaces, size)
		local texture = 1024
		if texelDensity then
			local mesh = chunkMesh(chunkFaces)
			mesh:setSmooth(if smooth ~= nil then smooth else SMOOTH_ANGLE)
			-- Split by the layout's density; the scale only sizes the texture.
			local unwrap = mesh:unwrap()
			local needed = math.ceil((layoutDensity or texelDensity) / unwrap / 4) * 4
			if needed > 1024 and #chunkFaces > 1 then
				local half = size / 2
				local octants, octantOrder = {}, {}
				for _, f in chunkFaces do
					local cx, cy, cz = 0, 0, 0
					for _, v in f.verts do
						local p = positions[v]
						cx, cy, cz = cx + p[1], cy + p[2], cz + p[3]
					end
					local n = #f.verts
					local sub = `{math.floor(cx / n / half) % 2}{math.floor(cy / n / half) % 2}{math.floor(cz / n / half + 0.5) % 2}`
					if not octants[sub] then
						octants[sub] = {}
						table.insert(octantOrder, sub)
					end
					table.insert(octants[sub], f)
				end
				if #octantOrder > 1 then
					for _, sub in octantOrder do
						emit(`{label}_{sub}`, octants[sub], half)
					end
					return
				end
				-- Everything sits in one octant, such as a curved strip whose
				-- unwrap leaves most of the texture empty: halve the cell again
				-- until the faces part.
				if half >= MIN_CELL then
					emit(label, chunkFaces, half)
					return
				end
			end
			texture = math.clamp(math.ceil(texelDensity / unwrap / 4) * 4, 16, 1024)
		end
		part(label, bone, color, function(mesh)
			local handles = {}
			for _, f in chunkFaces do
				local verts = {}
				for i, v in f.verts do
					if not handles[v] then
						local p = positions[v]
						handles[v] = mesh:vertex(p[1], p[2], p[3])
					end
					verts[i] = handles[v]
				end
				mesh:face(verts, f.uvs)
			end
			-- The recorder hands over a triangle soup; weld so the crease angle
			-- can run smooth over a chunk instead of faceting every triangle.
			mesh:weld(1e-4)
		end, smooth, 0, texture, nil, nil, edge, shade, lit)
		-- The warp was applied while recording; the chunk still wears the look.
		setLook(parts[#parts], color, rust)
		-- Chunks of one part share a group, so their edges count as its own.
		parts[#parts].group = name
		parts[#parts].heightRange = heightRange
	end
	for _, key in order do
		emit(`{name}_{key}`, chunks[key], CHUNK)
	end
end

-- Shades every part with all the others as occluders, so parts darken where
-- they touch or tuck under each other, then adds them to the model.
local function finishParts()
	for _, entry in parts do
		if entry.emissive then
			model.part(entry.name, entry.mesh, entry.image, { bone = entry.bone, preview = true, emissive = entry.emissive })
			continue
		end
		local occluders, group = {}, {}
		for _, other in parts do
			if other ~= entry and entry.group and other.group == entry.group then
				table.insert(group, other.mesh)
			elseif other ~= entry then
				table.insert(occluders, other.mesh)
			end
		end
		entry.mesh:paintShading(entry.image, {
			highlight = EDGE_HIGHLIGHT * (entry.lit or 1),
			shadow = CONTACT_SHADOW * (entry.shade or 1),
			gradient = entry.gradient or GRADIENT,
			blend = entry.blend or EDGE_BLEND,
			occluders = occluders,
			group = group,
			name = entry.name,
			paint = entry.paint,
			-- A custom paint fn is cached under the item's key, since its code is not hashed.
			custom = entry.custom,
			salt = if entry.custom then CACHE_KEY else nil,
			rust = entry.rust * WEAR,
			stamps = entry.stamps,
			hand = entry.hand,
			handFocus = entry.handFocus,
			handTune = entry.handTune,
			rubber = entry.rubber,
			rustEdges = entry.rustEdges,
			reach = entry.edge,
			highlightWidth = entry.wide,
			highlightUneven = entry.litUneven,
			highlightUnevenStep = entry.litUnevenStep,
			highlightMotion = if entry.litMotion == nil then (entry.hand and HAND_EDGE_MOTION[entry.hand]) else (entry.litMotion or nil),
			highlightMotionTune = entry.litTune,
			highlightToZero = entry.litToZero,
			highlightEnd = entry.litEnd,
			paintedHighlights = entry.painted,
			cornerTaper = entry.taper,
			softHighlight = entry.softLit,
			softReach = entry.softEdge,
			softUneven = entry.softUneven,
			softTaper = entry.softTaper,
			softToZero = entry.softToZero,
			softPower = entry.softPower,
			softEnd = entry.softEnd,
			strokes = entry.strokes,
			brushes = entry.brushes,
			heightRange = entry.heightRange,
			crisp = entry.crisp,
		})
		model.part(entry.name, entry.mesh, entry.image, { bone = entry.bone, preview = true })
	end
end
-- Main Island: the one floating island the island server map stands on
-- (layouts/IslandPreview.luau), from the shared column generator
-- (shared/ColumnIsland.luau).
local RADIUS = 278
local PEAK = 192
local SEED = 41
-- What stands on it (IslandPreview.luau): the hub's paving and ring road out
-- to HUB_ROAD from the middle, and eight yard plots YARD_HALF_WIDTH by
-- YARD_HALF_DEPTH on a ring at YARD_RADIUS, yard i at (i - 0.5) * 45
-- degrees with its gate toward the middle. A kerbed track runs from the gate
-- to the hub, so the turf wear (negative TRACK_HALF) stays inside its kerbs.
local HUB_ROAD = 101
local YARD_RADIUS = 210
local YARD_HALF_WIDTH, YARD_HALF_DEPTH = 48, 56
local TRACK_HALF = -1.5

-- How far a point lies outside the hub, the nearest plot (with rounded
-- corners) or its track.
local function wornDistance(x: number, y: number): number
	local r = math.sqrt(x * x + y * y)
	local outside = r - HUB_ROAD
	local yard = math.rad((math.floor(math.deg(math.atan2(y, x)) % 360 / 45) + 0.5) * 45)
	local c, s = math.cos(yard), math.sin(yard)
	-- In the yard's frame: across its width, and out from the hub.
	local across = (x * -s + y * c)
	local out = (x * c + y * s) - YARD_RADIUS
	local dx, dy = math.abs(across) - YARD_HALF_WIDTH, math.abs(out) - YARD_HALF_DEPTH
	outside = math.min(outside, if dx > 0 and dy > 0 then math.sqrt(dx * dx + dy * dy) else math.max(dx, dy))
	if out < 0 and r > HUB_ROAD then
		outside = math.min(outside, math.max(math.abs(across) - TRACK_HALF, 0))
	end
	return outside
end

-- The plots and the paving bury the turf under them.
local COVER_INSET = 2
local RIM_WOBBLE = 0.04
local function rimShape(_angle: number): number
	return 1
end

-- Soft turf patches and wear, for a top this big and open.
SOFT_GRASS = true

-- Column Island: the generator for the map's floating islands, a mountain
-- of stone columns turned upside down, so a flat grassy top hangs over a
-- rocky cone that tapers to a point below. The columns, of every size and
-- shape, are packed edge to edge like cracked basalt; each hangs as deep as
-- the cone at its centre with a low faceted tip, so the underside steps down
-- in uneven tiers to the lowest point and a shallower shoulder. The columns
-- are the cells of a weighted Voronoi diagram (a power diagram) over
-- scattered stones, so big stones claim big cells. Stones grow from small
-- near the tip to big at the rim, and the big rim stones give the top its
-- lobed outline. Each column is carved, a few angled planes chiselling
-- chunks off its lower corners and edges. The model is built the mountain
-- way up (heights, summit, foot) and flipped as it is written out. Centered
-- on the origin, stone top at z = 0, turf GRASS_HEIGHT above it.
--
-- The item including this sets:
--   RADIUS        the island's radius;
--   PEAK          how far the cone hangs below the top;
--   SEED          which scatter of stones it gets;
--   wornDistance(x, y)  how far a point on the top lies outside the ground
--                 worn by what stands on it (math.huge where nothing does);
--                 the grass wears to dirt within about APRON_WIDTH of it;
--   COVER_INSET   turf lying more than this many studs inside the worn
--                 ground is buried under what stands there and left out
--                 (math.huge keeps it all);
--   RIM_WOBBLE    how far the rim swells and dips, as a share of its radius;
--   rimShape(angle)  how far out the rim stands at an angle, as a multiple
--                 of the round rim: 1 all round for a round island, never
--                 under 1, more toward the corners of a squarer one.
-- Stone sizes at the summit and at the foot, as shares of the radius, so
-- a bigger island has bigger stones rather than more of them.
local SMALLEST, LARGEST = 0.055 * RADIUS, 0.34 * RADIUS
-- Every other size in studs below was tuned on stones up to 4.5 studs
-- across and is multiplied by DETAIL, so an island with bigger stones looks
-- the same, only bigger: chips, slabs, cookie stones, cracks, rounding,
-- grass and the paint's blotches all grow with the stones.
local DETAIL = LARGEST / 4.5
-- The rim the columns are trimmed to: a circle of RIM_PUSH * RADIUS
-- swelling and dipping by up to RIM_WOBBLE of it in broad waves, so the top
-- is a dependable surface rather than sharp lobes and bays, and standing
-- rimShape times as far out at each angle. RIM_SIDES flat facets make it up,
-- so the rim stones end in cut faces.
local RIM_SIDES = 192
-- The rim stands RIM_PUSH times RADIUS out.
local RIM_PUSH = 1.1
-- The top tier of dirt, this deep under the grass, stays a clean wall
-- straight down from the rim the grass follows: chisel cuts, chips and bare
-- rock slabs all start below it.
local DIRT_CONFORM = 1.5 * DETAIL
-- Stones are scattered a stone's width past the rim, so rim cells close
-- on real neighbours before they are trimmed to it.
local RIM_REACH = 1
for i = 0, RIM_SIDES - 1 do
	RIM_REACH = math.max(RIM_REACH, rimShape(i / RIM_SIDES * 2 * math.pi))
end
local SCATTER = RIM_PUSH * RADIUS * RIM_REACH + LARGEST
-- Shortest a column hangs, so the rim stones read as a thick slab; a
-- share of the radius like the stone sizes.
local MIN_LENGTH = 0.2 * RADIUS
-- Chisel cuts per column, at most, and how deep one bites as a share of
-- the stone's size.
local MAX_CUTS = 3
local CUT_DEPTH = { 0.2, 0.55 }
-- Fine chips per column (fewest, most) and how deep one bites, in studs.
local CHIPS = { 3, 6 }
local CHIP_DEPTH = { 0.15 * DETAIL, 0.45 * DETAIL }
-- How far a cut's heading may swing from straight out, in radians.
local CUT_SPREAD = math.rad(55)

local STONE = { 0.46, 0.45, 0.5 }
-- Under the grass the island is all dirt, until rocks start breaking
-- through it at the first share of the island's depth in DIRT_TRANSITION,
-- more and more of them going down, until from the second share it is all
-- rock. Each rock comes through the dirt at its own depth in that range. The
-- dirt's bottom edge is bevelled back DIRT_BEVEL studs on its outer side, so
-- the rock it sits on stands proud.
local DIRT = { 0.33, 0.24, 0.18 }
local DIRT_TRANSITION = { 0.2, 0.65 }
-- Where a rock comes through, the line between its dirt and its stone tilts
-- by up to DIRT_TILT radians, each rock its own way, so the line wanders
-- round the island instead of stepping level.
local DIRT_TILT = math.rad(25)
-- Above that, rock already shows through the dirt in slabs: a rock still
-- under dirt may have up to PATCHES slabs of its faces bare below tilted
-- lines, each facing out from the island's centre within PATCH_SPREAD
-- radians. The chance of each rises from nothing at PATCH_FROM of the depth
-- to certain at PATCH_FULL. A slab is PATCH_THICKNESS studs deep, its back
-- leaning in or out by up to PATCH_LEAN, and its top line tilted by up to
-- PATCH_TILT; PATCH_PEAKED of the slabs have a second top line, so the bare
-- rock comes up to a point through the dirt.
local PATCHES = 2
local PATCH_FROM = 0.04
local PATCH_FULL = 0.25
local PATCH_SPREAD = math.rad(45)
local PATCH_THICKNESS = { 0.4 * DETAIL, 1.4 * DETAIL }
local PATCH_LEAN = 0.5
local PATCH_TILT = 0.8
local PATCH_PEAKED = 0.6
-- The bare rock of a slab is chiselled into a rough stone: this many chips
-- (fewest, most), each biting this deep (studs) off its outer side at its
-- own angle, up to PATCH_CHIP_SPREAD radians off straight out.
local PATCH_CHIPS = { 4, 8 }
local PATCH_CHIP_DEPTH = { 0.3 * DETAIL, 0.8 * DETAIL }
local PATCH_CHIP_SPREAD = math.rad(65)
-- The colours blend too, over a wider share of the depth: dirt greys toward
-- stone and stone keeps a dirty tint across COLOR_TRANSITION, the line
-- wandering by COLOR_WOBBLE of the depth. At any depth the dirt stays
-- DIRT_LEAD further toward dirt than the stone, so the two still read apart.
local COLOR_TRANSITION = { 0.08, 0.55 }
local COLOR_WOBBLE = 0.06
local DIRT_LEAD = 0.45
-- Traces of dirt stay on the stone just under each rock's dirt line, as
-- patchy blotches thinning out over DIRT_TRACE studs below it. Bare rock
-- breaking through above the line keeps DIRT_DUSTING of them.
local DIRT_TRACE = 4 * DETAIL
local DIRT_DUSTING = 0.35
-- Grime and dead grey lichen crust the stone in patches, thickest where
-- the dirt gives way to rock and thinning out to nothing by GRIME_REACH of
-- the island's depth.
-- GRIME_COVER is the most of the stone it covers.
local GRIME = { 0.21, 0.22, 0.19 }
local GRIME_REACH = 0.8
local GRIME_COVER = 0.45

-- Small whole stones half sunk in the dirt, like crushed cookie in ice
-- cream: STONE_BITS of them per square stud of dirt near the top, rising to
-- the second number where the dirt gives way to rock. Each is STONE_BIT_SIZE
-- studs across, most of them small and a few big (STONE_BIT_SKEW over 1), a
-- chipped box, and stands out of the dirt by STONE_BIT_RISE
-- of its size. None sit within STONE_BIT_CLEAR studs of the top, under the
-- grass's lip. With bigger stones (DETAIL) they are bigger and sparser.
local PEBBLE = { 0.47, 0.46, 0.49 }
local STONE_BITS = { 0.035 / DETAIL ^ 2, 0.17 / DETAIL ^ 2 }
local STONE_BIT_SIZE = { 0.45 * DETAIL, 1.9 * DETAIL }
local STONE_BIT_SKEW = 2
local STONE_BIT_RISE = { 0.3, 0.4 }
local STONE_BIT_CLEAR = 1.2 * DETAIL
-- The stones are stained with dirt: solid where they come out of it,
-- breaking into blotches up to STONE_BIT_STAIN of their height.
local STONE_BIT_STAIN = 1.6

-- Drawn cracks in the dirt, running out from the stones sunk in it, as if
-- pushing them in split it: CRACK_CHANCE of the stones have them, up to
-- CRACKS each, CRACK_LENGTH studs long in CRACK_SEGMENTS jagged steps,
-- CRACK_WIDTH wide at the stone and thinning steadily to nothing at its end.
-- CRACK_BRANCH of the cracks fork once.
local CRACK = { 0.17, 0.12, 0.08 }
-- Each crack is drawn in depth: a pale lip where light catches its lower
-- edge (CRACK_LIP), the crack over it, and a darker core down its middle
-- (CRACK_CORE, CRACK_CORE_WIDTH of the crack's width).
local CRACK_LIP = { 0.66, 0.53, 0.4 }
local CRACK_CORE = { 0.06, 0.04, 0.03 }
local CRACK_CORE_WIDTH = 0.45
local CRACK_CHANCE = 1
local CRACKS = 3
local CRACK_LENGTH = { 0.6 * DETAIL, 1.8 * DETAIL }
local CRACK_SEGMENTS = 4
local CRACK_WIDTH = { 0.1 * DETAIL, 0.18 * DETAIL }
local CRACK_BRANCH = 0.4
local DIRT_BEVEL = { 0.3 * DETAIL, 0.6 * DETAIL }
-- How steeply each rock's bevel slants, in radians up from flat; each rock
-- takes its own angle in this range, so the bevels don't all match.
local DIRT_BEVEL_LIFT = { math.rad(25), math.rad(65) }
-- The dirt's outer edges and corners are rounded off on this radius, each
-- edge in this many facets, so it reads soft rather than jagged.
local DIRT_ROUND = 0.6 * DETAIL
local DIRT_ROUND_STEPS = 4
-- Each rock shades from STONE times the first where it meets the top to
-- STONE times the second at its tip.
local ROCK_GRADIENT = { 1.1, 0.6 }
-- Brush splotches in the stone: one may sit in each cell of a 3D grid
-- (`cell` studs, with `chance`), a lobed blot `radius` studs across that
-- shifts the stone's tone by up to `tone` and its tint by up to `tint`. The
-- coat's brush strokes lay them on as dabs.
local SPLOTCH = { cell = 1.8 * DETAIL, chance = 1, radius = { DETAIL, 2 * DETAIL }, tone = 0.1, tint = 0.02 }
-- Texture pixels per stud; chunks are 1024 texels across at this density.
local TEXEL_DENSITY = 16
-- Edge highlights: how far edge paint reaches from an edge, in studs, and how
-- many times wider than the default the highlight strokes are.
local EDGE_REACH = DETAIL
local HIGHLIGHT_WIDTH = 4
-- Studs over which a highlight thins from full width at a corner.
local CORNER_TAPER = 0.5 * DETAIL
-- Grass and dirt are soft, so their edge highlights and contact shadows run
-- at this share of the stone's.
local SOFT_SHADING = 0.12

-- Grass over the top: a turf slab GRASS_HEIGHT thick, pushed GRASS_OUTSET
-- past the rim, whose edge hangs down as a lip (shallowest and deepest, in
-- studs) hung all along with tongues of grass dripping further down, each
-- DRIP_WIDTH across and DRIP_LENGTH below the lip. Neighbouring drips
-- overlap by DRIP_OVERLAP of their widths, so the edge runs as one
-- unbroken wave with no flat stretch between drips.
local GRASS = { 0.74, 0.63, 0.4 }
local GRASS_HEIGHT = 0.45 * DETAIL
local GRASS_OUTSET = 0.25 * DETAIL
local GRASS_LIP = { 0.3 * DETAIL, 0.6 * DETAIL }
local DRIP_WIDTH = { 1.6 * DETAIL, 4 * DETAIL }
local DRIP_LENGTH = { 0.3 * DETAIL, 1.1 * DETAIL }
local DRIP_OVERLAP = 0.35
-- A finer octave of wobble over the wave: how far it moves the edge up or
-- down, in studs, and how fast it changes along the rim.
local DRIP_DETAIL = 0.3 * DETAIL
local DRIP_DETAIL_FREQUENCY = 1.1 / DETAIL
-- Spacing of the points the rim is walked in, in studs.
local GRASS_STEP = 0.25 * DETAIL
-- The turf's top rolls over into its hanging edge on a quarter circle this
-- many studs across, in this many facets.
local GRASS_ROUND = 0.42 * DETAIL
local GRASS_ROUND_STEPS = 4
-- The hanging edge's bottom curls under into its underside on this radius.
local GRASS_BOTTOM_ROUND = 0.2 * DETAIL
-- The rim's corners in plan are rounded off by blurring its outline over
-- about this many studs, just enough to soften each stone's jog while the
-- grass still follows the stones, pushed out GRASS_OUTSET past them. The drips' depth is
-- blurred over GRASS_DEPTH_BLUR studs, so neighbouring tongues meet in soft
-- dips rather than sharp notches.
local GRASS_CORNER_BLUR = 0.2 * DETAIL
local GRASS_DEPTH_BLUR = 0.3 * DETAIL
-- The turf's flat top is cut into squares this many studs across, to keep
-- its texture chunks small; this one doesn't grow with DETAIL.
local GRASS_TOP_CELL = 8
-- How much the grass darkens toward the tip of the deepest drip.
local DRIP_SHADE = 0.35
-- The grass is dead: straw GRASS drifting into a dull olive where a little
-- life hangs on (GRASS_OLIVE_COVER of it), in soft noise patches this many
-- studs across.
local GRASS_OLIVE = { 0.6, 0.57, 0.35 }
local GRASS_OLIVE_COVER = 0.3
local GRASS_PATCH_SIZE = 6 * DETAIL
local GRASS_SPLOTCH = 0.25
-- Within about APRON_WIDTH studs of what stands on the top (wornDistance)
-- the grass is worn down to TRODDEN dirt and gravel, in patches toward the
-- outside. These follow what stands there, not the stones, so DETAIL leaves
-- them alone.
local APRON_WIDTH = 6
local TRODDEN = { 0.47, 0.4, 0.31 }

-- Fixed per-column jitter, so the columns look uneven but every build matches.
local function hash(i: number, j: number): number
	local n = math.sin(i * 127.1 + j * 311.7) * 43758.5453
	return n - math.floor(n)
end

local seed = SEED
local function random(): number
	seed = (seed * 16807) % 2147483647
	return seed / 2147483647
end

-- Height of the slope at a point: the main cone, ridges running down from
-- the summit, and a lower shoulder peak off to one side. The cone is
-- rounded BOWL of the way toward a dome, so the underside reads as a
-- shallow bowl rather than a spike under a flat shelf.
local BOWL = 0.4
local function heightAt(x: number, y: number): number
	local r = math.sqrt(x * x + y * y) / RADIUS
	local angle = math.atan2(y, x)
	local ridges = 1 + 0.12 * math.cos(angle * 5) * r
	local out = math.min(r * ridges, 1)
	local cone = (1 - out) ^ 1.25
	local dome = math.sqrt(1 - out * out)
	local main = PEAK * (cone + (dome - cone) * BOWL)
	local sx, sy = x - 8, y + 5
	local shoulder = 19 * math.max(0, 1 - math.sqrt(sx * sx + sy * sy) / 11) ^ 1.1
	return math.max(main, shoulder)
end

-- The rim's radius at an angle.
local function rimAt(angle: number): number
	local phase = SEED * 1.7
	local wave = 0.5 * math.sin(2 * angle + phase) + 0.3 * math.sin(3 * angle + 2 * phase) + 0.2 * math.sin(5 * angle + 3 * phase)
	return RIM_PUSH * RADIUS * rimShape(angle) * (1 + RIM_WOBBLE * wave)
end

-- Stones scattered by dart throwing, none crowding another, sized by how
-- high on the slope they sit: x, y and size.
local stones = {}
for _ = 1, 8000 do
	local angle, reach = random() * TAU, math.sqrt(random()) * SCATTER
	local x, y = reach * math.cos(angle), reach * math.sin(angle)
	local height = math.clamp(heightAt(x, y) / PEAK, 0, 1)
	local size = (LARGEST + (SMALLEST - LARGEST) * height ^ 0.5) * (0.8 + 0.4 * random())
	local clear = true
	for _, other in stones do
		local dx, dy = x - other[1], y - other[2]
		if dx * dx + dy * dy < ((size + other[3]) * 0.72) ^ 2 then
			clear = false
			break
		end
	end
	if clear then
		table.insert(stones, { x, y, size })
	end
end

-- Cuts a cell outline down to the side of stone q's boundary nearer stone
-- p. Each corner carries the stone across the edge that starts there (nil
-- on the outer rim), so walls can find their neighbour.
local function clip(outline, p, q, neighbour)
	local nx, ny = q[1] - p[1], q[2] - p[2]
	local limit = (q[1] ^ 2 + q[2] ^ 2 - p[1] ^ 2 - p[2] ^ 2 - q[3] ^ 2 + p[3] ^ 2) / 2
	local function side(point)
		return point[1] * nx + point[2] * ny - limit
	end
	local kept = {}
	for i, a in outline do
		local b = outline[i % #outline + 1]
		local sa, sb = side(a), side(b)
		local crossing = if (sa <= 0) ~= (sb <= 0)
			then { a[1] + (b[1] - a[1]) * sa / (sa - sb), a[2] + (b[2] - a[2]) * sa / (sa - sb) }
			else nil
		if sa <= 0 then
			table.insert(kept, { a[1], a[2], a[3] })
			if crossing then
				table.insert(kept, { crossing[1], crossing[2], neighbour })
			end
		elseif crossing then
			table.insert(kept, { crossing[1], crossing[2], a[3] })
		end
	end
	return kept
end

-- The rim's corners, then each of its sides as a plane n . p <= limit,
-- in order round from angle 0.
local rimSides = {}
do
	local rim = {}
	for i = 0, RIM_SIDES - 1 do
		local angle = i / RIM_SIDES * TAU
		local r = rimAt(angle)
		rim[i + 1] = { r * math.cos(angle), r * math.sin(angle) }
	end
	for i, a in rim do
		local b = rim[i % #rim + 1]
		-- Counter-clockwise, so out is to the right of each side.
		local nx, ny = b[2] - a[2], a[1] - b[1]
		table.insert(rimSides, { nx, ny, nx * a[1] + ny * a[2] })
	end
end

-- Cuts a cell outline down to the inside of one rim side; corners where it
-- crosses carry nil, as on the outer rim.
local function clipToRim(outline, side)
	local nx, ny, limit = side[1], side[2], side[3]
	local kept = {}
	for i, a in outline do
		local b = outline[i % #outline + 1]
		local sa, sb = a[1] * nx + a[2] * ny - limit, b[1] * nx + b[2] * ny - limit
		if sa <= 0 then
			table.insert(kept, { a[1], a[2], a[3] })
		end
		if (sa <= 0) ~= (sb <= 0) then
			local t = sa / (sa - sb)
			table.insert(kept, { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, if sa <= 0 then nil else a[3] })
		end
	end
	return kept
end

-- Each stone's column: its outline and its top corners on a slanted plane.
local columns = {}
for index, stone in stones do
	local outline = {}
	for i = 0, 31 do
		local angle = i / 32 * TAU
		table.insert(outline, { SCATTER * math.cos(angle), SCATTER * math.sin(angle), nil })
	end
	for other, neighbour in stones do
		if other ~= index and #outline >= 3 then
			local dx, dy = neighbour[1] - stone[1], neighbour[2] - stone[2]
			if dx * dx + dy * dy < (LARGEST * 3) ^ 2 then
				outline = clip(outline, stone, neighbour, other)
			end
		end
	end
	-- Every cell is trimmed to the rim sides it faces (the rim isn't convex,
	-- so the far sides would cut into its swells); those left with nothing
	-- inside the rim are dropped. A cell's sides are those over the angles
	-- its corners span, and a few either way so neighbours trim alike.
	local low, high, farthest = math.huge, -math.huge, 0
	local heading = math.atan2(stone[2], stone[1])
	for _, corner in outline do
		local offset = (math.atan2(corner[2], corner[1]) - heading + math.pi) % TAU - math.pi
		low, high = math.min(low, offset), math.max(high, offset)
		farthest = math.max(farthest, math.sqrt(corner[1] ^ 2 + corner[2] ^ 2))
	end
	if farthest > RIM_PUSH * RADIUS * (1 - RIM_WOBBLE) then
		local first = math.floor((heading + low) / TAU * RIM_SIDES) - 8
		local last = math.ceil((heading + high) / TAU * RIM_SIDES) + 8
		for k = first, last do
			if #outline < 3 then
				break
			end
			outline = clipToRim(outline, rimSides[k % RIM_SIDES + 1])
		end
	end
	local area = 0
	for i, a in outline do
		local b = outline[i % #outline + 1]
		area += (a[1] * b[2] - b[1] * a[2]) / 2
	end
	-- Only cells the rim leaves nothing of are dropped; a small one kept at
	-- the rim fills its stretch so the edge doesn't notch.
	if #outline < 3 or math.abs(area) < 1e-3 then
		continue
	end
	local cx, cy = 0, 0
	for _, corner in outline do
		cx, cy = cx + corner[1] / #outline, cy + corner[2] / #outline
	end
	local rise = math.max(MIN_LENGTH * (0.8 + 0.4 * hash(index, 5)), heightAt(cx, cy) + (hash(index, 1) - 0.5) * (1 + stone[3]))
	local tiltX, tiltY = (hash(index, 2) - 0.5) * 0.45, (hash(index, 3) - 0.5) * 0.45
	local corners = {}
	-- Neighbouring columns share their edges exactly, so no gap opens
	-- between them.
	for i, corner in outline do
		local z = rise + (corner[1] - cx) * tiltX + (corner[2] - cy) * tiltY
		corners[i] = { corner[1], corner[2], z, corner[3] }
	end
	columns[index] = {
		index = index,
		size = stone[3],
		corners = corners,
		-- The top rises to a low ridge point, so it reads as broken stone.
		peak = { cx, cy, rise + 0.15 * stone[3] * (0.5 + hash(index, 4)) },
	}
end

-- A column as a closed solid: faces as lists of points, wound outward,
-- from the foot (z = 0) up to its slanted top and the low point above it.
local function solidOf(column)
	local bottom = 0
	local corners, peak = column.corners, column.peak
	local count = #corners
	local faces = {}
	local base = {}
	for i = count, 1, -1 do
		table.insert(base, { corners[i][1], corners[i][2], bottom })
	end
	table.insert(faces, base)
	for i = 1, count do
		local a, b = corners[i], corners[i % count + 1]
		table.insert(faces, { { a[1], a[2], bottom }, { b[1], b[2], bottom }, { b[1], b[2], b[3] }, { a[1], a[2], a[3] } })
		table.insert(faces, { { peak[1], peak[2], peak[3] }, { a[1], a[2], a[3] }, { b[1], b[2], b[3] } })
	end
	return faces
end

-- Cuts away everything on the far side of the plane n . p = d, closing the
-- wound with a cap facing along n.
local function carve(faces, n, d)
	local kept, cut = {}, {}
	for _, face in faces do
		local out = {}
		for i, a in face do
			local b = face[i % #face + 1]
			local sa = a[1] * n[1] + a[2] * n[2] + a[3] * n[3] - d
			local sb = b[1] * n[1] + b[2] * n[2] + b[3] * n[3] - d
			if sa <= 0 then
				table.insert(out, a)
			end
			if (sa <= 0) ~= (sb <= 0) then
				local t = sa / (sa - sb)
				local p = { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
				table.insert(out, p)
				table.insert(cut, p)
			end
		end
		if #out >= 3 then
			table.insert(kept, out)
		end
	end
	if #cut < 3 then
		return kept
	end
	-- The cap's corners, sorted round their centre in the plane.
	local mx, my, mz = 0, 0, 0
	for _, p in cut do
		mx, my, mz = mx + p[1] / #cut, my + p[2] / #cut, mz + p[3] / #cut
	end
	local ux, uy, uz = if math.abs(n[3]) < 0.9 then -n[2] else 0, if math.abs(n[3]) < 0.9 then n[1] else -n[3], if math.abs(n[3]) < 0.9 then 0 else n[2]
	local length = math.sqrt(ux * ux + uy * uy + uz * uz)
	ux, uy, uz = ux / length, uy / length, uz / length
	local vx, vy, vz = n[2] * uz - n[3] * uy, n[3] * ux - n[1] * uz, n[1] * uy - n[2] * ux
	local cap = {}
	for _, p in cut do
		local ox, oy, oz = p[1] - mx, p[2] - my, p[3] - mz
		local angle = math.atan2(ox * vx + oy * vy + oz * vz, ox * ux + oy * uy + oz * uz)
		local duplicate = false
		for _, other in cap do
			duplicate = duplicate or math.abs(other[2] - angle) < 1e-4
		end
		if not duplicate then
			table.insert(cap, { p, angle })
		end
	end
	table.sort(cap, function(a, b)
		return a[2] < b[2]
	end)
	if #cap >= 3 then
		local face = {}
		for i, entry in cap do
			face[i] = entry[1]
		end
		table.insert(kept, face)
	end
	return kept
end

-- Carve every column first, so walls can be cut against their
-- neighbours' finished shapes.
for _, column in columns do
	local corners, index = column.corners, column.index
	local faces = solidOf(column)
	local outward = math.atan2(column.peak[2], column.peak[1])

	-- Chisel cuts: each faces out and up at its own angle, from a low
	-- slant (shaving a side edge) to steep (bevelling the top), and
	-- bites a set depth in from the farthest point along it. None is
	-- near level, which would open holes down between columns. Every cut
	-- faces away from the island's centre, within CUT_SPREAD either side,
	-- so the carving shows on the outside and never faces inward.
	-- The cuts to make: heading, lift and depth. The big chisel cuts come
	-- first, then fine chips that knock small corners off what is left.
	local cuts = {}
	for k = 1, 1 + math.floor(hash(index, 40) * MAX_CUTS) do
		table.insert(cuts, {
			outward + (hash(index, 40 + k) - 0.5) * 2 * CUT_SPREAD,
			0.35 + hash(index, 50 + k) * 0.85,
			column.size * (CUT_DEPTH[1] + (CUT_DEPTH[2] - CUT_DEPTH[1]) * hash(index, 60 + k)),
		})
	end
	for k = 1, CHIPS[1] + math.floor(hash(index, 70) * (CHIPS[2] - CHIPS[1] + 1)) do
		table.insert(cuts, {
			outward + (hash(index, 70 + k) - 0.5) * 2 * CUT_SPREAD,
			0.35 + hash(index, 80 + k) * 1.05,
			CHIP_DEPTH[1] + (CHIP_DEPTH[2] - CHIP_DEPTH[1]) * hash(index, 90 + k),
		})
	end
	for _, cut in cuts do
		local heading, lift, depth = cut[1], cut[2], cut[3]
		local n = { math.cos(heading) * math.cos(lift), math.sin(heading) * math.cos(lift), math.sin(lift) }
		local farthest = -math.huge
		for _, face in faces do
			for _, p in face do
				farthest = math.max(farthest, p[1] * n[1] + p[2] * n[2] + p[3] * n[3])
			end
		end
		-- A cut stops short of the top tier, which follows the grass, so
		-- the wall under the grass is never carved into.
		local tiermost = -math.huge
		for _, corner in corners do
			tiermost = math.max(tiermost, corner[1] * n[1] + corner[2] * n[2] + DIRT_CONFORM * n[3])
		end
		local plane = math.max(farthest - depth, tiermost + 0.3)
		if plane < farthest then
			faces = carve(faces, n, plane)
		end
	end

	column.faces = faces

	-- Where the column's carved underside begins: the shallowest point of
	-- any face that isn't a side wall or its foot.
	column.surfaceFrom = math.huge
	for _, face in faces do
		local foot, nz = true, 0
		for i, p in face do
			local q = face[i % #face + 1]
			foot = foot and p[3] == 0
			nz += (p[1] - q[1]) * (p[2] + q[2])
		end
		if not foot and math.abs(nz) > 1e-3 then
			for _, p in face do
				column.surfaceFrom = math.min(column.surfaceFrom, p[3])
			end
		end
	end
end

-- How deep each column hides behind the tier around it: it comes into view
-- where its shallowest neighbour's underside begins, or at the top if it
-- faces the open edge.
for _, column in columns do
	column.shownFrom = math.huge
	for _, corner in column.corners do
		local neighbour = corner[4] and columns[corner[4]]
		column.shownFrom = math.min(column.shownFrom, if neighbour then neighbour.surfaceFrom else 0)
	end
end

-- How deep the island hangs at its lowest point.
local islandDepth = 0
for _, column in columns do
	islandDepth = math.max(islandDepth, column.peak[3])
end

-- How far a solid reaches along a direction.
local function farthestAlong(faces, n): number
	local farthest = -math.huge
	for _, face in faces do
		for _, p in face do
			farthest = math.max(farthest, p[1] * n[1] + p[2] * n[2] + p[3] * n[3])
		end
	end
	return farthest
end

-- Cuts a solid's outer bottom edge off, `depth` studs in along a slant facing
-- out from the island's centre and down, `lift` radians up from flat.
local function bevelled(faces, outward: number, depth: number, lift: number)
	local n = { math.cos(outward) * math.cos(lift), math.sin(outward) * math.cos(lift), math.sin(lift) }
	return carve(faces, n, farthestAlong(faces, n) - depth)
end

-- Each rock is dirt down to where it comes through, and stone below, split
-- into a dirt solid and a stone one. The dirt's outer bottom edge is
-- bevelled off, so the stone under it stands proud. Higher up, a patch of a
-- rock's outer face may already show through: the dirt is split into the
-- slab on its outer face and the rest, and the slab into bare stone below a
-- tilted line and dirt above, bevelled like the rest.
for _, column in columns do
	local index, faces = column.index, column.faces
	local share = DIRT_TRANSITION[1] + (DIRT_TRANSITION[2] - DIRT_TRANSITION[1]) * hash(index, 30)
	local dirtLine = islandDepth * share
	column.dirtLine = dirtLine
	if dirtLine <= column.shownFrom then
		column.solids = { { faces = faces, dirt = false } }
		continue
	end
	local shown = column.shownFrom
	local outward = math.atan2(column.peak[2], column.peak[1])
	local bevel = DIRT_BEVEL[1] + (DIRT_BEVEL[2] - DIRT_BEVEL[1]) * hash(index, 31)
	local lift = DIRT_BEVEL_LIFT[1] + (DIRT_BEVEL_LIFT[2] - DIRT_BEVEL_LIFT[1]) * hash(index, 34)
	-- The tilted line passes through dirtLine under the rock's tip.
	local tilt, heading = DIRT_TILT * hash(index, 32), hash(index, 33) * 2 * math.pi
	local down = { math.sin(tilt) * math.cos(heading), math.sin(tilt) * math.sin(heading), math.cos(tilt) }
	local line = down[1] * column.peak[1] + down[2] * column.peak[2] + down[3] * dirtLine
	local dirt = bevelled(carve(faces, down, line), outward, bevel, lift)
	local stone = carve(faces, { -down[1], -down[2], -down[3] }, -line)
	column.solids = { { faces = dirt, dirt = true }, { faces = stone, dirt = false } }
	-- The stone shows from below the dirt.
	column.shownFrom = math.min(dirtLine, column.peak[3])

	local middle = (shown + dirtLine) / 2 / islandDepth
	local chance = math.clamp((middle - PATCH_FROM) / (PATCH_FULL - PATCH_FROM), 0, 1)
	if dirtLine - shown <= 1 then
		continue
	end
	-- Each slab is cut from the dirt left after the last, so they sit side
	-- by side round the rock.
	local rest, solids = dirt, { { faces = stone, dirt = false } }
	for k = 1, PATCHES do
		if hash(index, 204 + k * 10) >= chance then
			continue
		end
		local heading = outward + (hash(index, 205 + k * 10) - 0.5) * 2 * PATCH_SPREAD
		local lean = (hash(index, 300 + k * 10) - 0.5) * 2 * PATCH_LEAN
		local size = math.sqrt(1 + lean * lean)
		local across = { math.cos(heading) / size, math.sin(heading) / size, lean / size }
		local thickness = PATCH_THICKNESS[1] + (PATCH_THICKNESS[2] - PATCH_THICKNESS[1]) * hash(index, 206 + k * 10)
		local face = farthestAlong(rest, across) - thickness
		local slab = carve(rest, { -across[1], -across[2], -across[3] }, -face)
		rest = carve(rest, across, face)
		-- The slab's top line, tilted, somewhere down what shows of the rock:
		-- above it dirt, below it bare rock.
		local function topLine(seed: number)
			local top = shown + (dirtLine - shown) * (0.05 + 0.45 * hash(index, seed))
			local tx = (hash(index, seed + 1) - 0.5) * 2 * PATCH_TILT
			local ty = (hash(index, seed + 2) - 0.5) * 2 * PATCH_TILT
			local length = math.sqrt(tx * tx + ty * ty + 1)
			local down = { tx / length, ty / length, 1 / length }
			-- Never above the top tier anywhere across the slab.
			local level = -math.huge
			for _, f in slab do
				for _, p in f do
					level = math.max(level, down[1] * p[1] + down[2] * p[2] + down[3] * DIRT_CONFORM)
				end
			end
			return down, math.max(down[1] * column.peak[1] + down[2] * column.peak[2] + down[3] * top, level)
		end
		local down, line = topLine(207 + k * 10)
		table.insert(solids, { faces = bevelled(carve(slab, down, line), heading, bevel * 0.7, lift), dirt = true })
		local bare = carve(slab, { -down[1], -down[2], -down[3] }, -line)
		-- A second line peaks the rock: the dirt it cuts off stays dirt.
		if hash(index, 320 + k * 10) < PATCH_PEAKED then
			local second, secondLine = topLine(330 + k * 10)
			table.insert(solids, { faces = bevelled(carve(bare, second, secondLine), heading, bevel * 0.7, lift), dirt = true })
			bare = carve(bare, { -second[1], -second[2], -second[3] }, -secondLine)
		end
		-- Chipped into a rough stone rather than a flat slab.
		local chips = PATCH_CHIPS[1] + math.floor(hash(index, 400 + k * 10) * (PATCH_CHIPS[2] - PATCH_CHIPS[1] + 1))
		for c = 1, chips do
			local seed = 500 + k * 100 + c * 7
			local yaw = heading + (hash(index, seed) - 0.5) * 2 * PATCH_CHIP_SPREAD
			local pitch = (hash(index, seed + 1) - 0.5) * 2 * PATCH_CHIP_SPREAD
			local n = { math.cos(yaw) * math.cos(pitch), math.sin(yaw) * math.cos(pitch), math.sin(pitch) }
			local depth = PATCH_CHIP_DEPTH[1] + (PATCH_CHIP_DEPTH[2] - PATCH_CHIP_DEPTH[1]) * hash(index, seed + 2)
			local plane = farthestAlong(bare, n) - depth
			if plane > -math.huge then
				bare = carve(bare, n, plane)
			end
		end
		table.insert(solids, { faces = bare, dirt = false })
	end
	table.insert(solids, { faces = rest, dirt = true })
	column.solids = solids
end

-- Each face's plane, as a unit normal pointing out and its distance.
local function planeOf(face)
	local nx, ny, nz = 0, 0, 0
	for i, a in face do
		local b = face[i % #face + 1]
		nx += (a[2] - b[2]) * (a[3] + b[3])
		ny += (a[3] - b[3]) * (a[1] + b[1])
		nz += (a[1] - b[1]) * (a[2] + b[2])
	end
	local length = math.sqrt(nx * nx + ny * ny + nz * nz)
	if length < 1e-9 then
		return nil
	end
	nx, ny, nz = nx / length, ny / length, nz / length
	local p = face[1]
	return { nx, ny, nz, nx * p[1] + ny * p[2] + nz * p[3] }
end

-- Splits a face by a plane into the part outside it and the part inside.
local EPSILON = 1e-5
local function split(face, plane)
	local outside, inside = {}, {}
	local function side(p)
		local s = plane[1] * p[1] + plane[2] * p[2] + plane[3] * p[3] - plane[4]
		return if math.abs(s) < EPSILON then 0 else s
	end
	for i, a in face do
		local b = face[i % #face + 1]
		local sa, sb = side(a), side(b)
		if sa >= 0 then
			table.insert(outside, a)
		end
		if sa <= 0 then
			table.insert(inside, a)
		end
		if (sa > 0 and sb < 0) or (sa < 0 and sb > 0) then
			local t = sa / (sa - sb)
			local p = { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
			table.insert(outside, p)
			table.insert(inside, p)
		end
	end
	return outside, inside
end

local function area(face): number
	local plane = planeOf(face)
	if not plane or #face < 3 then
		return 0
	end
	local total = 0
	for i = 2, #face - 1 do
		local a, b, c = face[1], face[i], face[i + 1]
		local ux, uy, uz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local vx, vy, vz = c[1] - a[1], c[2] - a[2], c[3] - a[3]
		total += ((uy * vz - uz * vy) * plane[1] + (uz * vx - ux * vz) * plane[2] + (ux * vy - uy * vx) * plane[3]) / 2
	end
	return total
end

-- The parts of a face that don't lie inside a neighbour. Only a face lying
-- against one of the neighbour's own faces can touch it; that face's plane
-- is skipped, and the face is carved by the rest, every piece that falls
-- outside one of them showing.
local function uncovered(face, neighbour)
	local own = planeOf(face)
	if not own then
		return {}
	end
	local touching, planes = false, {}
	for _, other in neighbour.faces do
		local plane = planeOf(other)
		if plane then
			local facing = own[1] * plane[1] + own[2] * plane[2] + own[3] * plane[3] < -0.9999
			local p = face[1]
			if facing and math.abs(plane[1] * p[1] + plane[2] * p[2] + plane[3] * p[3] - plane[4]) < 1e-4 then
				touching = true
			else
				table.insert(planes, plane)
			end
		end
	end
	if not touching then
		return { face }
	end
	local shown, rest = {}, face
	for _, plane in planes do
		local outside, inside = split(rest, plane)
		if #outside >= 3 and area(outside) > 1e-4 then
			table.insert(shown, outside)
		end
		rest = inside
		if #rest < 3 or area(rest) <= 1e-4 then
			break
		end
	end
	return shown
end

-- Columns bucketed by the 2-stud cells their outlines cover, so paint can
-- find the rock under a point without testing them all.
local CELL = 2
local cells = {}
for _, column in columns do
	local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
	for _, corner in column.corners do
		x0, y0 = math.min(x0, corner[1]), math.min(y0, corner[2])
		x1, y1 = math.max(x1, corner[1]), math.max(y1, corner[2])
	end
	for cx = math.floor(x0 / CELL), math.floor(x1 / CELL) do
		for cy = math.floor(y0 / CELL), math.floor(y1 / CELL) do
			local cellKey = `{cx},{cy}`
			cells[cellKey] = cells[cellKey] or {}
			table.insert(cells[cellKey], column)
		end
	end
end

-- The rock a point on the island belongs to. On a wall two rocks share,
-- the deeper one owns it, since only its wall shows there.
local function rockAt(x: number, y: number)
	local found = nil
	for _, column in cells[`{math.floor(x / CELL)},{math.floor(y / CELL)}`] or {} do
		local corners, within = column.corners, true
		for i, a in corners do
			local b = corners[i % #corners + 1]
			if (b[1] - a[1]) * (y - a[2]) - (b[2] - a[2]) * (x - a[1]) < -1e-3 then
				within = false
				break
			end
		end
		if within and (found == nil or column.peak[3] > found.peak[3]) then
			found = column
		end
	end
	return found
end

-- The splotch on top at a point, as its tone and warmth shifts (0, 0 where
-- none reaches). Of the splotches covering a point, the one laid last wins.
local function splotchAt(x: number, y: number, z: number): (number, number)
	local size = SPLOTCH.cell
	local gx, gy, gz = math.floor(x / size), math.floor(y / size), math.floor(z / size)
	local tone, warm, order = 0, 0, -1
	for i = gx - 1, gx + 1 do
		for j = gy - 1, gy + 1 do
			for k = gz - 1, gz + 1 do
				local seed = i * 7.31 + k * 3.17
				if hash(seed, j + 101) < SPLOTCH.chance then
					local cx = (i + hash(seed, j + 201)) * size
					local cy = (j + hash(seed, j + 301)) * size
					local cz = (k + hash(seed, j + 401)) * size
					local radius = SPLOTCH.radius[1] + (SPLOTCH.radius[2] - SPLOTCH.radius[1]) * hash(seed, j + 501)
					local dx, dy, dz = x - cx, y - cy, z - cz
					-- Lobed rim, so a blot isn't a clean circle.
					local lobes = 1 + 0.25 * math.noise(dx / radius * 1.5 + i, dy / radius * 1.5 + j, dz / radius * 1.5 + k)
					local laid = hash(seed, j + 601)
					if dx * dx + dy * dy + dz * dz < (radius * lobes) ^ 2 and laid > order then
						order = laid
						tone = (hash(seed, j + 701) - 0.5) * 2 * SPLOTCH.tone
						warm = (hash(seed, j + 801) - 0.5) * 2 * SPLOTCH.tint
					end
				end
			end
		end
	end
	return tone, warm
end

-- Per-rock gradient over the part of a rock that shows: light where it
-- comes out from behind the tier around it, darkening toward its tip. The
-- island hangs below z = 0, so depth is -z. Near the top the rock is dirt,
-- fading to stone further down.
-- How far from dirt toward stone the colour has blended at a point, 0 to 1.
local function stoneAt(x: number, y: number, z: number): number
	local share = -z / islandDepth + COLOR_WOBBLE * math.noise(x * 0.15 / DETAIL, y * 0.15 / DETAIL, z * 0.15 / DETAIL)
	local t = math.clamp((share - COLOR_TRANSITION[1]) / (COLOR_TRANSITION[2] - COLOR_TRANSITION[1]), 0, 1)
	return t * t * (3 - 2 * t)
end

-- A colour between dirt and stone, `t` of the way to stone.
local function soil(t: number): (number, number, number)
	return DIRT[1] + (STONE[1] - DIRT[1]) * t, DIRT[2] + (STONE[2] - DIRT[2]) * t, DIRT[3] + (STONE[3] - DIRT[3]) * t
end

local paintRock = rusting(0.1, function(x, y, z)
	local rock = rockAt(x, y)
	local depth = if rock
		then math.clamp((-z - rock.shownFrom) / math.max(rock.peak[3] - rock.shownFrom, 0.5), 0, 1)
		else 0
	local shade = ROCK_GRADIENT[1] + (ROCK_GRADIENT[2] - ROCK_GRADIENT[1]) * depth ^ 0.8
	local tone, warm = splotchAt(x, y, z)
	shade *= 1 + tone
	local blend = stoneAt(x, y, z)
	local r, g, b = soil(DIRT_LEAD + (1 - DIRT_LEAD) * blend)
	-- Dirt traces: blotches whose share of the stone shrinks below the line.
	if rock then
		local below = -z - rock.dirtLine
		local amount = if below < 0 then DIRT_DUSTING else math.max(0, 1 - below / DIRT_TRACE) ^ 1.5
		local f = 0.7 / DETAIL
		local blot = 0.5 + 0.5 * math.noise(x * f, y * f, z * f) + 0.25 * math.noise(x * f * 3, y * f * 3, z * f * 3)
		local trace = math.clamp((blot - (1 - 0.7 * amount)) / 0.08, 0, 1)
		if trace > 0 then
			local dr, dg, db = soil(0.25 * blend)
			r, g, b = r + (dr - r) * trace, g + (dg - g) * trace, b + (db - b) * trace
		end
	end
	local share = -z / islandDepth
	-- Grime: soft-edged patches, less of them deeper down.
	local growth = math.clamp((GRIME_REACH - share) / (GRIME_REACH - DIRT_TRANSITION[1]), 0, 1)
	if growth > 0 then
		local f = 0.45 / DETAIL
		local patch = 0.5 + 0.5 * math.noise(x * f + 31, y * f, z * f) + 0.2 * math.noise(x * f * 3.6, y * f * 3.6 + 17, z * f * 3.6)
		local grime = math.clamp((patch - (1 - GRIME_COVER * growth)) / 0.1, 0, 1)
		r, g, b = r + (GRIME[1] - r) * grime, g + (GRIME[2] - g) * grime, b + (GRIME[3] - b) * grime
	end
	return r * shade * (1 + warm), g * shade, b * shade * (1 - warm)
end)

-- Dirt darkens a little with depth, greys toward stone, and is splotched
-- like the stone.
local paintDirt = rusting(0.05, function(x, y, z)
	local shade = 1.05 - 0.3 * math.clamp(-z / (islandDepth * DIRT_TRANSITION[2]), 0, 1)
	local tone, warm = splotchAt(x, y, z)
	shade *= 1 + tone
	local r, g, b = soil((1 - DIRT_LEAD) * stoneAt(x, y, z))
	return r * shade * (1 + warm), g * shade, b * shade * (1 - warm)
end)

-- Flipped upside down as it is written out: z mirrors, and the winding
-- reverses so faces still point outward. The foot becomes the island's top.
local function addFlipped(mesh, face)
	local verts = {}
	for i, p in face do
		verts[#face + 1 - i] = mesh:vertex(p[1], p[2], -p[3])
	end
	mesh:face(verts)
end

-- The island is split into cubic chunks, each with its own texture, so the
-- stone reads sharp at one density everywhere.
useTexelDensity(TEXEL_DENSITY)

-- A unit vector along x, y, z, and the cross product of two vectors.
local function unit(x: number, y: number, z: number)
	local length = math.max(math.sqrt(x * x + y * y + z * z), 1e-9)
	return { x / length, y / length, z / length }
end
local function cross(a, b)
	return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
end

-- The solids that may cover a solid of a column: the column's other pieces
-- and its neighbours'.
local function coverersOf(column, solid)
	local others = {}
	for _, other in column.solids do
		if other ~= solid then
			table.insert(others, other)
		end
	end
	for _, corner in column.corners do
		local neighbour = corner[4] and columns[corner[4]]
		if neighbour then
			for _, other in neighbour.solids do
				table.insert(others, other)
			end
		end
	end
	return others
end

-- What of a face no other solid covers.
local function exposed(face, others)
	local pieces = { face }
	for _, other in others do
		local kept = {}
		for _, piece in pieces do
			for _, part in uncovered(piece, other) do
				table.insert(kept, part)
			end
		end
		pieces = kept
	end
	return pieces
end

local function isFoot(face): boolean
	for _, p in face do
		if p[3] ~= 0 then
			return false
		end
	end
	return true
end

-- Rounds a convex solid's edges and corners where faces that show meet, on
-- DIRT_ROUND. Each such edge is cut by planes turning from one face to the
-- other, each touching a cylinder of that radius set in from both faces;
-- each such corner by one plane facing out between its faces.
local function rounded(faces, shows)
	local planes = {}
	for i, face in faces do
		planes[i] = planeOf(face)
	end
	local function key(p)
		return `{math.round(p[1] * 1e4)},{math.round(p[2] * 1e4)},{math.round(p[3] * 1e4)}`
	end
	local edgeFaces, cornerFaces, points = {}, {}, {}
	for i, face in faces do
		if not planes[i] or not shows[i] then
			continue
		end
		for k, a in face do
			local b = face[k % #face + 1]
			local ka, kb = key(a), key(b)
			points[ka] = a
			local edge = if ka < kb then `{ka}|{kb}` else `{kb}|{ka}`
			edgeFaces[edge] = edgeFaces[edge] or { a = a }
			table.insert(edgeFaces[edge], i)
			cornerFaces[ka] = cornerFaces[ka] or {}
			cornerFaces[ka][i] = true
		end
	end
	local cuts = {}
	for _, edge in edgeFaces do
		if #edge ~= 2 then
			continue
		end
		local n1, n2 = planes[edge[1]], planes[edge[2]]
		local cosine = n1[1] * n2[1] + n1[2] * n2[2] + n1[3] * n2[3]
		if cosine > 0.985 then
			continue
		end
		local p = edge.a
		local inset = DIRT_ROUND / (1 + cosine)
		local centre = { p[1] - (n1[1] + n2[1]) * inset, p[2] - (n1[2] + n2[2]) * inset, p[3] - (n1[3] + n2[3]) * inset }
		for k = 1, DIRT_ROUND_STEPS do
			local t = k / (DIRT_ROUND_STEPS + 1)
			local m = unit(n1[1] + (n2[1] - n1[1]) * t, n1[2] + (n2[2] - n1[2]) * t, n1[3] + (n2[3] - n1[3]) * t)
			table.insert(cuts, { m, m[1] * centre[1] + m[2] * centre[2] + m[3] * centre[3] + DIRT_ROUND })
		end
	end
	for corner, touching in cornerFaces do
		local sum, count = { 0, 0, 0 }, 0
		for i in touching do
			sum = { sum[1] + planes[i][1], sum[2] + planes[i][2], sum[3] + planes[i][3] }
			count += 1
		end
		if count >= 3 then
			local m = unit(sum[1], sum[2], sum[3])
			local v = points[corner]
			table.insert(cuts, { m, m[1] * v[1] + m[2] * v[2] + m[3] * v[3] - DIRT_ROUND * 0.6 })
		end
	end
	for _, cut in cuts do
		faces = carve(faces, cut[1], cut[2])
	end
	return faces
end

-- Round the dirt where it shows: which faces show is settled for every
-- solid first, so rounding one doesn't change what its neighbours see.
do
	local plans = {}
	for _, column in columns do
		for _, solid in column.solids do
			if not solid.dirt then
				continue
			end
			local others, shows = coverersOf(column, solid), {}
			for i, face in solid.faces do
				local whole = area(face)
				if whole > 1e-4 and not isFoot(face) then
					local open = 0
					for _, piece in exposed(face, others) do
						open += area(piece)
					end
					shows[i] = open > whole * 0.5
				end
			end
			table.insert(plans, { solid = solid, shows = shows })
		end
	end
	for _, plan in plans do
		plan.solid.faces = rounded(plan.solid.faces, plan.shows)
	end
end

-- The faces of every column's dirt or stone that show. Only what no other
-- solid covers is kept, another piece of its own column or a neighbour's,
-- so nothing lies buried inside the island. The flat top is left open: the
-- grass covers it.
local function visibleRock(dirt: boolean)
	local shown = {}
	for _, column in columns do
		for _, solid in column.solids do
			if solid.dirt ~= dirt then
				continue
			end
			local others = coverersOf(column, solid)
			for _, face in solid.faces do
				if isFoot(face) then
					continue
				end
				for _, piece in exposed(face, others) do
					table.insert(shown, piece)
				end
			end
		end
	end
	return shown
end

local dirtFaces = visibleRock(true)

-- A box around a centre, `r` from it each way, its faces wound outward.
local function boxAround(c, r)
	local x0, x1, y0, y1, z0, z1 = c[1] - r, c[1] + r, c[2] - r, c[2] + r, c[3] - r, c[3] + r
	return {
		{ { x0, y0, z0 }, { x0, y1, z0 }, { x1, y1, z0 }, { x1, y0, z0 } },
		{ { x0, y0, z1 }, { x1, y0, z1 }, { x1, y1, z1 }, { x0, y1, z1 } },
		{ { x0, y0, z0 }, { x1, y0, z0 }, { x1, y0, z1 }, { x0, y0, z1 } },
		{ { x0, y1, z0 }, { x0, y1, z1 }, { x1, y1, z1 }, { x1, y1, z0 } },
		{ { x0, y0, z0 }, { x0, y0, z1 }, { x0, y1, z1 }, { x0, y1, z0 } },
		{ { x1, y0, z0 }, { x1, y1, z0 }, { x1, y1, z1 }, { x1, y0, z1 } },
	}
end

-- The stones in the dirt, each as the faces that stand out of it. A stone
-- is a box turned at random and chipped at its corners, sunk into a dirt
-- face, and cut off at that face so nothing of it lies buried.
local pebbleSeed = 7
local function pebbleRandom(): number
	pebbleSeed = (pebbleSeed * 16807) % 2147483647
	return pebbleSeed / 2147483647
end
-- How far a point lies from the nearest edge of a face.
local function edgeDistance(face, p): number
	local nearest = math.huge
	for i, a in face do
		local b = face[i % #face + 1]
		local ab = { b[1] - a[1], b[2] - a[2], b[3] - a[3] }
		local length = ab[1] ^ 2 + ab[2] ^ 2 + ab[3] ^ 2
		local t = if length > 0 then math.clamp(((p[1] - a[1]) * ab[1] + (p[2] - a[2]) * ab[2] + (p[3] - a[3]) * ab[3]) / length, 0, 1) else 0
		local dx, dy, dz = p[1] - a[1] - ab[1] * t, p[2] - a[2] - ab[2] * t, p[3] - a[3] - ab[3] * t
		nearest = math.min(nearest, math.sqrt(dx * dx + dy * dy + dz * dz))
	end
	return nearest
end

local pebbles = {}
-- Where cracks start: each stone's face, normal, centre on the dirt and how
-- far its rim reaches.
local crackOrigins = {}
-- Each stone as where it meets the dirt (point and outward normal, already
-- flipped) and how far it stands out, bucketed by 2-stud cell for its paint.
local pebbleCells = {}
local function pebbleCell(x: number, y: number, z: number): string
	return `{math.floor(x / 2)},{math.floor(y / 2)},{math.floor(z / 2)}`
end
for _, face in dirtFaces do
	local plane = planeOf(face)
	if not plane then
		continue
	end
	local n = { plane[1], plane[2], plane[3] }
	for i = 2, #face - 1 do
		local a, b, c = face[1], face[i], face[i + 1]
		local triangle = area({ a, b, c })
		local depth = (a[3] + b[3] + c[3]) / 3
		local toward = math.clamp(depth / (islandDepth * DIRT_TRANSITION[1]), 0, 1)
		local density = STONE_BITS[1] + (STONE_BITS[2] - STONE_BITS[1]) * toward
		local count = math.floor(triangle * density + pebbleRandom())
		for _ = 1, count do
			local u, v = pebbleRandom(), pebbleRandom()
			if u + v > 1 then
				u, v = 1 - u, 1 - v
			end
			local p = {
				a[1] + (b[1] - a[1]) * u + (c[1] - a[1]) * v,
				a[2] + (b[2] - a[2]) * u + (c[2] - a[2]) * v,
				a[3] + (b[3] - a[3]) * u + (c[3] - a[3]) * v,
			}
			local size = STONE_BIT_SIZE[1] + (STONE_BIT_SIZE[2] - STONE_BIT_SIZE[1]) * pebbleRandom() ^ STONE_BIT_SKEW
			-- A stone too big for the room it has on its face is made smaller,
			-- so it never hangs off an edge.
			size = math.min(size, edgeDistance(face, p) * 2.2)
			local r = size / 2
			if p[3] < STONE_BIT_CLEAR or size < STONE_BIT_SIZE[1] * 0.8 then
				continue
			end
			local rise = STONE_BIT_RISE[1] + (STONE_BIT_RISE[2] - STONE_BIT_RISE[1]) * pebbleRandom()
			table.insert(crackOrigins, { face = face, normal = n, at = p, rim = r * 1.0 })
			local centre = { p[1] + n[1] * r * (2 * rise - 1), p[2] + n[2] * r * (2 * rise - 1), p[3] + n[3] * r * (2 * rise - 1) }
			-- A box turned at random: start big, and cut each side in to r.
			local x = unit(pebbleRandom() - 0.5, pebbleRandom() - 0.5, pebbleRandom() - 0.5)
			local y = cross(x, unit(pebbleRandom() - 0.5, pebbleRandom() - 0.5, pebbleRandom() - 0.5))
			y = unit(y[1], y[2], y[3])
			local z = cross(x, y)
			local stone = boxAround(centre, size * 2)
			for _, axis in { x, y, z } do
				for _, sign in { 1, -1 } do
					local d = { axis[1] * sign, axis[2] * sign, axis[3] * sign }
					local reach = r * (0.75 + 0.35 * pebbleRandom())
					stone = carve(stone, d, d[1] * centre[1] + d[2] * centre[2] + d[3] * centre[3] + reach)
				end
			end
			-- Chips knock its corners off.
			for _ = 1, 9 do
				local d = unit(pebbleRandom() - 0.5, pebbleRandom() - 0.5, pebbleRandom() - 0.5)
				stone = carve(stone, d, d[1] * centre[1] + d[2] * centre[2] + d[3] * centre[3] + r * (0.65 + 0.25 * pebbleRandom()))
			end
			-- Cut off at the dirt: only what stands out of it is kept, and the
			-- cap the cut leaves lies against the dirt, so it goes too.
			local level = n[1] * p[1] + n[2] * p[2] + n[3] * p[3]
			stone = carve(stone, { -n[1], -n[2], -n[3] }, -level)
			local record = { point = { p[1], p[2], -p[3] }, normal = { n[1], n[2], -n[3] }, height = size * rise, reach = size }
			for cx = -1, 1 do
				for cy = -1, 1 do
					for cz = -1, 1 do
						local key = pebbleCell(p[1] + cx * 2, p[2] + cy * 2, -p[3] + cz * 2)
						pebbleCells[key] = pebbleCells[key] or {}
						table.insert(pebbleCells[key], record)
					end
				end
			end
			for _, piece in stone do
				local onDirt = true
				for _, q in piece do
					onDirt = onDirt and math.abs(n[1] * q[1] + n[2] * q[2] + n[3] * q[3] - level) < 1e-6
				end
				if not onDirt then
					table.insert(pebbles, piece)
				end
			end
		end
	end
end

-- The cracks, drawn over the dirt's coat as tapering brush strokes, one per
-- step of a crack (already flipped).
local crackStrokes = {}
local crackSeed = 3
local function crackRandom(): number
	crackSeed = (crackSeed * 16807) % 2147483647
	return crackSeed / 2147483647
end
-- Whether a point lies inside a convex face, `margin` studs in from its edges.
local function insideFace(face, n, p, margin: number): boolean
	for i, a in face do
		local b = face[i % #face + 1]
		local edge = { b[1] - a[1], b[2] - a[2], b[3] - a[3] }
		local inward = unit(table.unpack(cross(n, edge)))
		if (p[1] - a[1]) * inward[1] + (p[2] - a[2]) * inward[2] + (p[3] - a[3]) * inward[3] < margin then
			return false
		end
	end
	return true
end
-- A direction turned by `angle` about the face's normal.
local function turned(v, n, angle: number)
	local side = cross(n, v)
	local c, s = math.cos(angle), math.sin(angle)
	return { v[1] * c + side[1] * s, v[2] * c + side[2] * s, v[3] * c + side[3] * s }
end
-- A jagged line from `start` heading along `heading` in a face, stopping
-- short of its edges.
local function crackLine(face, n, start, heading, length: number)
	local points = { start }
	local step = length / CRACK_SEGMENTS
	local at, way = start, heading
	for _ = 1, CRACK_SEGMENTS do
		way = turned(way, n, (crackRandom() - 0.5) * 1.1)
		local nextAt = { at[1] + way[1] * step, at[2] + way[2] * step, at[3] + way[3] * step }
		if not insideFace(face, n, nextAt, 0.04 * DETAIL) then
			break
		end
		table.insert(points, nextAt)
		at = nextAt
	end
	return points
end
-- Lays a line down as a crack `width` wide at its start, thinning evenly
-- along its length to nothing at its end.
local function addCrack(points, normal, width: number)
	if #points < 2 then
		return
	end
	local total = 0
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		total += math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2 + (b[3] - a[3]) ^ 2)
	end
	local travelled = 0
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		local length = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2 + (b[3] - a[3]) ^ 2)
		local widthA = width * (1 - travelled / total)
		local widthB = width * (1 - (travelled + length) / total)
		travelled += length
		local start = { a[1], a[2], -a[3] }
		local along = { (b[1] - a[1]) / length, (b[2] - a[2]) / length, -(b[3] - a[3]) / length }
		local facing = { normal[1], normal[2], -normal[3] }
		local function stroke(at, width: number, color)
			table.insert(crackStrokes, { start = at, along = along, normal = facing, length = length, width = width, tail = widthB / widthA, color = color })
		end
		-- The lip sits on the crack's lower side, half a crack's width over.
		local across = cross(facing, along)
		local side = if across[3] > 0 then -1 else 1
		local shift = widthA * 0.5 * side
		stroke({ start[1] + across[1] * shift, start[2] + across[2] * shift, start[3] + across[3] * shift }, widthA * 0.8, CRACK_LIP)
		stroke(start, widthA, CRACK)
		stroke(start, widthA * CRACK_CORE_WIDTH, CRACK_CORE)
	end
end

for _, origin in crackOrigins do
	if crackRandom() >= CRACK_CHANCE then
		continue
	end
	local face, n, at = origin.face, origin.normal, origin.at
	-- Some way across the face, to turn into each crack's heading.
	local first = face[1]
	local outward = unit(first[1] - at[1], first[2] - at[2], first[3] - at[3])
	for _ = 1, 1 + math.floor(crackRandom() * CRACKS) do
		local heading = turned(outward, n, crackRandom() * TAU)
		local start = { at[1] + heading[1] * origin.rim, at[2] + heading[2] * origin.rim, at[3] + heading[3] * origin.rim }
		if not insideFace(face, n, start, 0.04 * DETAIL) then
			continue
		end
		local length = CRACK_LENGTH[1] + (CRACK_LENGTH[2] - CRACK_LENGTH[1]) * crackRandom()
		local width = CRACK_WIDTH[1] + (CRACK_WIDTH[2] - CRACK_WIDTH[1]) * crackRandom()
		local line = crackLine(face, n, start, heading, length)
		addCrack(line, n, width)
		-- A fork off partway along, thinner and shorter.
		if #line >= 3 and crackRandom() < CRACK_BRANCH then
			local from = line[2]
			local share = 1 / (#line - 1)
			local away = unit(line[3][1] - from[1], line[3][2] - from[2], line[3][3] - from[3])
			local fork = turned(away, n, (if crackRandom() < 0.5 then -1 else 1) * (0.5 + 0.4 * crackRandom()))
			addCrack(crackLine(face, n, from, fork, length * 0.5), n, width * (1 - share) * 0.8)
		end
	end
end


-- The stones are grey, splotched like the rest and stained with the dirt
-- they sit in: solid at the dirt line, in blotches higher up.
local paintPebble = rusting(0.1, function(x, y, z)
	local tone, warm = splotchAt(x, y, z)
	local shade = 1 + tone * 1.5
	local r, g, b = PEBBLE[1], PEBBLE[2], PEBBLE[3]
	-- The stone this point is on: the nearest whose dirt line it sits above.
	local height, best = math.huge, math.huge
	for _, record in pebbleCells[pebbleCell(x, y, z)] or {} do
		local q, n = record.point, record.normal
		local dx, dy, dz = x - q[1], y - q[2], z - q[3]
		local distance = dx * dx + dy * dy + dz * dz
		if distance < record.reach * record.reach and distance < best then
			best = distance
			height = (dx * n[1] + dy * n[2] + dz * n[3]) / math.max(record.height, 0.05)
		end
	end
	if height < STONE_BIT_STAIN then
		local f = 2.2 / DETAIL
		local blot = 0.5 + 0.5 * math.noise(x * f, y * f, z * f)
		local stain = math.clamp((blot - height / STONE_BIT_STAIN) / 0.12, 0, 1)
		local dr, dg, db = soil(0.15 * stoneAt(x, y, z))
		r, g, b = r + (dr - r) * stain, g + (dg - g) * stain, b + (db - b) * stain
	end
	return r * shade * (1 + warm), g * shade, b * shade * (1 - warm)
end)

chunkedPart("Columns", nil, STONE, function(mesh)
	for _, piece in visibleRock(false) do
		addFlipped(mesh, piece)
	end
end, false, paintRock, true, EDGE_REACH)

chunkedPart("Dirt", nil, DIRT, function(mesh)
	for _, piece in dirtFaces do
		addFlipped(mesh, piece)
	end
end, nil, paintDirt, true, EDGE_REACH)

chunkedPart("Pebbles", nil, PEBBLE, function(mesh)
	for _, piece in pebbles do
		addFlipped(mesh, piece)
	end
end, false, paintPebble, true, EDGE_REACH)

-- The rim walked in even steps, each point pushed out from the stone by the
-- grass's outset (outer) and a hair's width (inner), with how deep the grass
-- hangs there.
local function grassRim()
	-- The rim the stones are trimmed to, walked clockwise seen from above
	-- in GRASS_STEP strides, so the grass follows it exactly.
	local points = {}
	local steps = math.ceil(TAU * RIM_PUSH * RADIUS * RIM_REACH * (1 + RIM_WOBBLE) / GRASS_STEP)
	for k = 0, steps - 1 do
		local angle = -k / steps * TAU
		local r = rimAt(angle)
		table.insert(points, { r * math.cos(angle), r * math.sin(angle) })
	end
	local count = #points

	-- Blurs a list of numbers round the loop: repeated passes of a 1-2-1
	-- average, each spreading it by half a step squared, until it spreads
	-- `studs`.
	local function blurLoop(values: { number }, studs: number)
		for _ = 1, math.round(2 * (studs / GRASS_STEP) ^ 2) do
			local before = table.clone(values)
			for i = 1, #values do
				values[i] = (before[(i - 2) % #values + 1] + 2 * before[i] + before[i % #values + 1]) / 4
			end
		end
	end
	local raw = table.clone(points)
	for axis = 1, 2 do
		local coordinates = {}
		for i, p in points do
			coordinates[i] = p[axis]
		end
		blurLoop(coordinates, GRASS_CORNER_BLUR)
		for i = 1, count do
			points[i] = table.clone(points[i])
			points[i][axis] = coordinates[i]
		end
	end
	-- Blurring cuts the outside corners in, uncovering the stone there, so
	-- the rim swells back out round each one: by the most it was cut in
	-- anywhere near, blurred so the swell has no edge of its own.
	local cut, outward = {}, {}
	for i, p in points do
		local a, b = points[(i - 2) % count + 1], points[i % count + 1]
		local dx, dy = b[1] - a[1], b[2] - a[2]
		local length = math.max(math.sqrt(dx * dx + dy * dy), 1e-9)
		outward[i] = { -dy / length, dx / length }
		cut[i] = math.max(0, (raw[i][1] - p[1]) * outward[i][1] + (raw[i][2] - p[2]) * outward[i][2])
	end
	local reach = math.ceil(2 * GRASS_CORNER_BLUR / GRASS_STEP)
	local swell = {}
	for i = 1, count do
		local most = 0
		for k = -reach, reach do
			most = math.max(most, cut[(i + k - 1) % count + 1])
		end
		swell[i] = most
	end
	blurLoop(swell, GRASS_CORNER_BLUR)
	for i, p in points do
		p[1] += outward[i][1] * swell[i]
		p[2] += outward[i][2] * swell[i]
	end

	-- The lip wanders between its shallowest and deepest, and drips hang
	-- from it as rounded tongues, each overlapping the next.
	local along, travelled = {}, 0
	for i, p in points do
		along[i] = travelled
		local q = points[i % count + 1]
		travelled += math.sqrt((q[1] - p[1]) ^ 2 + (q[2] - p[2]) ^ 2)
	end
	local function halfWidth(n)
		return (DRIP_WIDTH[1] + (DRIP_WIDTH[2] - DRIP_WIDTH[1]) * hash(n, 21)) / 2
	end
	local drips, at, n = {}, 0, 0
	while at < travelled do
		n += 1
		table.insert(drips, { at, halfWidth(n), DRIP_LENGTH[1] + (DRIP_LENGTH[2] - DRIP_LENGTH[1]) * hash(n, 22) })
		at += (halfWidth(n) + halfWidth(n + 1)) * (1 - DRIP_OVERLAP)
	end

	-- The outline is wound clockwise seen from above, so out is to the left
	-- of each step. A point's way out averages the steps either side of it.
	local rim = {}
	for i, p in points do
		local a, b = points[(i - 2) % count + 1], points[i % count + 1]
		local dx, dy = b[1] - a[1], b[2] - a[2]
		local length = math.max(math.sqrt(dx * dx + dy * dy), 1e-9)
		local ox, oy = -dy / length, dx / length
		local s = along[i]
		local depth = GRASS_LIP[1] + (GRASS_LIP[2] - GRASS_LIP[1]) * (0.5 + 0.5 * math.noise(s * 0.3 / DETAIL, 3.7))
		for _, drip in drips do
			-- The distance round the rim either way, so drips near the
			-- start also reach the end.
			local gap = math.abs(s - drip[1])
			gap = math.min(gap, travelled - gap)
			if gap < drip[2] then
				depth = math.max(depth, GRASS_LIP[1] + drip[3] * math.sqrt(1 - (gap / drip[2]) ^ 2))
			end
		end
		-- The finer octave never lifts the edge above the stone's top.
		depth = math.max(depth + DRIP_DETAIL * math.noise(s * DRIP_DETAIL_FREQUENCY, 8.1), 0.15 * DETAIL)
		table.insert(rim, {
			outer = { p[1] + ox * GRASS_OUTSET, p[2] + oy * GRASS_OUTSET },
			out = { ox, oy },
			inner = { p[1] + ox * 0.02 * DETAIL, p[2] + oy * 0.02 * DETAIL },
			depth = depth,
		})
	end

	local depths = {}
	for i, point in rim do
		depths[i] = point.depth
	end
	blurLoop(depths, GRASS_DEPTH_BLUR)
	for i, point in rim do
		point.depth = depths[i]
	end

	-- Pushed out of a sharp inward notch, the outer line crosses itself; the
	-- loop it makes is cut away at the crossing.
	local function crossing(a, b, c, d)
		local rx, ry, sx, sy = b[1] - a[1], b[2] - a[2], d[1] - c[1], d[2] - c[2]
		local denominator = rx * sy - ry * sx
		if math.abs(denominator) < 1e-12 then
			return nil
		end
		local t = ((c[1] - a[1]) * sy - (c[2] - a[2]) * sx) / denominator
		local u = ((c[1] - a[1]) * ry - (c[2] - a[2]) * rx) / denominator
		if t <= 0 or t >= 1 or u <= 0 or u >= 1 then
			return nil
		end
		return { a[1] + rx * t, a[2] + ry * t }
	end
	local i = 1
	while i < #rim do
		for k = 2, 12 do
			local j = i + k
			if j + 1 > #rim then
				break
			end
			local hit = crossing(rim[i].outer, rim[i + 1].outer, rim[j].outer, rim[j + 1].outer)
			if hit then
				local kept = rim[i]
				for _ = i + 1, j do
					table.remove(rim, i + 1)
				end
				table.insert(rim, i + 1, { outer = hit, out = kept.out, inner = kept.inner, depth = kept.depth })
				break
			end
		end
		i += 1
	end
	return rim
end

-- How deep the deepest drip hangs, for the grass's shading.
local GRASS_DEEPEST = GRASS_LIP[1] + DRIP_LENGTH[2]

-- Grass is dead straw with olive patches, darkening down
-- the hanging edge toward the drip tips, and splotched like the stone.
local paintGrass = rusting(0, function(x, y, z)
	local shade = 1 - DRIP_SHADE * math.clamp(-z / GRASS_DEEPEST, 0, 1)
	local tone, warm = splotchAt(x, y, z)
	-- On a big open island splotches read as hard discs, so grass takes a trace.
	if SOFT_GRASS then
		tone, warm = tone * GRASS_SPLOTCH, warm * GRASS_SPLOTCH
	end
	shade *= 1 + tone
	-- Patch strength from soft noise: 0 outside, 1 well inside a patch
	-- covering `cover` of the grass.
	local function patch(cover: number, seed: number): number
		local u, v = x / GRASS_PATCH_SIZE + seed, y / GRASS_PATCH_SIZE
		local n = 0.5 + math.noise(u, v, seed) + 0.3 * math.noise(u * 3, v * 3, seed + 5)
		return math.clamp((n - (1 - cover)) / (if SOFT_GRASS then 0.4 else 0.12), 0, 1)
	end
	local function toward(r, g, b, c, t)
		return r + (c[1] - r) * t, g + (c[2] - g) * t, b + (c[3] - b) * t
	end
	local r, g, b = toward(GRASS[1], GRASS[2], GRASS[3], GRASS_OLIVE, patch(GRASS_OLIVE_COVER, 11.3))
	-- Broad darker drifts of bare soil, so open ground isn't one even tone.
	if SOFT_GRASS then
		local drift = math.clamp((math.noise(x * 0.018, y * 0.018, 63.1) + 0.35 * math.noise(x * 0.07, y * 0.07, 12.4) - 0.28) / 0.45, 0, 1)
		r, g, b = toward(r, g, b, TRODDEN, drift * 0.42)
	end
	-- The worn apron round what stands on the top.
	local outside = wornDistance(x, y)
	local wobble = 0.4 * APRON_WIDTH * math.noise(x * 0.3, y * 0.3, 71.3)
	local wear = math.clamp(1 - (outside + wobble) / APRON_WIDTH, 0, 1)
	if wear > 0 then
		local patchy = 0.5 + 0.6 * math.noise(x * 0.55, y * 0.55, 93.1)
		local worn = math.clamp((wear - 0.75 * (1 - patchy)) / (if SOFT_GRASS then 0.55 else 0.2), 0, 1)
		if SOFT_GRASS then
			-- Wear gathers in stretches, not as an even ring round everything.
			worn *= math.clamp(0.55 + 1.3 * math.noise(x * 0.09, y * 0.09, 41.7), 0, 1)
		end
		local grit = 0.9 + 0.2 * math.noise(x * 1.7, y * 1.7, 17.9)
		r, g, b = toward(r, g, b, { TRODDEN[1] * grit, TRODDEN[2] * grit, TRODDEN[3] * grit }, worn)
	end
	return r * shade * (1 + warm), g * shade, b * shade * (1 - warm)
end)

chunkedPart("Grass", nil, GRASS, function(mesh)
	local rim = grassRim()
	local count = #rim
	-- Corners of the turf: rings rounding over from its top edge (the first)
	-- down to its hanging edge (the last), rings curling the hanging edge's
	-- bottom under, the inner bottom of the hanging edge, and the inner edge
	-- where it meets the stone's top.
	local rings, curl, innerBottom, innerTop = {}, {}, {}, {}
	for k = 0, GRASS_ROUND_STEPS do
		rings[k], curl[k] = {}, {}
	end
	local outline = {}
	for i, point in rim do
		for k = 0, GRASS_ROUND_STEPS do
			local angle = k / GRASS_ROUND_STEPS * math.pi / 2
			local back = GRASS_ROUND * (1 - math.sin(angle))
			local x, y = point.outer[1] - point.out[1] * back, point.outer[2] - point.out[2] * back
			rings[k][i] = mesh:vertex(x, y, GRASS_HEIGHT - GRASS_ROUND * (1 - math.cos(angle)))
			if k == 0 then
				outline[i] = { x, y }
			end
		end
		for k = 0, GRASS_ROUND_STEPS do
			local angle = k / GRASS_ROUND_STEPS * math.pi / 2
			local back = GRASS_BOTTOM_ROUND * (1 - math.cos(angle))
			local x, y = point.outer[1] - point.out[1] * back, point.outer[2] - point.out[2] * back
			curl[k][i] = mesh:vertex(x, y, -point.depth + GRASS_BOTTOM_ROUND * (1 - math.sin(angle)))
		end
		innerBottom[i] = mesh:vertex(point.inner[1], point.inner[2], -point.depth)
		innerTop[i] = mesh:vertex(point.inner[1], point.inner[2], 0)
	end
	local top, edge = rings[0], rings[GRASS_ROUND_STEPS]
	for i = 1, count do
		local j = i % count + 1
		-- The rounded rim, ring by ring, facing out and up.
		for k = 1, GRASS_ROUND_STEPS do
			local upper, lower = rings[k - 1], rings[k]
			mesh:face({ lower[j], lower[i], upper[i] })
			mesh:face({ lower[j], upper[i], upper[j] })
		end
		-- Outside, facing out.
		local wallBottom, underEdge = curl[0], curl[GRASS_ROUND_STEPS]
		mesh:face({ wallBottom[j], wallBottom[i], edge[i] })
		mesh:face({ wallBottom[j], edge[i], edge[j] })
		-- The curl under, ring by ring, facing out and down.
		for k = 1, GRASS_ROUND_STEPS do
			local upper, lower = curl[k - 1], curl[k]
			mesh:face({ lower[j], lower[i], upper[i] })
			mesh:face({ lower[j], upper[i], upper[j] })
		end
		-- Underside, facing down.
		mesh:face({ underEdge[i], underEdge[j], innerBottom[j] })
		mesh:face({ underEdge[i], innerBottom[j], innerBottom[i] })
		-- Inside, facing the stone.
		mesh:face({ innerBottom[i], innerBottom[j], innerTop[j] })
		mesh:face({ innerBottom[i], innerTop[j], innerTop[i] })
	end
	-- The turf's top, facing up, cut into GRASS_TOP_CELL squares so no
	-- piece spans the island and the chunker can keep each texture small:
	-- the outline clipped to each square in turn, one edge at a time.
	local function clipped(points, axis: number, at: number, below: boolean)
		local kept = {}
		for i, a in points do
			local b = points[i % #points + 1]
			local aIn, bIn = (a[axis] <= at) == below, (b[axis] <= at) == below
			if aIn then
				table.insert(kept, a)
			end
			if aIn ~= bIn then
				local t = (at - a[axis]) / (b[axis] - a[axis])
				table.insert(kept, { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t })
			end
		end
		return kept
	end
	-- Outline corners keep their ring vertex, so the top meets the rounded
	-- edge without a seam.
	local cornerOf = {}
	for i, p in outline do
		cornerOf[p] = top[i]
	end
	local low, high = { math.huge, math.huge }, { -math.huge, -math.huge }
	for _, p in outline do
		for axis = 1, 2 do
			low[axis], high[axis] = math.min(low[axis], p[axis]), math.max(high[axis], p[axis])
		end
	end
	-- A piece is buried when every corner of it lies deep in the worn ground.
	local function buried(piece): boolean
		for _, p in piece do
			if wornDistance(p[1], p[2]) > -COVER_INSET then
				return false
			end
		end
		return true
	end
	for cx = math.floor(low[1] / GRASS_TOP_CELL), math.floor(high[1] / GRASS_TOP_CELL) do
		for cy = math.floor(low[2] / GRASS_TOP_CELL), math.floor(high[2] / GRASS_TOP_CELL) do
			local piece = clipped(outline, 1, cx * GRASS_TOP_CELL, false)
			piece = clipped(piece, 1, (cx + 1) * GRASS_TOP_CELL, true)
			piece = clipped(piece, 2, cy * GRASS_TOP_CELL, false)
			piece = clipped(piece, 2, (cy + 1) * GRASS_TOP_CELL, true)
			if #piece >= 3 and not buried(piece) then
				local corners = {}
				for i, p in piece do
					corners[i] = cornerOf[p] or mesh:vertex(p[1], p[2], GRASS_HEIGHT)
				end
				for _, t in earClip(piece) do
					mesh:face({ corners[t[3]], corners[t[2]], corners[t[1]] })
				end
			end
		end
	end
end, nil, paintGrass, true, EDGE_REACH)

-- The chunks are shaded here rather than by finishParts, which has no corner
-- taper: highlights run full width at a corner and thin toward the middle of
-- an edge, as finishParts would otherwise shade them. Chunks of the island
-- count as one surface, so their seams shade like any other edge.
local chunks = {}
for _, entry in parts do
	table.insert(chunks, entry.mesh)
end
for _, entry in parts do
	local group = {}
	for _, other in parts do
		if other ~= entry then
			table.insert(group, other.mesh)
		end
	end
	local kind = string.match(entry.name, "^%a+")
	local soft = kind == "Grass" or kind == "Dirt"
	entry.mesh:paintShading(entry.image, {
		highlight = if soft then EDGE_HIGHLIGHT * SOFT_SHADING else EDGE_HIGHLIGHT,
		shadow = if soft then CONTACT_SHADOW * SOFT_SHADING else CONTACT_SHADOW,
		gradient = GRADIENT,
		blend = EDGE_BLEND,
		group = group,
		name = entry.name,
		paint = entry.paint,
		-- The rock paint is cached under the item's key, since its code is not hashed.
		custom = entry.custom,
		salt = CACHE_KEY,
		rust = entry.rust * WEAR,
		reach = EDGE_REACH,
		highlightWidth = HIGHLIGHT_WIDTH,
		cornerTaper = CORNER_TAPER,
		heightRange = entry.heightRange,
		strokes = if string.sub(entry.name, 1, 4) == "Dirt" then crackStrokes else nil,
	})
	model.part(entry.name, entry.mesh, entry.image, { preview = true })
end
end
buildKeys[buildMainIsland] = "MainIsland-5bd6e7b05fafabe5"
function buildCapsuleLoop()
local CACHE_KEY = "CapsuleLoop-2eff1653a67db3ac"
-- Rarity accents, in sRGB: grey common, green uncommon, blue rare, gold
-- legendary.
local COMMON = { 0.62, 0.62, 0.6 }
local UNCOMMON = { 0.3, 0.72, 0.3 }
local RARE = { 0.25, 0.5, 0.95 }
local LEGENDARY = { 1.0, 0.72, 0.18 }
local STEEL = { 0.62, 0.64, 0.66 }
local DARK_STEEL = { 0.3, 0.3, 0.32 }
local COPPER = { 0.85, 0.5, 0.25 }
local TAU = 2 * math.pi

-- Edge highlight and feathering, matching the salvage machine.
local EDGE_HIGHLIGHT = 0.6
local CONTACT_SHADOW = 0.425
-- Scales every part's wear (rust, grime, scratches): 57% of what each part asks for.
local WEAR = 0.57
local GRADIENT = 0.5
local EDGE_BLEND = 0.7
local SMOOTH_ANGLE = 30
local TEXTURE = 256

-- Faces are split into a grid about every 0.4 studs so the warp in
-- `part` can bend and dent flat panels.
local GRID = 0.4

-- When set, every part sizes its texture to this many pixels per stud
-- instead of the fixed TEXTURE, so a layout reads at one texel density.
-- A part's own `texture` size still wins.
local texelDensity: number? = nil
-- The density the layout asked for, before TEXEL_SCALE: chunk sizes follow
-- this one, so a max-detail preview keeps the chunks it would ship with.
local layoutDensity: number? = nil

-- Previews build at a fraction of the density the layout asks for (TEXEL_SCALE).
local function useTexelDensity(pixelsPerStud: number)
	layoutDensity = pixelsPerStud
	texelDensity = pixelsPerStud * (TEXEL_SCALE or 1)
end

local function gridFace(mesh, origin, u, v, nu, nv)
	local rows = {}
	for j = 0, nv do
		rows[j] = {}
		for i = 0, nu do
			local a, b = i / nu, j / nv
			rows[j][i] = mesh:vertex(
				origin[1] + u[1] * a + v[1] * b,
				origin[2] + u[2] * a + v[2] * b,
				origin[3] + u[3] * a + v[3] * b
			)
		end
	end
	for j = 0, nv - 1 do
		for i = 0, nu - 1 do
			mesh:face({ rows[j][i], rows[j][i + 1], rows[j + 1][i + 1], rows[j + 1][i] })
		end
	end
end

local function box(mesh, cx, cy, cz, sx, sy, sz)
	local x0, y0, z0 = cx - sx / 2, cy - sy / 2, cz
	local nx = math.clamp(math.ceil(sx / GRID), 1, 8)
	local ny = math.clamp(math.ceil(sy / GRID), 1, 8)
	local nz = math.clamp(math.ceil(sz / GRID), 1, 8)
	gridFace(mesh, { x0, y0, z0 }, { 0, sy, 0 }, { sx, 0, 0 }, ny, nx)
	gridFace(mesh, { x0, y0, z0 + sz }, { sx, 0, 0 }, { 0, sy, 0 }, nx, ny)
	gridFace(mesh, { x0, y0, z0 }, { sx, 0, 0 }, { 0, 0, sz }, nx, nz)
	gridFace(mesh, { x0, y0 + sy, z0 }, { 0, 0, sz }, { sx, 0, 0 }, nz, nx)
	gridFace(mesh, { x0, y0, z0 }, { 0, 0, sz }, { 0, sy, 0 }, nz, ny)
	gridFace(mesh, { x0 + sx, y0, z0 }, { 0, sy, 0 }, { 0, 0, sz }, ny, nz)
end

-- Cylinder centered at (cx, cy, cz) along axis "x", "y" or "z".
local function cylinder(mesh, cx, cy, cz, radius, length, axis, sides)
	sides = sides or 16
	local a, b = {}, {}
	for i = 0, sides - 1 do
		local t = i / sides * TAU
		local u, w = math.cos(t) * radius, math.sin(t) * radius
		local h = length / 2
		if axis == "x" then
			a[i + 1] = mesh:vertex(cx - h, cy + u, cz + w)
			b[i + 1] = mesh:vertex(cx + h, cy + u, cz + w)
		elseif axis == "y" then
			a[i + 1] = mesh:vertex(cx + w, cy - h, cz + u)
			b[i + 1] = mesh:vertex(cx + w, cy + h, cz + u)
		else
			a[i + 1] = mesh:vertex(cx + u, cy + w, cz - h)
			b[i + 1] = mesh:vertex(cx + u, cy + w, cz + h)
		end
	end
	for i = 1, sides do
		local j = i % sides + 1
		mesh:face({ a[i], a[j], b[j], b[i] })
	end
	local capA = {}
	for i = sides, 1, -1 do
		table.insert(capA, a[i])
	end
	mesh:face(capA)
	mesh:face(b)
end

-- UV sphere, squashed per axis by (rx, ry, rz).
local function sphere(mesh, cx, cy, cz, rx, ry, rz, rings, sides)
	rings, sides = rings or 8, sides or 16
	local grid = {}
	for r = 0, rings do
		local phi = r / rings * math.pi
		grid[r] = {}
		for s = 0, sides - 1 do
			local t = s / sides * TAU
			local x = math.sin(phi) * math.cos(t)
			local y = math.sin(phi) * math.sin(t)
			grid[r][s] = mesh:vertex(cx + x * rx, cy + y * ry, cz - math.cos(phi) * rz)
		end
	end
	for r = 0, rings - 1 do
		for s = 0, sides - 1 do
			local n = (s + 1) % sides
			mesh:face({ grid[r][s], grid[r][n], grid[r + 1][n], grid[r + 1][s] })
		end
	end
end

-- Flat ring (washer) facing along axis "x", "y" or "z": a rim round an eye,
-- a hub, a hose clamp.
local function ring(mesh, cx, cy, cz, inner, outer, depth, axis, sides)
	sides = sides or 16
	local function at(r, t, d)
		local u, w = math.cos(t) * r, math.sin(t) * r
		if axis == "x" then
			return mesh:vertex(cx + d, cy + u, cz + w)
		elseif axis == "y" then
			return mesh:vertex(cx + w, cy + d, cz + u)
		end
		return mesh:vertex(cx + u, cy + w, cz + d)
	end
	local rows = {}
	for i = 0, sides - 1 do
		local t = i / sides * TAU
		rows[i + 1] = { at(outer, t, -depth / 2), at(outer, t, depth / 2), at(inner, t, depth / 2), at(inner, t, -depth / 2) }
	end
	for i = 1, sides do
		local a, b = rows[i], rows[i % sides + 1]
		for k = 1, 4 do
			local l = k % 4 + 1
			mesh:face({ a[k], b[k], b[l], a[l] })
		end
	end
end

-- Bolt head: a squat hexagonal stud on a face pointing along axis.
local function bolt(mesh, cx, cy, cz, axis, size)
	size = size or 0.05
	cylinder(mesh, cx, cy, cz, size, size * 0.7, axis, 6)
end

-- Square beam from one point to another, for limbs and antennae.
local function strut(mesh, x0, y0, z0, x1, y1, z1, thick)
	local dx, dy, dz = x1 - x0, y1 - y0, z1 - z0
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	dx, dy, dz = dx / len, dy / len, dz / len
	local ax, ay, az = -dy, dx, 0
	if math.abs(dz) > 0.99 then
		ax, ay, az = 1, 0, 0
	end
	local al = math.sqrt(ax * ax + ay * ay + az * az)
	ax, ay, az = ax / al * thick / 2, ay / al * thick / 2, az / al * thick / 2
	local bx, by, bz = dy * az - dz * ay, dz * ax - dx * az, dx * ay - dy * ax
	local v = {}
	for i = 0, 7 do
		local sa = if i % 2 == 0 then -1 else 1
		local sb = if i // 2 % 2 == 0 then -1 else 1
		local x, y, z = if i // 4 == 0 then x0 else x1, if i // 4 == 0 then y0 else y1, if i // 4 == 0 then z0 else z1
		v[i + 1] = mesh:vertex(x + ax * sa + bx * sb, y + ay * sa + by * sb, z + az * sa + bz * sb)
	end
	for _, f in { { 1, 3, 4, 2 }, { 5, 6, 8, 7 }, { 1, 2, 6, 5 }, { 3, 7, 8, 4 }, { 1, 5, 7, 3 }, { 2, 4, 8, 6 } } do
		mesh:face({ v[f[1]], v[f[2]], v[f[3]], v[f[4]] })
	end
end

-- Points along a circular arc in the x-z plane, from angle a0 to a1 in
-- degrees. Feeds plate outlines; run the angles downward for a clockwise path.
local function arc(cx, cz, radius, a0, a1, steps)
	local points = {}
	for i = 0, steps do
		local a = math.rad(a0 + (a1 - a0) * i / steps)
		table.insert(points, { cx + math.cos(a) * radius, cz + math.sin(a) * radius })
	end
	return points
end

-- Splits a clockwise x-z outline into triangles by ear clipping, so concave
-- silhouettes cap cleanly. Returns index triples into the outline.
local function earClip(outline)
	local left, tris = {}, {}
	for i = 1, #outline do
		left[i] = i
	end
	local function cross(a, b, c)
		return (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
	end
	local guard = 0
	while #left > 3 and guard < 10000 do
		guard += 1
		local clipped = false
		for k = 1, #left do
			local i0, i1, i2 = left[(k - 2) % #left + 1], left[k], left[k % #left + 1]
			local a, b, c = outline[i0], outline[i1], outline[i2]
			if cross(a, b, c) < 0 then
				local inside = false
				for _, j in left do
					if j ~= i0 and j ~= i1 and j ~= i2 then
						local p = outline[j]
						if cross(a, b, p) <= 0 and cross(b, c, p) <= 0 and cross(c, a, p) <= 0 then
							inside = true
							break
						end
					end
				end
				if not inside then
					table.insert(tris, { i0, i1, i2 })
					table.remove(left, k)
					clipped = true
					break
				end
			end
		end
		if not clipped then
			break
		end
	end
	if #left == 3 then
		table.insert(tris, { left[1], left[2], left[3] })
	end
	return tris
end

-- Flat cut-out plate: a clockwise x-z outline extruded `depth` along y,
-- centred on y, with both faces chamfered inward by `bevel`. Use it for any
-- silhouette (signs, blades, brackets) instead of stacking boxes.
local function plate(mesh, outline, y, depth, bevel)
	local n = #outline
	local inset = {}
	for i = 1, n do
		local p0, p1, p2 = outline[(i - 2) % n + 1], outline[i], outline[i % n + 1]
		local function inward(a, b)
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local len = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
			return dz / len, -dx / len
		end
		local n1x, n1z = inward(p0, p1)
		local n2x, n2z = inward(p1, p2)
		local bx, bz = n1x + n2x, n1z + n2z
		local bl = math.max(math.sqrt(bx * bx + bz * bz), 1e-6)
		bx, bz = bx / bl, bz / bl
		local scale = math.min(1 / math.max(bx * n1x + bz * n1z, 0.34), 3) * bevel
		inset[i] = { p1[1] + bx * scale, p1[2] + bz * scale }
	end
	local h = depth / 2
	local layers = {
		{ inset, y - h },
		{ outline, y - h + bevel },
		{ outline, y + h - bevel },
		{ inset, y + h },
	}
	local rows = {}
	for l, layer in layers do
		rows[l] = {}
		for i = 1, n do
			rows[l][i] = mesh:vertex(layer[1][i][1], layer[2], layer[1][i][2])
		end
	end
	for l = 1, 3 do
		for i = 1, n do
			local j = i % n + 1
			mesh:face({ rows[l][i], rows[l][j], rows[l + 1][j], rows[l + 1][i] })
		end
	end
	for _, t in earClip(inset) do
		mesh:face({ rows[1][t[3]], rows[1][t[2]], rows[1][t[1]] })
		mesh:face({ rows[4][t[1]], rows[4][t[2]], rows[4][t[3]] })
	end
end

-- Unit tangent along (tx, ty, tz) plus two unit axes across it, right-handed,
-- the first level with the ground unless the tangent runs nearly vertical.
local function crossFrame(tx, ty, tz)
	local tl = math.sqrt(tx * tx + ty * ty + tz * tz)
	tx, ty, tz = tx / tl, ty / tl, tz / tl
	local ux, uy, uz = -ty, tx, 0
	if math.abs(tz) > 0.9 then
		ux, uy, uz = 0, tz, -ty
	end
	local ul = math.sqrt(ux * ux + uy * uy + uz * uz)
	ux, uy, uz = ux / ul, uy / ul, uz / ul
	return tx, ty, tz, ux, uy, uz, ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
end

-- Round tube through `points` ({x, y, z} each), capped at both ends: rope
-- strands, and bolts on curved faces.
local function tube(mesh, points, radius, sides)
	sides = sides or 8
	local function unit(a, b)
		local x, y, z = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local length = math.sqrt(x * x + y * y + z * z)
		if length < 1e-6 then
			return nil
		end
		return { x / length, y / length, z / length }
	end
	local rings = {}
	local carried
	for i, p in points do
		local before, after = points[math.max(i - 1, 1)], points[math.min(i + 1, #points)]
		local into, out = i > 1 and unit(before, p) or nil, i < #points and unit(p, after) or nil
		-- Each ring lies across the bisector of its bend.
		local dx, dy, dz = after[1] - before[1], after[2] - before[2], after[3] - before[3]
		if into and out then
			local x, y, z = into[1] + out[1], into[2] + out[2], into[3] + out[3]
			if x * x + y * y + z * z > 1e-6 then
				dx, dy, dz = x, y, z
			end
		end
		local tx, ty, tz, ux, uy, uz, vx, vy, vz = crossFrame(dx, dy, dz)
		-- Carry the last ring's frame round the bend, so the tube can't twist.
		if carried then
			local along = carried[1] * tx + carried[2] * ty + carried[3] * tz
			local x, y, z = carried[1] - tx * along, carried[2] - ty * along, carried[3] - tz * along
			local length = math.sqrt(x * x + y * y + z * z)
			if length > 1e-6 then
				ux, uy, uz = x / length, y / length, z / length
				vx, vy, vz = ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
			end
		end
		carried = { ux, uy, uz }
		-- A ring across a bend is widened toward the bend's outside, or the tube
		-- would pinch there.
		local stretch, bx, by, bz = 1, 0, 0, 0
		if into and out then
			local x, y, z = out[1] - into[1], out[2] - into[2], out[3] - into[3]
			local length = math.sqrt(x * x + y * y + z * z)
			if length > 1e-6 then
				bx, by, bz = x / length, y / length, z / length
				stretch = 1 / math.max(tx * out[1] + ty * out[2] + tz * out[3], 0.5)
			end
		end
		local ring = {}
		for k = 0, sides - 1 do
			local t = k / sides * TAU
			local c, n = math.cos(t) * radius, math.sin(t) * radius
			local x, y, z = ux * c + vx * n, uy * c + vy * n, uz * c + vz * n
			local extra = (x * bx + y * by + z * bz) * (stretch - 1)
			ring[k + 1] = mesh:vertex(p[1] + x + bx * extra, p[2] + y + by * extra, p[3] + z + bz * extra)
		end
		rings[i] = ring
	end
	for i = 1, #rings - 1 do
		local a, b = rings[i], rings[i + 1]
		for k = 1, sides do
			local n = k % sides + 1
			mesh:face({ a[k], a[n], b[n], b[k] })
		end
	end
	local cap = {}
	for k = sides, 1, -1 do
		table.insert(cap, rings[1][k])
	end
	mesh:face(cap)
	mesh:face(rings[#rings])
end

-- `points` with each inner corner replaced by a curve starting up to `reach`
-- studs before it, for wires and hoses that shouldn't have sharp elbows.
local function roundedPath(points, reach, steps)
	steps = steps or 4
	local path = { points[1] }
	for i = 2, #points - 1 do
		local a, p, b = points[i - 1], points[i], points[i + 1]
		local function towards(q)
			local x, y, z = q[1] - p[1], q[2] - p[2], q[3] - p[3]
			local length = math.sqrt(x * x + y * y + z * z)
			local r = math.min(reach, length / 2) / length
			return { p[1] + x * r, p[2] + y * r, p[3] + z * r }
		end
		local first, last = towards(a), towards(b)
		for s = 0, steps do
			local t = s / steps
			local m0, m1, m2 = (1 - t) ^ 2, 2 * t * (1 - t), t * t
			table.insert(path, {
				first[1] * m0 + p[1] * m1 + last[1] * m2,
				first[2] * m0 + p[2] * m1 + last[2] * m2,
				first[3] * m0 + p[3] * m1 + last[3] * m2,
			})
		end
	end
	table.insert(path, points[#points])
	return path
end

-- Point in the plane across `axis` at centre (cx, cy, cz): radius r, angle t,
-- offset d along the axis.
local function onAxis(cx, cy, cz, axis, r, t, d)
	local u, w = math.cos(t) * r, math.sin(t) * r
	if axis == "x" then
		return cx + d, cy + u, cz + w
	elseif axis == "y" then
		return cx + w, cy + d, cz + u
	end
	return cx + u, cy + w, cz + d
end

-- Spur gear turning about `axis`, with square teeth and a hole for its shaft.
local function gear(mesh, cx, cy, cz, radius, thick, teeth, axis)
	local steps = teeth * 4
	local rows = {}
	for i = 0, steps - 1 do
		local t = i / steps * TAU
		-- Two samples up on the tooth, two down in the gap.
		local r = if i % 4 < 2 then radius else radius * 0.82
		local hole = radius * 0.25
		rows[i + 1] = {
			mesh:vertex(onAxis(cx, cy, cz, axis, r, t, -thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, r, t, thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, hole, t, thick / 2)),
			mesh:vertex(onAxis(cx, cy, cz, axis, hole, t, -thick / 2)),
		}
	end
	for i = 1, steps do
		local a, b = rows[i], rows[i % steps + 1]
		for k = 1, 4 do
			local l = k % 4 + 1
			mesh:face({ a[k], b[k], b[l], a[l] })
		end
	end
	-- Shaft through the middle.
	cylinder(mesh, cx, cy, cz, radius * 0.25, thick * 1.8, axis, 8)
end

-- Drive belt wrapped round two pulleys turning about `axis`, the first at
-- (ax, ay, az) with radius ra, the second at (bx, by, bz) with radius rb.
local function belt(mesh, axis, ax, ay, az, ra, bx, by, bz, rb, thick)
	thick = thick or 0.025
	-- Work in the plane across the axis as (u, w), matching onAxis.
	local function flat(x, y, z)
		if axis == "x" then
			return y, z
		elseif axis == "y" then
			return z, x
		end
		return x, y
	end
	local au, aw = flat(ax, ay, az)
	local bu, bw = flat(bx, by, bz)
	local heading = math.atan2(bw - aw, bu - au)
	local points = {}
	-- Round the far side of b, then back round the far side of a.
	for i = 0, 8 do
		local t = heading - math.pi / 2 + i / 8 * math.pi
		local x, y, z = onAxis(bx, by, bz, axis, rb + thick, t, 0)
		table.insert(points, { x, y, z })
	end
	for i = 0, 8 do
		local t = heading + math.pi / 2 + i / 8 * math.pi
		local x, y, z = onAxis(ax, ay, az, axis, ra + thick, t, 0)
		table.insert(points, { x, y, z })
	end
	table.insert(points, points[1])
	tube(mesh, points, thick, 4)
end

-- Exhaust pipe along `points`, ending in a flared, soot-black lip.
local function exhaust(mesh, points, radius)
	tube(mesh, points, radius, 10)
	local a, b = points[#points - 1], points[#points]
	local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local length = math.sqrt(dx * dx + dy * dy + dz * dz)
	dx, dy, dz = dx / length, dy / length, dz / length
	tube(mesh, {
		{ b[1] - dx * 0.06, b[2] - dy * 0.06, b[3] - dz * 0.06 },
		{ b[1], b[2], b[3] },
	}, radius * 1.3, 10)
end

-- Little engine block: a box crankcase with a finned cylinder on top.
local function engine(mesh, cx, cy, cz, size)
	box(mesh, cx, cy, cz, size * 1.4, size, size * 0.7)
	local top = cz + size * 0.7
	cylinder(mesh, cx, cy, top + size * 0.35, size * 0.3, size * 0.7, "z", 12)
	for i = 0, 3 do
		ring(mesh, cx, cy, top + size * (0.1 + i * 0.17), size * 0.28, size * 0.45, size * 0.05, "z", 12)
	end
	box(mesh, cx, cy, top + size * 0.7, size * 0.5, size * 0.5, size * 0.1)
end

-- Bolt head on a curved face, standing out along the normal (nx, ny, nz).
local function stud(mesh, x, y, z, nx, ny, nz, size)
	size = size or 0.04
	local a, b = -size * 0.2, size * 0.5
	tube(mesh, { { x + nx * a, y + ny * a, z + nz * a }, { x + nx * b, y + ny * b, z + nz * b } }, size, 6)
end

-- Rope along `points`: two strands twisted round each other.
local function rope(mesh, points, radius)
	-- Resample the path finely enough for the twist to turn smoothly.
	local path = {}
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local steps = math.max(1, math.ceil(math.sqrt(dx * dx + dy * dy + dz * dz) / (radius * 0.8)))
		for k = 0, steps - 1 do
			table.insert(path, { a[1] + dx * k / steps, a[2] + dy * k / steps, a[3] + dz * k / steps })
		end
	end
	table.insert(path, points[#points])
	for strand = 0, 1 do
		local twisted = {}
		for i, p in path do
			local a, b = path[math.max(i - 1, 1)], path[math.min(i + 1, #path)]
			local _, _, _, ux, uy, uz, vx, vy, vz = crossFrame(b[1] - a[1], b[2] - a[2], b[3] - a[3])
			local t = i * 0.7 + strand * math.pi
			local c, n = math.cos(t) * radius * 0.45, math.sin(t) * radius * 0.45
			twisted[i] = { p[1] + ux * c + vx * n, p[2] + uy * c + vy * n, p[3] + uz * c + vz * n }
		end
		tube(mesh, twisted, radius * 0.6, 6)
	end
end

-- Rope lashed round a box at height z, its corners at x = +-halfX and
-- y from y0 to y1, rounded so it sits snug round each corner.
local function lashing(mesh, halfX, y0, y1, z, radius)
	local bend = radius * 3
	-- Corner centres counter-clockwise from (+X, y0), each with its start angle.
	local corners = {
		{ halfX - bend, y0 + bend, -math.pi / 2 },
		{ halfX - bend, y1 - bend, 0 },
		{ -halfX + bend, y1 - bend, math.pi / 2 },
		{ -halfX + bend, y0 + bend, math.pi },
	}
	local points = {}
	for _, c in corners do
		for k = 0, 3 do
			local t = c[3] + k / 3 * math.pi / 2
			table.insert(points, { c[1] + math.cos(t) * bend, c[2] + math.sin(t) * bend, z })
		end
	end
	table.insert(points, points[1])
	rope(mesh, points, radius)
end

-- Flat sheet lying on the face of a box at `axis` = `at`, its outer side toward
-- `sign`, covering a0..a1 along the other level axis and z0..z1 up, bolted at
-- each corner.
local function sheet(mesh, axis, at, sign, a0, a1, z0, z1, thick, boltSize)
	thick, boltSize = thick or 0.03, boltSize or 0.035
	local c = at + sign * thick / 2
	if axis == "x" then
		box(mesh, c, (a0 + a1) / 2, z0, thick, a1 - a0, z1 - z0)
	else
		box(mesh, (a0 + a1) / 2, c, z0, a1 - a0, thick, z1 - z0)
	end
	local inset = boltSize * 2
	for _, a in { a0 + inset, a1 - inset } do
		for _, z in { z0 + inset, z1 - inset } do
			if axis == "x" then
				bolt(mesh, at + sign * thick, a, z, "x", boltSize)
			else
				bolt(mesh, a, at + sign * thick, z, "y", boltSize)
			end
		end
	end
end

-- Angle bracket bent round the vertical box corner at (x, y), outer faces
-- toward sx and sy, legs `size` long, bolted through each leg.
local function cornerBracket(mesh, x, y, sx, sy, z, height, size)
	local t = 0.025
	box(mesh, x + sx * t / 2, y - sy * (size - t) / 2, z, t, size + t, height)
	box(mesh, x - sx * (size - t) / 2, y + sy * t / 2, z, size + t, t, height)
	for _, dz in { 0.25, 0.75 } do
		bolt(mesh, x + sx * t, y - sy * size * 0.6, z + height * dz, "x", 0.03)
		bolt(mesh, x - sx * size * 0.6, y + sy * t, z + height * dz, "y", 0.03)
	end
end

-- Weathering colors, in sRGB. The bake paints the wear itself, stroke by
-- stroke: rust patches, drips, grime and scratches on metal, dust and scuffs
-- on rubber. These are for parts made of the stuff.
local RUST_DARK = { 0.3, 0.2, 0.12 }
local RUST_ORANGE = { 0.62, 0.36, 0.15 }
local RUST_FLAKE = { 0.78, 0.52, 0.3 }
local BARE_METAL = { 0.74, 0.73, 0.7 }

-- How rusty a part painted by its own paint fn is; `rusting` sets it.
local paintRust = setmetatable({}, { __mode = "k" })

-- Marks a paint fn as `rust` worn (0 clean, 1 eaten through), for parts
-- whose coat has its own look but should still rust.
local function rusting(rust, paint)
	paintRust[paint] = rust
	return paint
end

local RUBBER = -1
local DUST = { 0.55, 0.5, 0.42 }
-- Bindings, painted as RUBBER: duct tape and hemp rope.
local TAPE = { 0.58, 0.58, 0.56 }
local RUBBER_BLACK = { 0.12, 0.12, 0.13 }
local ROPE = { 0.62, 0.5, 0.32 }

-- Part following one bone. `smooth` overrides the auto-smooth angle (true
-- for fully round parts like the zapper's body). `rust` sets how worn it
-- is, default 0.4; 0 for glowing eyes and visors; RUBBER for tyres and treads.
local WARP = 0.0385

-- Low-frequency warp so no panel is perfectly flat or square: a smooth sum
-- of sines seeded by the part name, plus a couple of dents.
local function imperfect(mesh, name)
	local seed = 0
	for i = 1, #name do
		seed = (seed * 31 + string.byte(name, i)) % 9973
	end
	local function n(k)
		return math.sin(seed * 12.9898 + k * 78.233) * 0.5 + 0.5
	end
	local function noise(x, y, z, k)
		return math.sin(x * (1.7 + n(k)) + y * 0.9 + n(k + 1) * TAU) * 0.5
			+ math.sin(y * (2.3 + n(k + 2)) - z * 1.3 + n(k + 3) * TAU) * 0.3
			+ math.sin(z * (2.9 + n(k + 4)) + x * 1.1 + n(k + 5) * TAU) * 0.2
	end
	local dents = {}
	for d = 1, 2 do
		local k = d * 10
		dents[d] = { (n(k) - 0.5) * 3, (n(k + 1) - 0.5) * 3, n(k + 2) * 4, 0.3 + n(k + 3) * 0.4 }
	end
	return setmetatable({
		vertex = function(_, x, y, z)
			local dx, dy, dz = noise(x, y, z, 1), noise(y, z, x, 7), noise(z, x, y, 13)
			for _, dent in dents do
				local ox, oy, oz = x - dent[1], y - dent[2], z - dent[3]
				local fall = math.exp(-(ox * ox + oy * oy + oz * oz) / (dent[4] * dent[4]))
				dx -= ox * fall * 0.6
				dy -= oy * fall * 0.6
				dz -= oz * fall * 0.6
			end
			return mesh:vertex(x + dx * WARP, y + dy * WARP, z + dz * WARP)
		end,
	}, {
		__index = function(_, key)
			return function(_, ...)
				return mesh[key](mesh, ...)
			end
		end,
	})
end

local parts = {}

-- What the bake paints on a part: `paint` gives its coat colors, `rust` how
-- worn it is, and `rubber` that it gathers dust and scuffs instead.
local function setLook(entry, color, rust)
	rust = rust or 0.4
	if type(rust) == "function" then
		entry.paint, entry.rust, entry.custom = rust, paintRust[rust] or 0, true
		return
	end
	entry.paint = function()
		return color[1], color[2], color[3]
	end
	entry.rust = math.max(rust, 0)
	entry.rubber = rust == RUBBER
end

local HAND_EDGE_MOTION = { rock = "feather", wood = "flick", metal = "worn" }

-- `rust` can also be a paint fn for surfaces with their own look.
-- `texture` overrides the texture size for parts that need more detail.
-- `emissive` is a glow strength (like SurfaceAppearance.EmissiveStrength);
-- glowing parts skip painted shading. `flat` skips the warp, for parts so
-- thin it would visibly bend them. `edge` is how far highlights and contact
-- shadows reach from an edge, in studs: bigger surfaces take a wider band.
-- `shade` multiplies the contact shadow strength, for parts that should sit in
-- heavier shadow than the standard wear. `lit` scales the highlight strength
-- and `wide` the width of the highlight brush strokes. Set `painted` on an entry
-- to paint its highlights as bold, fully loaded strokes instead of dry ones,
-- `blend` (0-1) to tint them from cream toward a lighter part colour, and
-- `taper` (studs) to run them full width at corners, thinning along each edge.
-- `softLit` (0-1) adds a wide, very soft highlight under the strokes, fading
-- out over `softEdge` studs from each edge; `softUneven` (0-1) makes its width
-- wander along the edge and `softTaper` (studs) thins it away from corners.
-- `softToZero` lets that thinning reach nothing, and `softPower` steepens the fade.
-- `strokes` lists brush strokes painted over the coat ({start, along, normal,
-- length, width, tail, color, brush}, color in sRGB), such as cracks or dabs;
-- `brush` is "taper" (crisp lines, the default), "round" or "sponge".
-- `stamps` lays the coat with scanned stroke shapes instead of the flat brush.
-- `hand` ("rock", "wood" or "metal") paints the coat the way a hand would, and
-- `handFocus` ({x, y, z, radius}) is where it gathers its finest strokes.
-- `handTune` sets any of its numbers by name (settings! in tools/modelkit/src/hand.rs).
-- `litMotion` draws the hard edge highlight with a moving hand, `litTune` sets its
-- numbers by name (tools/modelkit/src/marks.rs). A hand-painted part gets its
-- material's motion unless it names another, or `false` for the default strokes.
-- `brushes` draws any layer with a motion: edge, shade, soft, coat, grime, rust,
-- drip or scratch, each {motion = "press", tune = {name = value}}. A `strokes`
-- entry takes `motion` and `tune` the same way.
-- With `hand` as well, `crisp` keeps the shapes exact and takes only the brushwork's tone.
-- `crisp` lays the coat on texel by texel in the paint fn's exact colours
-- instead of brush strokes, for machine finishes (hazard tape, ribbed
-- rubber) that strokes would smear; shading still goes over it.
local function part(name, bone, color, build, smooth, rust, texture: number?, emissive: number?, flat: boolean?, edge: number?, shade: number?, lit: number?, wide: number?)
	local mesh = Mesh.new()
	build(if rust == 0 or flat then mesh else imperfect(mesh, name))
	mesh:setSmooth(if smooth ~= nil then smooth else SMOOTH_ANGLE)
	local fit = mesh:unwrap()
	local size = if texture then texture
		elseif texelDensity then math.clamp(math.ceil(texelDensity / fit / 4) * 4, 16, 1024)
		else TEXTURE
	local image = Image.new(size, size, color[1], color[2], color[3])
	local entry = { name = name, bone = bone, mesh = mesh, image = image, emissive = emissive, edge = edge, shade = shade, lit = lit, wide = wide }
	setLook(entry, color, rust)
	-- Glowing parts skip the painted bake, so their colors go on as they are.
	if emissive then
		mesh:paint(image, entry.paint)
	end
	table.insert(parts, entry)
end

-- Large surfaces (terrain, roads, floors) are split into cubes 128 studs
-- across, or 1024 texels at the layout's texel density if that is smaller,
-- each its own part with a texture up to 1024, named <name>_<cx>_<cy>_<cz>. The
-- build runs once into a recorder, then each face goes to the chunk holding
-- its centre. Cells sit on the origin across, and centred on z = 0 up and
-- down, so ground near sea level stays in one layer. `flat` skips the warp,
-- as for part(). Every chunk shades against one height range, the whole
-- mesh's z-range or the `heightRange` {bottom, top} given, so the gradient runs
-- on across chunks instead of restarting in each (a flat chunk would go dark).
local function chunkedPart(name, bone, color, build, smooth, rust, flat: boolean?, edge: number?, shade: number?, lit: number?, heightRange: { number }?)
	local CHUNK = if layoutDensity then math.min(128, 1024 / layoutDensity) else 128
	-- Smallest cell a chunk is halved down to while looking for a split.
	local MIN_CELL = 2
	local positions, faces = {}, {}
	local recorder = {
		vertex = function(_, x, y, z)
			table.insert(positions, { x, y, z })
			return #positions
		end,
		-- A vertex the rust wobble leaves alone, for surfaces that must stay flat.
		exactVertex = function(_, x, y, z)
			table.insert(positions, { x, y, z })
			return #positions
		end,
		face = function(_, verts, uvs)
			table.insert(faces, { verts = verts, uvs = uvs })
		end,
	}
	build(if rust == 0 or flat then recorder else imperfect(recorder, name))
	if not heightRange then
		local bottom, top = math.huge, -math.huge
		for _, p in positions do
			bottom, top = math.min(bottom, p[3]), math.max(top, p[3])
		end
		heightRange = { bottom, top }
	end

	local chunks, order = {}, {}
	for _, f in faces do
		local cx, cy, cz = 0, 0, 0
		for _, v in f.verts do
			local p = positions[v]
			cx, cy, cz = cx + p[1], cy + p[2], cz + p[3]
		end
		local n = #f.verts
		local key = `{math.floor(cx / n / CHUNK)}_{math.floor(cy / n / CHUNK)}_{math.floor(cz / n / CHUNK + 0.5)}`
		if not chunks[key] then
			chunks[key] = {}
			table.insert(order, key)
		end
		table.insert(chunks[key], f)
	end

	-- Each chunk becomes a part. With a texel density set, a chunk whose
	-- texture would need more than 1024 texels to hold it is split into
	-- octants until every piece fits, so the whole surface reads at one density.
	local function chunkMesh(chunkFaces)
		local mesh, remap = Mesh.new(), {}
		for _, f in chunkFaces do
			local verts = {}
			for i, v in f.verts do
				if not remap[v] then
					local p = positions[v]
					remap[v] = mesh:vertex(p[1], p[2], p[3])
				end
				verts[i] = remap[v]
			end
			mesh:face(verts, f.uvs)
		end
		return mesh
	end
	local function emit(label, chunkFaces, size)
		local texture = 1024
		if texelDensity then
			local mesh = chunkMesh(chunkFaces)
			mesh:setSmooth(if smooth ~= nil then smooth else SMOOTH_ANGLE)
			-- Split by the layout's density; the scale only sizes the texture.
			local unwrap = mesh:unwrap()
			local needed = math.ceil((layoutDensity or texelDensity) / unwrap / 4) * 4
			if needed > 1024 and #chunkFaces > 1 then
				local half = size / 2
				local octants, octantOrder = {}, {}
				for _, f in chunkFaces do
					local cx, cy, cz = 0, 0, 0
					for _, v in f.verts do
						local p = positions[v]
						cx, cy, cz = cx + p[1], cy + p[2], cz + p[3]
					end
					local n = #f.verts
					local sub = `{math.floor(cx / n / half) % 2}{math.floor(cy / n / half) % 2}{math.floor(cz / n / half + 0.5) % 2}`
					if not octants[sub] then
						octants[sub] = {}
						table.insert(octantOrder, sub)
					end
					table.insert(octants[sub], f)
				end
				if #octantOrder > 1 then
					for _, sub in octantOrder do
						emit(`{label}_{sub}`, octants[sub], half)
					end
					return
				end
				-- Everything sits in one octant, such as a curved strip whose
				-- unwrap leaves most of the texture empty: halve the cell again
				-- until the faces part.
				if half >= MIN_CELL then
					emit(label, chunkFaces, half)
					return
				end
			end
			texture = math.clamp(math.ceil(texelDensity / unwrap / 4) * 4, 16, 1024)
		end
		part(label, bone, color, function(mesh)
			local handles = {}
			for _, f in chunkFaces do
				local verts = {}
				for i, v in f.verts do
					if not handles[v] then
						local p = positions[v]
						handles[v] = mesh:vertex(p[1], p[2], p[3])
					end
					verts[i] = handles[v]
				end
				mesh:face(verts, f.uvs)
			end
			-- The recorder hands over a triangle soup; weld so the crease angle
			-- can run smooth over a chunk instead of faceting every triangle.
			mesh:weld(1e-4)
		end, smooth, 0, texture, nil, nil, edge, shade, lit)
		-- The warp was applied while recording; the chunk still wears the look.
		setLook(parts[#parts], color, rust)
		-- Chunks of one part share a group, so their edges count as its own.
		parts[#parts].group = name
		parts[#parts].heightRange = heightRange
	end
	for _, key in order do
		emit(`{name}_{key}`, chunks[key], CHUNK)
	end
end

-- Shades every part with all the others as occluders, so parts darken where
-- they touch or tuck under each other, then adds them to the model.
local function finishParts()
	for _, entry in parts do
		if entry.emissive then
			model.part(entry.name, entry.mesh, entry.image, { bone = entry.bone, preview = true, emissive = entry.emissive })
			continue
		end
		local occluders, group = {}, {}
		for _, other in parts do
			if other ~= entry and entry.group and other.group == entry.group then
				table.insert(group, other.mesh)
			elseif other ~= entry then
				table.insert(occluders, other.mesh)
			end
		end
		entry.mesh:paintShading(entry.image, {
			highlight = EDGE_HIGHLIGHT * (entry.lit or 1),
			shadow = CONTACT_SHADOW * (entry.shade or 1),
			gradient = entry.gradient or GRADIENT,
			blend = entry.blend or EDGE_BLEND,
			occluders = occluders,
			group = group,
			name = entry.name,
			paint = entry.paint,
			-- A custom paint fn is cached under the item's key, since its code is not hashed.
			custom = entry.custom,
			salt = if entry.custom then CACHE_KEY else nil,
			rust = entry.rust * WEAR,
			stamps = entry.stamps,
			hand = entry.hand,
			handFocus = entry.handFocus,
			handTune = entry.handTune,
			rubber = entry.rubber,
			rustEdges = entry.rustEdges,
			reach = entry.edge,
			highlightWidth = entry.wide,
			highlightUneven = entry.litUneven,
			highlightUnevenStep = entry.litUnevenStep,
			highlightMotion = if entry.litMotion == nil then (entry.hand and HAND_EDGE_MOTION[entry.hand]) else (entry.litMotion or nil),
			highlightMotionTune = entry.litTune,
			highlightToZero = entry.litToZero,
			highlightEnd = entry.litEnd,
			paintedHighlights = entry.painted,
			cornerTaper = entry.taper,
			softHighlight = entry.softLit,
			softReach = entry.softEdge,
			softUneven = entry.softUneven,
			softTaper = entry.softTaper,
			softToZero = entry.softToZero,
			softPower = entry.softPower,
			softEnd = entry.softEnd,
			strokes = entry.strokes,
			brushes = entry.brushes,
			heightRange = entry.heightRange,
			crisp = entry.crisp,
		})
		model.part(entry.name, entry.mesh, entry.image, { bone = entry.bone, preview = true })
	end
end
-- mates: Stack Roof
-- Capsule Loop: the hub's capsule belt and the little factory it runs
-- through, as one model (art/concepts/capsule-loop-sketch.png), at full size
-- in studs. The origin is the middle of the hub at deck level; the layout
-- puts it on the plaza.
-- The belt is one lap of radius BELT_RADIUS. Capsules ride it counter-
-- clockwise: at +X they go in the shed's -Y mouth to be crushed under the
-- press on its roof, and new ones, dropped in through the hopper, come out
-- of its +Y mouth. A black, unlit shade fills each mouth from the inside,
-- so the shed needs no inside.
-- Each mouth is 7 wide and 6.6 tall: a player (4 by 5.5) has 1.5 spare each
-- side and 1.1 overhead, and a riding capsule (3.4 tall, 0.6 up) 2.6.
-- open: Shades, Tread, BeltRails
-- (The belt parts are split into texture chunks, open where the chunks meet.)
-- Edit Mesh: a mesh that can be edited after it's made, down to every
-- vertex, edge and face, then handed to the engine as one part
-- (`m:emit(mesh)` inside a part's build function). Include it with
-- `-- include: EditMesh`.
--
-- Every vertex, edge and face has an id that never changes and is never
-- reused, so a step can name what an earlier step made. Faces list their
-- vertices counter-clockwise seen from outside (the engine's winding), and
-- the mesh knows which faces share each edge and meet at each vertex, so
-- edge loops and rings can be followed and edits keep the surface closed.
--
-- What to edit is chosen by rule (m:select), not by clicking: faces facing
-- a direction, everything inside a box, an edge loop, a tag a step left.
-- A selection can be moved, turned and scaled, with soft falloff.
-- Operations (extrude, inset, bevel, loop cut, subdivide...) live in
-- shared/EditOps.luau on top of this.
--
-- Positions are z-up studs, as everywhere in the art.

local EditMesh = {}
EditMesh.__index = EditMesh

EditMesh.Selection = {}
EditMesh.Selection.__index = EditMesh.Selection

-- Vectors are plain {x, y, z} tables.
EditMesh.vec = {
	add = function(a, b)
		return { a[1] + b[1], a[2] + b[2], a[3] + b[3] }
	end,
	sub = function(a, b)
		return { a[1] - b[1], a[2] - b[2], a[3] - b[3] }
	end,
	scale = function(a, k)
		return { a[1] * k, a[2] * k, a[3] * k }
	end,
	dot = function(a, b)
		return a[1] * b[1] + a[2] * b[2] + a[3] * b[3]
	end,
	cross = function(a, b)
		return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
	end,
	length = function(a)
		return math.sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3])
	end,
	unit = function(a)
		local length = math.sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3])
		if length < 1e-12 then
			return { 0, 0, 0 }
		end
		return { a[1] / length, a[2] / length, a[3] / length }
	end,
	lerp = function(a, b, t)
		return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
	end,
}

local function edgeKey(a, b)
	if a < b then
		return a .. ":" .. b
	end
	return b .. ":" .. a
end

function EditMesh.new()
	return setmetatable({
		verts = {}, -- id -> { position = {x, y, z}, tags = {} }
		edges = {}, -- id -> { a, b, crease, tags }
		faces = {}, -- id -> { verts = {ids, counter-clockwise}, tags = {} }
		edgeByKey = {}, -- "a:b" -> edge id
		vertFaces = {}, -- vertex id -> { [face id] = true }
		vertEdges = {}, -- vertex id -> { [edge id] = true }
		edgeFaces = {}, -- edge id -> { [face id] = true }
		nextVert = 1,
		nextEdge = 1,
		nextFace = 1,
		-- Tags put on whatever the next steps make (EditMesh:tagging).
		stamp = nil,
	}, EditMesh)
end

-- ---------------------------------------------------------------- building

function EditMesh:addVertex(x, y, z)
	local id = self.nextVert
	self.nextVert += 1
	self.verts[id] = { position = { x, y, z }, tags = {} }
	self.vertFaces[id] = {}
	self.vertEdges[id] = {}
	if self.stamp then
		self.verts[id].tags[self.stamp] = true
	end
	return id
end

local function addEdge(self, a, b)
	local key = edgeKey(a, b)
	local id = self.edgeByKey[key]
	if id then
		return id
	end
	id = self.nextEdge
	self.nextEdge += 1
	self.edges[id] = { a = math.min(a, b), b = math.max(a, b), crease = 0, tags = {} }
	if self.stamp then
		self.edges[id].tags[self.stamp] = true
	end
	self.edgeByKey[key] = id
	self.edgeFaces[id] = {}
	self.vertEdges[a][id] = true
	self.vertEdges[b][id] = true
	return id
end

-- Adds a face over existing vertices, listed counter-clockwise seen from
-- outside. Returns its id.
function EditMesh:addFace(verts, tags)
	assert(#verts >= 3, "EditMesh: a face needs at least three vertices")
	local id = self.nextFace
	self.nextFace += 1
	local face = { verts = table.clone(verts), tags = {} }
	for name in tags or {} do
		face.tags[name] = true
	end
	if self.stamp then
		face.tags[self.stamp] = true
	end
	self.faces[id] = face
	-- Inside m:rebuilding, vertices a removeFace dropped come back first.
	for _, vert in verts do
		if not self.verts[vert] and self.ghosts and self.ghosts[vert] then
			self.verts[vert] = self.ghosts[vert]
			self.vertFaces[vert] = {}
			self.vertEdges[vert] = {}
		end
		assert(self.verts[vert], `EditMesh: face uses missing vertex {vert}`)
	end
	for index, vert in verts do
		self.vertFaces[vert][id] = true
		local nextVert = verts[index % #verts + 1]
		self.edgeFaces[addEdge(self, vert, nextVert)][id] = true
	end
	return id
end

-- Removes a face, and any edge or vertex left belonging to no face.
function EditMesh:removeFace(id)
	local face = self.faces[id]
	if not face then
		return
	end
	self.faces[id] = nil
	for index, vert in face.verts do
		self.vertFaces[vert][id] = nil
		local edge = self.edgeByKey[edgeKey(vert, face.verts[index % #face.verts + 1])]
		if edge then
			self.edgeFaces[edge][id] = nil
			if next(self.edgeFaces[edge]) == nil then
				local e = self.edges[edge]
				self.edges[edge] = nil
				self.edgeFaces[edge] = nil
				self.edgeByKey[edgeKey(e.a, e.b)] = nil
				self.vertEdges[e.a][edge] = nil
				self.vertEdges[e.b][edge] = nil
			end
		end
	end
	for _, vert in face.verts do
		if self.verts[vert] and next(self.vertFaces[vert]) == nil then
			self.verts[vert] = nil
			self.vertFaces[vert] = nil
			self.vertEdges[vert] = nil
		end
	end
end

-- Runs `body` with every vertex position remembered, so faces can be
-- rebuilt over vertices a removeFace would otherwise forget.
function EditMesh:rebuilding(body)
	self.ghosts = {}
	for id, vert in self.verts do
		self.ghosts[id] = vert
	end
	local results = table.pack(body())
	self.ghosts = nil
	return table.unpack(results, 1, results.n)
end

-- Removes a vertex and every face using it.
function EditMesh:removeVertex(id)
	for face in table.clone(self.vertFaces[id] or {}) do
		self:removeFace(face)
	end
end

-- Removes an edge and every face using it.
function EditMesh:removeEdge(id)
	for face in table.clone(self.edgeFaces[id] or {}) do
		self:removeFace(face)
	end
end

-- Puts `tag` on every vertex, edge and face made while `body` runs.
function EditMesh:tagging(tag, body)
	local outer = self.stamp
	self.stamp = tag
	local results = table.pack(body())
	self.stamp = outer
	return table.unpack(results, 1, results.n)
end

-- ---------------------------------------------------------------- reading

function EditMesh:position(id)
	return self.verts[id].position
end

function EditMesh:setPosition(id, x, y, z)
	self.verts[id].position = { x, y, z }
end

function EditMesh:edge(a, b)
	return self.edgeByKey[edgeKey(a, b)]
end

function EditMesh:edgeVerts(id)
	local edge = self.edges[id]
	return edge.a, edge.b
end

local function keys(set)
	local list = {}
	for key in set do
		table.insert(list, key)
	end
	table.sort(list)
	return list
end

function EditMesh:facesOfVertex(id)
	return keys(self.vertFaces[id])
end

function EditMesh:facesOfEdge(id)
	return keys(self.edgeFaces[id])
end

function EditMesh:edgesOfVertex(id)
	return keys(self.vertEdges[id])
end

function EditMesh:neighbours(id)
	local list = {}
	for edge in self.vertEdges[id] do
		local e = self.edges[edge]
		table.insert(list, if e.a == id then e.b else e.a)
	end
	table.sort(list)
	return list
end

function EditMesh:faceNormal(id)
	-- Newell's method, as the engine works it out.
	local verts = self.faces[id].verts
	local n = { 0, 0, 0 }
	for index, vert in verts do
		local p = self.verts[vert].position
		local q = self.verts[verts[index % #verts + 1]].position
		n[1] += (p[2] - q[2]) * (p[3] + q[3])
		n[2] += (p[3] - q[3]) * (p[1] + q[1])
		n[3] += (p[1] - q[1]) * (p[2] + q[2])
	end
	return EditMesh.vec.unit(n)
end

function EditMesh:faceCentre(id)
	local verts = self.faces[id].verts
	local sum = { 0, 0, 0 }
	for _, vert in verts do
		sum = EditMesh.vec.add(sum, self.verts[vert].position)
	end
	return EditMesh.vec.scale(sum, 1 / #verts)
end

function EditMesh:faceArea(id)
	local verts = self.faces[id].verts
	local n = { 0, 0, 0 }
	local first = self.verts[verts[1]].position
	for index = 2, #verts - 1 do
		local a = EditMesh.vec.sub(self.verts[verts[index]].position, first)
		local b = EditMesh.vec.sub(self.verts[verts[index + 1]].position, first)
		n = EditMesh.vec.add(n, EditMesh.vec.cross(a, b))
	end
	return EditMesh.vec.length(n) / 2
end

-- Average of the normals of the faces around a vertex, weighted by area.
function EditMesh:vertexNormal(id)
	local n = { 0, 0, 0 }
	for face in self.vertFaces[id] do
		n = EditMesh.vec.add(n, EditMesh.vec.scale(self:faceNormal(face), self:faceArea(face)))
	end
	return EditMesh.vec.unit(n)
end

function EditMesh:counts()
	local v, e, f = 0, 0, 0
	for _ in self.verts do
		v += 1
	end
	for _ in self.edges do
		e += 1
	end
	for _ in self.faces do
		f += 1
	end
	return v, e, f
end

function EditMesh:bounds()
	local low, high = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
	for _, vert in self.verts do
		for axis = 1, 3 do
			low[axis] = math.min(low[axis], vert.position[axis])
			high[axis] = math.max(high[axis], vert.position[axis])
		end
	end
	return low, high
end

-- ---------------------------------------------------------------- vertex-level edits

-- Puts a new vertex on an edge, `t` of the way from its lower id to its
-- higher, into every face that uses the edge. Returns the new vertex.
function EditMesh:splitEdge(id, t)
	local edge = self.edges[id]
	local a, b = edge.a, edge.b
	local p = EditMesh.vec.lerp(self.verts[a].position, self.verts[b].position, t or 0.5)
	local crease, edgeTags = edge.crease, table.clone(edge.tags)
	local middle = self:addVertex(p[1], p[2], p[3])
	return self:rebuilding(function()
		for _, face in keys(self.edgeFaces[id]) do
			local verts = table.clone(self.faces[face].verts)
			for index, vert in verts do
				local nextVert = verts[index % #verts + 1]
				if (vert == a and nextVert == b) or (vert == b and nextVert == a) then
					table.insert(verts, index + 1, middle)
					break
				end
			end
			self:replaceFace(face, verts)
		end
		for _, half in { self:edge(a, middle), self:edge(middle, b) } do
			if half then
				self.edges[half].crease = crease
				for name in edgeTags do
					self.edges[half].tags[name] = true
				end
			end
		end
		return middle
	end)
end

-- Swaps a face's vertices for `verts`, keeping its id and tags. For edits
-- that change a face in place (splitting an edge, merging vertices).
function EditMesh:replaceFace(id, verts)
	local tags = self.faces[id].tags
	local ghosts = self.ghosts
	if not ghosts then
		return self:rebuilding(function()
			return self:replaceFace(id, verts)
		end)
	end
	self:removeFace(id)
	for _, vert in verts do
		if not self.verts[vert] then
			self.verts[vert] = ghosts[vert]
			self.vertFaces[vert] = {}
			self.vertEdges[vert] = {}
		end
	end
	-- Same id: put the face back where it was.
	local face = { verts = table.clone(verts), tags = tags }
	self.faces[id] = face
	for index, vert in verts do
		self.vertFaces[vert][id] = true
		self.edgeFaces[addEdge(self, vert, verts[index % #verts + 1])][id] = true
	end
	return id
end

-- Merges vertex `b` into `a` (`a` stays, at `position` if given). Faces
-- that collapse below three corners go.
function EditMesh:mergeVertices(a, b, position)
	if position then
		self.verts[a].position = { position[1], position[2], position[3] }
	end
	self:rebuilding(function()
		for _, face in keys(self.vertFaces[b]) do
			local merged = {}
			for _, vert in self.faces[face].verts do
				local use = if vert == b then a else vert
				if merged[#merged] ~= use then
					table.insert(merged, use)
				end
			end
			if #merged > 1 and merged[1] == merged[#merged] then
				table.remove(merged)
			end
			if #merged < 3 then
				self:removeFace(face)
			else
				self:replaceFace(face, merged)
			end
		end
	end)
	if self.verts[b] and next(self.vertFaces[b]) == nil then
		self.verts[b] = nil
		self.vertFaces[b] = nil
		self.vertEdges[b] = nil
	end
	return a
end

-- Collapses an edge to its middle (or `t` along it). Returns the vertex kept.
function EditMesh:collapseEdge(id, t)
	local edge = self.edges[id]
	local p = EditMesh.vec.lerp(self.verts[edge.a].position, self.verts[edge.b].position, t or 0.5)
	return self:mergeVertices(edge.a, edge.b, p)
end

-- Splits a face in two with a new edge between two of its vertices that
-- aren't neighbours. Returns the two faces (the first keeps the old id).
function EditMesh:connect(face, a, b)
	local verts = self.faces[face].verts
	local ia, ib = table.find(verts, a), table.find(verts, b)
	assert(ia and ib, "EditMesh: connect needs two vertices of the face")
	local count = #verts
	assert((ia % count) + 1 ~= ib and (ib % count) + 1 ~= ia, "EditMesh: those vertices already share an edge")
	local first, second = {}, {}
	local index = ia
	while true do
		table.insert(first, verts[index])
		if index == ib then
			break
		end
		index = index % count + 1
	end
	index = ib
	while true do
		table.insert(second, verts[index])
		if index == ia then
			break
		end
		index = index % count + 1
	end
	local tags = table.clone(self.faces[face].tags)
	return self:rebuilding(function()
		self:replaceFace(face, first)
		return face, self:addFace(second, tags)
	end)
end

-- Slides a vertex along one of its edges, `t` of the way to the far end.
function EditMesh:slide(vert, edge, t)
	local e = self.edges[edge]
	local far = if e.a == vert then e.b else e.a
	local p = EditMesh.vec.lerp(self.verts[vert].position, self.verts[far].position, t)
	self.verts[vert].position = p
end

function EditMesh:setCrease(edge, weight)
	self.edges[edge].crease = math.clamp(weight, 0, 1)
end

-- Turns every face over (for a shape built inside out).
function EditMesh:flip(faces)
	self:rebuilding(function()
		for _, face in faces or keys(self.faces) do
			local verts = self.faces[face].verts
			local flipped = {}
			for index = #verts, 1, -1 do
				table.insert(flipped, verts[index])
			end
			self:replaceFace(face, flipped)
		end
	end)
end

-- ---------------------------------------------------------------- selection

-- A set of vertex, edge or face ids from one mesh. Made by m:select; most
-- methods return a selection, so steps chain.
local function selection(mesh, kind, ids)
	return setmetatable({ mesh = mesh, kind = kind, ids = ids }, EditMesh.Selection)
end

local function elements(self, kind)
	if kind == "vertex" then
		return self.verts
	elseif kind == "edge" then
		return self.edges
	end
	return self.faces
end

local function centreOf(self, kind, id)
	if kind == "vertex" then
		return self.verts[id].position
	elseif kind == "edge" then
		local e = self.edges[id]
		return EditMesh.vec.lerp(self.verts[e.a].position, self.verts[e.b].position, 0.5)
	end
	return self:faceCentre(id)
end

-- m:select(kind, rule, ...) with kind "vertex", "edge" or "face", and rule:
--   "all"
--   "ids", { ids }
--   "tag", name                     made inside m:tagging(name, ...)
--   "facing", {x, y, z}, [degrees]  faces whose normal is within degrees
--                                   (default 30) of the direction
--   "inside", {lo}, {hi}            centres inside the box
--   "where", function(position, id) centres the function accepts
function EditMesh:select(kind, rule, a, b)
	kind = kind or "face"
	local ids = {}
	for id, element in elements(self, kind) do
		local keep
		if rule == nil or rule == "all" then
			keep = true
		elseif rule == "ids" then
			keep = table.find(a, id) ~= nil
		elseif rule == "tag" then
			keep = element.tags[a] == true
		elseif rule == "facing" then
			assert(kind == "face", "EditMesh: facing selects faces")
			local limit = math.cos(math.rad(b or 30))
			keep = EditMesh.vec.dot(self:faceNormal(id), EditMesh.vec.unit(a)) >= limit
		elseif rule == "inside" then
			local p = centreOf(self, kind, id)
			keep = p[1] >= a[1] and p[1] <= b[1] and p[2] >= a[2] and p[2] <= b[2] and p[3] >= a[3] and p[3] <= b[3]
		elseif rule == "where" then
			keep = a(centreOf(self, kind, id), id) == true
		else
			error(`EditMesh: no selection rule {rule}`)
		end
		if keep then
			ids[id] = true
		end
	end
	return selection(self, kind, ids)
end

local Selection = EditMesh.Selection

function Selection:list()
	return keys(self.ids)
end

function Selection:count()
	local count = 0
	for _ in self.ids do
		count += 1
	end
	return count
end

function Selection:first()
	return self:list()[1]
end

function Selection:union(other)
	assert(other.kind == self.kind, "EditMesh: union of different kinds")
	local ids = table.clone(self.ids)
	for id in other.ids do
		ids[id] = true
	end
	return selection(self.mesh, self.kind, ids)
end

function Selection:minus(other)
	local ids = table.clone(self.ids)
	for id in other.ids do
		ids[id] = nil
	end
	return selection(self.mesh, self.kind, ids)
end

-- Keeps only the members `keep(position, id)` accepts.
function Selection:filter(keep)
	local ids = {}
	for id in self.ids do
		if keep(centreOf(self.mesh, self.kind, id), id) then
			ids[id] = true
		end
	end
	return selection(self.mesh, self.kind, ids)
end

-- The vertices the selection touches.
function Selection:verts()
	local mesh, ids = self.mesh, {}
	for id in self.ids do
		if self.kind == "vertex" then
			ids[id] = true
		elseif self.kind == "edge" then
			ids[mesh.edges[id].a] = true
			ids[mesh.edges[id].b] = true
		else
			for _, vert in mesh.faces[id].verts do
				ids[vert] = true
			end
		end
	end
	return selection(mesh, "vertex", ids)
end

-- The edges the selection touches (for faces: their outlines and insides).
function Selection:edges()
	local mesh, ids = self.mesh, {}
	if self.kind == "edge" then
		return self
	end
	if self.kind == "vertex" then
		for id in self.ids do
			for edge in mesh.vertEdges[id] do
				local e = mesh.edges[edge]
				if self.ids[e.a] and self.ids[e.b] then
					ids[edge] = true
				end
			end
		end
	else
		for id in self.ids do
			local verts = mesh.faces[id].verts
			for index, vert in verts do
				ids[mesh:edge(vert, verts[index % #verts + 1])] = true
			end
		end
	end
	return selection(mesh, "edge", ids)
end

-- The faces whose every vertex is in the selection.
function Selection:faces()
	local mesh, verts, ids = self.mesh, self:verts().ids, {}
	if self.kind == "face" then
		return self
	end
	for id, face in mesh.faces do
		local all = true
		for _, vert in face.verts do
			if not verts[vert] then
				all = false
				break
			end
		end
		if all then
			ids[id] = true
		end
	end
	return selection(mesh, "face", ids)
end

-- The edges round the outside of a face selection.
function Selection:boundary()
	assert(self.kind == "face", "EditMesh: boundary of faces")
	local mesh, ids = self.mesh, {}
	for edge in self:edges().ids do
		local inside = 0
		for face in mesh.edgeFaces[edge] do
			if self.ids[face] then
				inside += 1
			end
		end
		if inside == 1 then
			ids[edge] = true
		end
	end
	return selection(mesh, "edge", ids)
end

-- One step out: every element sharing a vertex with the selection.
function Selection:grow()
	local mesh, ids, verts = self.mesh, table.clone(self.ids), self:verts().ids
	for vert in verts do
		if self.kind == "vertex" then
			for _, other in mesh:neighbours(vert) do
				ids[other] = true
			end
		elseif self.kind == "edge" then
			for edge in mesh.vertEdges[vert] do
				ids[edge] = true
			end
		else
			for face in mesh.vertFaces[vert] do
				ids[face] = true
			end
		end
	end
	return selection(mesh, self.kind, ids)
end

-- One step in: drops members that touch anything outside the selection.
function Selection:shrink()
	local mesh, outside, ids = self.mesh, {}, {}
	local inVerts = self:verts().ids
	for vert in inVerts do
		if self.kind == "face" then
			for face in mesh.vertFaces[vert] do
				if not self.ids[face] then
					outside[vert] = true
				end
			end
		else
			for _, other in mesh:neighbours(vert) do
				if not inVerts[other] then
					outside[vert] = true
				end
			end
		end
	end
	for id in self.ids do
		local touches = false
		for vert in selection(mesh, self.kind, { [id] = true }):verts().ids do
			if outside[vert] then
				touches = true
			end
		end
		if not touches then
			ids[id] = true
		end
	end
	return selection(mesh, self.kind, ids)
end

-- ---------------------------------------------------------------- loops and rings

-- In a quad, the edge across from `edge`.
local function opposite(mesh, face, edge)
	local verts = mesh.faces[face].verts
	if #verts ~= 4 then
		return nil
	end
	local e = mesh.edges[edge]
	for index, vert in verts do
		local nextVert = verts[index % 4 + 1]
		if (vert == e.a and nextVert == e.b) or (vert == e.b and nextVert == e.a) then
			return mesh:edge(verts[(index + 1) % 4 + 1], verts[(index + 2) % 4 + 1])
		end
	end
	return nil
end

-- The ring of edges across quads from `edge`: each the one opposite the
-- last in the next quad, until it comes round or meets a non-quad.
function EditMesh:ring(edge)
	local ids = { [edge] = true }
	for face in self.edgeFaces[edge] do
		local current, from = edge, face
		while from do
			local across = opposite(self, from, current)
			if not across or ids[across] then
				break
			end
			ids[across] = true
			local nextFace = nil
			for other in self.edgeFaces[across] do
				if other ~= from then
					nextFace = other
				end
			end
			current, from = across, nextFace
		end
	end
	return selection(self, "edge", ids)
end

-- The loop of edges through `edge`: from each end, on through the vertex to
-- the edge that shares no face with the last, while the vertex has four
-- edges (a regular quad grid point).
function EditMesh:loop(edge)
	local ids = { [edge] = true }
	local e = self.edges[edge]
	for _, start in { e.a, e.b } do
		local current, vert = edge, start
		while true do
			if self:count(self.vertEdges[vert]) ~= 4 then
				break
			end
			local sharing = {}
			for face in self.edgeFaces[current] do
				sharing[face] = true
			end
			local nextEdge = nil
			for candidate in self.vertEdges[vert] do
				if candidate ~= current then
					local shares = false
					for face in self.edgeFaces[candidate] do
						if sharing[face] then
							shares = true
						end
					end
					if not shares then
						nextEdge = candidate
					end
				end
			end
			if not nextEdge or ids[nextEdge] then
				break
			end
			ids[nextEdge] = true
			local n = self.edges[nextEdge]
			current, vert = nextEdge, if n.a == vert then n.b else n.a
		end
	end
	return selection(self, "edge", ids)
end

function EditMesh:count(set)
	local count = 0
	for _ in set do
		count += 1
	end
	return count
end

-- ---------------------------------------------------------------- moving selections

-- Moves each selected vertex by `change(position, id) -> new position`.
-- With `radius`, vertices outside the selection within that distance of it
-- follow too, eased from full at the edge to none at `radius` (soft
-- selection): position + (new - position) * falloff.
function Selection:reshape(change, radius)
	local mesh, chosen = self.mesh, self:verts().ids
	local moves = {}
	for vert in chosen do
		moves[vert] = { weight = 1, from = mesh.verts[vert].position }
	end
	if radius and radius > 0 then
		for id, vert in mesh.verts do
			if not chosen[id] then
				local nearest = math.huge
				for other in chosen do
					nearest = math.min(nearest, EditMesh.vec.length(EditMesh.vec.sub(vert.position, mesh.verts[other].position)))
				end
				if nearest < radius then
					local t = 1 - nearest / radius
					moves[id] = { weight = t * t * (3 - 2 * t), from = vert.position }
				end
			end
		end
	end
	for id, move in moves do
		local target = change(move.from, id)
		mesh.verts[id].position = EditMesh.vec.lerp(move.from, target, move.weight)
	end
	return self
end

function Selection:move(offset, radius)
	return self:reshape(function(p)
		return EditMesh.vec.add(p, offset)
	end, radius)
end

-- Scales about `pivot` (default: the selection's middle) by {sx, sy, sz}.
function Selection:scale(factors, pivot, radius)
	pivot = pivot or self:middle()
	if type(factors) == "number" then
		factors = { factors, factors, factors }
	end
	return self:reshape(function(p)
		return {
			pivot[1] + (p[1] - pivot[1]) * factors[1],
			pivot[2] + (p[2] - pivot[2]) * factors[2],
			pivot[3] + (p[3] - pivot[3]) * factors[3],
		}
	end, radius)
end

-- Turns about `axis` ({x, y, z}, through `pivot`) by `degrees`.
function Selection:rotate(axis, degrees, pivot, radius)
	pivot = pivot or self:middle()
	local k = EditMesh.vec.unit(axis)
	local angle = math.rad(degrees)
	local c, s = math.cos(angle), math.sin(angle)
	return self:reshape(function(p)
		-- Rodrigues' rotation.
		local v = EditMesh.vec.sub(p, pivot)
		local cross = EditMesh.vec.cross(k, v)
		local along = EditMesh.vec.scale(k, EditMesh.vec.dot(k, v) * (1 - c))
		local turned = EditMesh.vec.add(EditMesh.vec.add(EditMesh.vec.scale(v, c), EditMesh.vec.scale(cross, s)), along)
		return EditMesh.vec.add(pivot, turned)
	end, radius)
end

-- The middle of the selection's vertices.
function Selection:middle()
	local sum, count = { 0, 0, 0 }, 0
	for vert in self:verts().ids do
		sum = EditMesh.vec.add(sum, self.mesh.verts[vert].position)
		count += 1
	end
	return EditMesh.vec.scale(sum, 1 / math.max(1, count))
end

function Selection:tag(name)
	local all = elements(self.mesh, self.kind)
	for id in self.ids do
		all[id].tags[name] = true
	end
	return self
end

function Selection:crease(weight)
	for edge in self:edges().ids do
		self.mesh:setCrease(edge, weight)
	end
	return self
end

-- ---------------------------------------------------------------- checks

-- What's wrong with the mesh, as a list of short descriptions: edges with
-- one face (holes), edges with more than two (fins), faces turned against
-- their neighbours, faces with more than four corners (unless allowed),
-- sliver faces, and loose vertices.
function EditMesh:problems(options)
	options = options or {}
	local found = {}
	local function note(text)
		if #found < 20 then
			table.insert(found, text)
		end
	end
	for edge, e in self.edges do
		local faces = self:count(self.edgeFaces[edge])
		if faces == 1 and not options.open then
			note(`hole at edge {edge} ({e.a}-{e.b})`)
		elseif faces > 2 then
			note(`edge {edge} is shared by {faces} faces`)
		elseif faces == 2 then
			-- Neighbours must run the shared edge in opposite directions.
			local runs = {}
			for face in self.edgeFaces[edge] do
				local verts = self.faces[face].verts
				for index, vert in verts do
					if vert == e.a and verts[index % #verts + 1] == e.b then
						table.insert(runs, 1)
					elseif vert == e.b and verts[index % #verts + 1] == e.a then
						table.insert(runs, -1)
					end
				end
			end
			if runs[1] == runs[2] then
				note(`faces at edge {edge} are turned against each other`)
			end
		end
	end
	for face, f in self.faces do
		if #f.verts > 4 and not options.ngons then
			note(`face {face} has {#f.verts} corners`)
		end
		if self:faceArea(face) < (options.sliver or 1e-6) then
			note(`face {face} has almost no area`)
		end
	end
	for vert in self.verts do
		if next(self.vertFaces[vert]) == nil then
			note(`vertex {vert} belongs to no face`)
		end
	end
	return found
end

-- The share of faces with four corners, 0-1.
function EditMesh:quadShare()
	local quads, all = 0, 0
	for _, face in self.faces do
		all += 1
		if #face.verts == 4 then
			quads += 1
		end
	end
	return if all == 0 then 1 else quads / all
end

-- ---------------------------------------------------------------- to the engine

-- Writes the mesh into an engine Mesh (the `mesh` a part's build function
-- gets), optionally moved by `offset`. Returns how many faces it wrote.
function EditMesh:emit(mesh, offset)
	local engineIds = {}
	local dx, dy, dz = 0, 0, 0
	if offset then
		dx, dy, dz = offset[1], offset[2], offset[3]
	end
	for _, id in keys(self.verts) do
		local p = self.verts[id].position
		engineIds[id] = mesh:vertex(p[1] + dx, p[2] + dy, p[3] + dz)
	end
	local written = 0
	for _, id in keys(self.faces) do
		local verts = {}
		for index, vert in self.faces[id].verts do
			verts[index] = engineIds[vert]
		end
		mesh:face(verts)
		written += 1
	end
	return written
end

-- A copy with fresh ids, for making variants of a shape.
function EditMesh:copy()
	local other = EditMesh.new()
	local map = {}
	for _, id in keys(self.verts) do
		local p = self.verts[id].position
		map[id] = other:addVertex(p[1], p[2], p[3])
		for name in self.verts[id].tags do
			other.verts[map[id]].tags[name] = true
		end
	end
	for _, id in keys(self.faces) do
		local verts = {}
		for index, vert in self.faces[id].verts do
			verts[index] = map[vert]
		end
		other:addFace(verts, self.faces[id].tags)
	end
	for _, id in keys(self.edges) do
		local e = self.edges[id]
		local mine = other:edge(map[e.a], map[e.b])
		other.edges[mine].crease = e.crease
		for name in e.tags do
			other.edges[mine].tags[name] = true
		end
	end
	return other
end
-- Edit Ops: the operations that reshape an Edit Mesh (shared/EditMesh.luau,
-- included first). Include with `-- include: EditOps` after EditMesh.
--
-- Each works on a selection (m:select(...)) or the whole mesh, keeps faces
-- four-sided wherever the input was, keeps a closed surface closed, and
-- returns what it made as a selection so the next step can use it. What
-- it makes is also tagged with the name passed as `tag`, when given.
--
--   extrude(faces, distance | {x, y, z}, options)  faces out, sides between
--   inset(faces, width, depth, options)            a smaller face inside
--   loopCut(edge, cuts, at)                        cuts across a quad ring
--   subdivide(levels)                              each face into quads
--   smoothSubdivide(levels)                        Catmull-Clark, with creases
--   bridge(edgesA, edgesB)                         quads joining two holes
--   bridgeFaces(a, b)                              a tunnel or handle between
--                                                  two faces or regions
--   bevel(edges, width, segments)                  chamfered or rounded edges
--   poke(faces)                                    a point in each face
--   spin / sweep (shared/EditShapes.luau)          lathe and profile sweeps
--   bend, taper, twist(axis...)                    reshape whole or selection
--   smooth(selection, amount, rounds)              relax towards neighbours
--   push(selection, distance)                      along vertex normals
--   toCircle(vertex loop)                          round a loop out
--   toSphere(selection, amount)                    pull towards a sphere
--   dissolve(edges)                                two faces into one
--   weld(distance)                                 merge vertices that touch
--   fill(edges)                                    close a hole with one face
--   mirror(axis, at)                               build one side, get both
--   solidify(thickness)                            give a sheet thickness
--   array(count, offset)                           copies in a row
--   transform(function)                            any reshaping by position

local vec = EditMesh.vec

local function sortedKeys(set)
	local list = {}
	for key in set do
		table.insert(list, key)
	end
	table.sort(list)
	return list
end

local function asFaces(m, faces)
	if faces == nil then
		return m:select("face", "all")
	end
	if faces.kind then
		return faces:faces()
	end
	return m:select("face", "ids", faces)
end

local function asVerts(m, selection)
	if selection == nil then
		return m:select("vertex", "all")
	end
	return selection:verts()
end

-- The region's edges that have one side in the region and one out (or no
-- other side), each as {a, b} running the way the region's face runs it.
local function boundaryRuns(m, faces)
	local runs = {}
	for face in faces.ids do
		local verts = m.faces[face].verts
		for index, a in verts do
			local b = verts[index % #verts + 1]
			local edge = m:edge(a, b)
			local inside = 0
			for other in m.edgeFaces[edge] do
				if faces.ids[other] then
					inside += 1
				end
			end
			if inside == 1 then
				table.insert(runs, { a, b, face })
			end
		end
	end
	return runs
end

-- ---------------------------------------------------------------- extrude and inset

-- Copies the region's vertices, moves the region onto the copies, and joins
-- old to new with a side quad on every boundary edge. `place(vert, copy)`
-- positions each copy. Returns the region (same faces) and the side faces.
local function lift(m, faces, place, tag)
	local runs = boundaryRuns(m, faces)
	local copies = {}
	local sides = {}
	-- Inner vertices of the region go when it moves; remember where they were.
	local before = {}
	for vert in faces:verts().ids do
		before[vert] = m.verts[vert].position
	end
	m:rebuilding(function()
		for vert in faces:verts().ids do
			local p = m.verts[vert].position
			copies[vert] = m:addVertex(p[1], p[2], p[3])
		end
		for face in faces.ids do
			local moved = {}
			for index, vert in m.faces[face].verts do
				moved[index] = copies[vert]
			end
			m:replaceFace(face, moved)
		end
		for _, run in runs do
			local a, b = run[1], run[2]
			local side = m:addFace({ a, b, copies[b], copies[a] }, tag and { [tag] = true } or nil)
			sides[side] = true
		end
	end)
	for vert, copy in copies do
		place(before[vert], copy, vert)
	end
	return faces, setmetatable({ mesh = m, kind = "face", ids = sides }, EditMesh.Selection)
end

-- The average normal of a region's faces at each of its vertices, and of
-- the whole region.
local function regionNormals(m, faces)
	local perVert, whole = {}, { 0, 0, 0 }
	for face in faces.ids do
		local n = vec.scale(m:faceNormal(face), m:faceArea(face))
		whole = vec.add(whole, n)
		for _, vert in m.faces[face].verts do
			perVert[vert] = vec.add(perVert[vert] or { 0, 0, 0 }, n)
		end
	end
	for vert, n in perVert do
		perVert[vert] = vec.unit(n)
	end
	return perVert, vec.unit(whole)
end

-- Extrudes faces. `amount` is a distance along the region's normal, or a
-- vector. options.each: every face on its own (default: the region as
-- one). options.along = "vertex": each vertex along its own normal (an
-- inflate). Returns the moved faces and the new side faces.
function EditMesh:extrude(faces, amount, options)
	options = options or {}
	faces = asFaces(self, faces)
	if options.each then
		local tops, sides = {}, {}
		for _, face in sortedKeys(faces.ids) do
			local top, side = self:extrude({ face }, amount, { along = options.along, tag = options.tag })
			for id in top.ids do
				tops[id] = true
			end
			for id in side.ids do
				sides[id] = true
			end
		end
		local Selection = EditMesh.Selection
		return setmetatable({ mesh = self, kind = "face", ids = tops }, Selection),
			setmetatable({ mesh = self, kind = "face", ids = sides }, Selection)
	end
	local perVert, whole = regionNormals(self, faces)
	return lift(self, faces, function(p, copy, vert)
		local offset
		if type(amount) == "table" then
			offset = amount
		elseif options.along == "vertex" then
			offset = vec.scale(perVert[vert], amount)
		else
			offset = vec.scale(whole, amount)
		end
		self.verts[copy].position = vec.add(p, offset)
	end, options.tag)
end

-- For each boundary vertex, the direction into the region along its
-- surface, scaled so an inset of 1 keeps edges 1 apart (mitred corners).
local function insetDirections(m, faces)
	local runs = boundaryRuns(m, faces)
	local into, outOf = {}, {}
	for _, run in runs do
		local a, b, face = run[1], run[2], run[3]
		local d = vec.unit(vec.sub(m.verts[b].position, m.verts[a].position))
		local inward = vec.unit(vec.cross(m:faceNormal(face), d))
		outOf[a] = inward
		into[b] = inward
	end
	local directions = {}
	for vert, before in into do
		local after = outOf[vert] or before
		local sum = vec.add(before, after)
		local denominator = 1 + vec.dot(before, after)
		directions[vert] = if denominator > 1e-6 then vec.scale(sum, 1 / denominator) else before
	end
	return directions
end

-- Insets faces: a smaller copy of the region inside it, `width` in from
-- its edges, raised by `depth` (negative to sink it). options.each: every
-- face on its own. Returns the inner faces and the ring of faces round them.
function EditMesh:inset(faces, width, depth, options)
	options = options or {}
	faces = asFaces(self, faces)
	if options.each then
		local inner, rings = {}, {}
		for _, face in sortedKeys(faces.ids) do
			local a, b = self:inset({ face }, width, depth, { tag = options.tag })
			for id in a.ids do
				inner[id] = true
			end
			for id in b.ids do
				rings[id] = true
			end
		end
		local Selection = EditMesh.Selection
		return setmetatable({ mesh = self, kind = "face", ids = inner }, Selection),
			setmetatable({ mesh = self, kind = "face", ids = rings }, Selection)
	end
	local directions = insetDirections(self, faces)
	local perVert = regionNormals(self, faces)
	return lift(self, faces, function(p, copy, vert)
		local offset = vec.scale(directions[vert] or { 0, 0, 0 }, width)
		offset = vec.add(offset, vec.scale(perVert[vert], depth or 0))
		self.verts[copy].position = vec.add(p, offset)
	end, options.tag)
end

-- ---------------------------------------------------------------- loop cut

-- The quad ring from `edge` in order, each step as {edge, face to the next,
-- sideA}: sideA is the end of the edge on the same side as the first edge's
-- lower end, so cuts line up all the way round.
local function orderedRing(m, edge)
	local function across(face, current, sideA)
		local verts = m.faces[face].verts
		if #verts ~= 4 then
			return nil
		end
		local e = m.edges[current]
		for index, vert in verts do
			local nextVert = verts[index % 4 + 1]
			if (vert == e.a and nextVert == e.b) or (vert == e.b and nextVert == e.a) then
				local c, d = verts[(index + 1) % 4 + 1], verts[(index + 2) % 4 + 1]
				-- d is joined to vert, c to nextVert.
				local nextA = if vert == sideA then d else c
				return m:edge(c, d), nextA
			end
		end
		return nil
	end
	local steps = { { edge = edge, a = m.edges[edge].a } }
	local seen = { [edge] = true }
	local closed = false
	local faces = sortedKeys(m.edgeFaces[edge])
	-- Forward through the first face, then backward through the second.
	for direction, startFace in faces do
		local current, sideA, face = edge, m.edges[edge].a, startFace
		while face do
			local nextEdge, nextA = across(face, current, sideA)
			if not nextEdge then
				break
			end
			if seen[nextEdge] then
				closed = nextEdge == edge
				if closed then
					-- The face that comes back round to the first edge.
					steps[1].via = face
				end
				break
			end
			seen[nextEdge] = true
			-- `via` is always the face between a step and the one before it.
			if direction == 1 then
				table.insert(steps, { edge = nextEdge, a = nextA, via = face })
			else
				steps[1].via = face
				table.insert(steps, 1, { edge = nextEdge, a = nextA })
			end
			local following = nil
			for other in m.edgeFaces[nextEdge] do
				if other ~= face then
					following = other
				end
			end
			current, sideA, face = nextEdge, nextA, following
		end
		if closed then
			break
		end
	end
	return steps, closed
end

-- Cuts `cuts` new edge loops across the quad ring through `edge`, evenly
-- spaced or at the fractions in `at` (measured from one side of the ring).
-- Returns the new edges.
function EditMesh:loopCut(edge, cuts, at)
	cuts = cuts or 1
	if not at then
		at = {}
		for k = 1, cuts do
			at[k] = k / (cuts + 1)
		end
	end
	table.sort(at)
	local steps, closed = orderedRing(self, edge)
	-- Split every edge of the ring at the fractions, from its side A.
	local made = {}
	for index, step in steps do
		local e = self.edges[step.edge]
		local other = if e.a == step.a then e.b else e.a
		local points = {}
		local remaining, from = step.edge, step.a
		local done = 0
		for k, t in at do
			-- Each split shortens what's left; rescale the fraction to it.
			local local_t = (t - done) / (1 - done)
			local re = self.edges[remaining]
			local frac = if re.a == from then local_t else 1 - local_t
			local middle = self:splitEdge(remaining, frac)
			points[k] = middle
			remaining = self:edge(middle, other)
			from = middle
			done = t
		end
		made[index] = points
	end
	-- Connect matching points across each quad of the ring: between each
	-- step and the next, and from the last back to the first if it closes.
	local newEdges = {}
	local function join(from, to)
		for k = 1, #at do
			local a, b = made[from][k], made[to][k]
			local shared = nil
			for candidate in self.vertFaces[a] do
				if self.vertFaces[b][candidate] then
					shared = candidate
				end
			end
			if shared and not self:edge(a, b) then
				self:connect(shared, a, b)
				newEdges[self:edge(a, b)] = true
			end
		end
	end
	for index = 1, #steps - 1 do
		join(index, index + 1)
	end
	if closed and #steps > 2 then
		join(#steps, 1)
	end
	return setmetatable({ mesh = self, kind = "edge", ids = newEdges }, EditMesh.Selection)
end

-- ---------------------------------------------------------------- subdivision

-- One level of splitting every face into quads: a point in the middle of
-- each face and each edge. `smooth` positions them by Catmull-Clark,
-- honouring edge creases (1 keeps an edge sharp, between blends).
local function subdivideOnce(m, smooth)
	local facePoint, edgePoint = {}, {}
	local oldFaces = sortedKeys(m.faces)
	local oldEdges = sortedKeys(m.edges)
	local oldVerts = sortedKeys(m.verts)
	local creases, faceTags = {}, {}
	for _, face in oldFaces do
		facePoint[face] = m:faceCentre(face)
		faceTags[face] = table.clone(m.faces[face].tags)
	end
	local edgePosition = {}
	for _, edge in oldEdges do
		local e = m.edges[edge]
		local a, b = m.verts[e.a].position, m.verts[e.b].position
		local middle = vec.lerp(a, b, 0.5)
		local p = middle
		local faces = sortedKeys(m.edgeFaces[edge])
		if smooth and #faces == 2 then
			local soft = vec.scale(vec.add(vec.add(a, b), vec.add(facePoint[faces[1]], facePoint[faces[2]])), 0.25)
			p = vec.lerp(soft, middle, e.crease)
		end
		edgePosition[edge] = p
		creases[edge] = e.crease
	end
	local vertPosition = {}
	for _, vert in oldVerts do
		local p = m.verts[vert].position
		if not smooth then
			vertPosition[vert] = p
			continue
		end
		local edges = sortedKeys(m.vertEdges[vert])
		local faces = sortedKeys(m.vertFaces[vert])
		local sharp, border = {}, {}
		for _, edge in edges do
			if #sortedKeys(m.edgeFaces[edge]) < 2 then
				table.insert(border, edge)
			end
			if m.edges[edge].crease > 0 then
				table.insert(sharp, edge)
			end
		end
		local n = #faces
		local soft
		if #border > 0 or n == 0 then
			-- Open edge: keep to the boundary curve.
			if #border == 2 then
				local function far(edge)
					local e = m.edges[edge]
					return m.verts[if e.a == vert then e.b else e.a].position
				end
				soft = vec.scale(vec.add(vec.scale(p, 6), vec.add(far(border[1]), far(border[2]))), 1 / 8)
			else
				soft = p
			end
			vertPosition[vert] = soft
			continue
		end
		local faceAverage, edgeAverage = { 0, 0, 0 }, { 0, 0, 0 }
		for _, face in faces do
			faceAverage = vec.add(faceAverage, facePoint[face])
		end
		faceAverage = vec.scale(faceAverage, 1 / n)
		for _, edge in edges do
			local e = m.edges[edge]
			edgeAverage = vec.add(edgeAverage, vec.lerp(m.verts[e.a].position, m.verts[e.b].position, 0.5))
		end
		edgeAverage = vec.scale(edgeAverage, 1 / #edges)
		soft = vec.scale(vec.add(vec.add(faceAverage, vec.scale(edgeAverage, 2)), vec.scale(p, n - 3)), 1 / n)
		if #sharp == 2 then
			local function far(edge)
				local e = m.edges[edge]
				return m.verts[if e.a == vert then e.b else e.a].position
			end
			local creased = vec.scale(vec.add(vec.scale(p, 6), vec.add(far(sharp[1]), far(sharp[2]))), 1 / 8)
			local weight = (m.edges[sharp[1]].crease + m.edges[sharp[2]].crease) / 2
			soft = vec.lerp(soft, creased, weight)
		elseif #sharp > 2 then
			local weight = 0
			for _, edge in sharp do
				weight = math.max(weight, m.edges[edge].crease)
			end
			soft = vec.lerp(soft, p, weight)
		end
		vertPosition[vert] = soft
	end

	-- Rebuild: a fresh mesh keeps it simple; ids of the old vertices carry over.
	local rebuilt = EditMesh.new()
	rebuilt.nextVert = m.nextVert
	for _, vert in oldVerts do
		local p = vertPosition[vert]
		rebuilt.verts[vert] = { position = { p[1], p[2], p[3] }, tags = table.clone(m.verts[vert].tags) }
		rebuilt.vertFaces[vert] = {}
		rebuilt.vertEdges[vert] = {}
	end
	local edgeVert, faceVert = {}, {}
	for _, edge in oldEdges do
		local p = edgePosition[edge]
		edgeVert[edge] = rebuilt:addVertex(p[1], p[2], p[3])
	end
	for _, face in oldFaces do
		local p = facePoint[face]
		if smooth then
			-- Catmull-Clark face points are the plain centres.
			p = facePoint[face]
		end
		faceVert[face] = rebuilt:addVertex(p[1], p[2], p[3])
	end
	rebuilt.nextFace = m.nextFace
	local childCreases = {}
	for _, face in oldFaces do
		local verts = m.faces[face].verts
		local count = #verts
		for index, vert in verts do
			local before = verts[(index - 2) % count + 1]
			local after = verts[index % count + 1]
			local e1 = edgeVert[m:edge(before, vert)]
			local e2 = edgeVert[m:edge(vert, after)]
			rebuilt:addFace({ vert, e2, faceVert[face], e1 }, faceTags[face])
		end
	end
	-- Each crease passes to the two halves of its edge.
	for _, edge in oldEdges do
		local e = m.edges[edge]
		for _, half in { rebuilt:edge(e.a, edgeVert[edge]), rebuilt:edge(edgeVert[edge], e.b) } do
			if half then
				rebuilt.edges[half].crease = creases[edge]
				for name in e.tags do
					rebuilt.edges[half].tags[name] = true
				end
			end
		end
	end
	for key, value in rebuilt do
		m[key] = value
	end
	setmetatable(m, EditMesh)
	return childCreases
end

-- Splits every face into quads, `levels` times, without moving anything.
function EditMesh:subdivide(levels)
	for _ = 1, levels or 1 do
		subdivideOnce(self, false)
	end
	return self:select("face", "all")
end

-- Catmull-Clark subdivision, `levels` times: a rough cage becomes a smooth
-- shape. Creased edges (m:setCrease, selection:crease) stay sharp.
function EditMesh:smoothSubdivide(levels)
	for _ = 1, levels or 1 do
		subdivideOnce(self, true)
	end
	return self:select("face", "all")
end

-- ---------------------------------------------------------------- bridging and filling

-- Orders a set of edges forming one closed loop into a vertex cycle, each
-- step running the way the edge's one face runs it (a hole's rim).
local function rimCycle(m, edges)
	local nextOf = {}
	for edge in edges.ids do
		local e = m.edges[edge]
		local face = sortedKeys(m.edgeFaces[edge])[1]
		assert(face, "EditMesh: a rim edge with no face")
		local verts = m.faces[face].verts
		for index, vert in verts do
			local after = verts[index % #verts + 1]
			if (vert == e.a and after == e.b) or (vert == e.b and after == e.a) then
				nextOf[vert] = after
			end
		end
	end
	local start = sortedKeys(nextOf)[1]
	local cycle, vert = {}, start
	repeat
		table.insert(cycle, vert)
		vert = nextOf[vert]
		assert(vert, "EditMesh: those edges aren't one closed loop")
	until vert == start
	assert(#cycle == m:count(edges.ids), `EditMesh: those edges make more than one loop ({#cycle} of {m:count(edges.ids)} in the first)`)
	return cycle
end

-- Joins two holes' rims (edge selections of equal length) with quads.
-- The rims are matched where they line up best. Returns the new faces.
function EditMesh:bridge(edgesA, edgesB, tag)
	local a, b = rimCycle(self, edgesA), rimCycle(self, edgesB)
	assert(#a == #b, `EditMesh: bridge needs rims of one length ({#a} and {#b})`)
	local n = #a
	local best, bestCost = 0, math.huge
	for offset = 0, n - 1 do
		local cost = 0
		for i = 0, n - 1 do
			local j = (offset - i) % n
			cost += vec.length(vec.sub(self.verts[a[i + 1]].position, self.verts[b[j + 1]].position))
		end
		if cost < bestCost then
			best, bestCost = offset, cost
		end
	end
	local made = {}
	for i = 0, n - 1 do
		local j, k = (best - i) % n, (best - i - 1) % n
		local face = self:addFace({ a[(i + 1) % n + 1], a[i + 1], b[j + 1], b[k + 1] }, tag and { [tag] = true } or nil)
		made[face] = true
	end
	return setmetatable({ mesh = self, kind = "face", ids = made }, EditMesh.Selection)
end

-- Removes two faces (or two regions of faces, given as selections) and
-- joins their rims: a tunnel through the mesh, or a handle between two
-- ends turned to face each other.
function EditMesh:bridgeFaces(faceA, faceB, tag)
	local regionA = if type(faceA) == "table" then faceA:faces() else self:select("face", "ids", { faceA })
	local regionB = if type(faceB) == "table" then faceB:faces() else self:select("face", "ids", { faceB })
	local keepA, keepB = regionA:boundary().ids, regionB:boundary().ids
	return self:rebuilding(function()
		for face in regionA.ids do
			self:removeFace(face)
		end
		for face in regionB.ids do
			self:removeFace(face)
		end
		local function restore(ids)
			return setmetatable({ mesh = self, kind = "edge", ids = ids }, EditMesh.Selection)
		end
		return self:bridge(restore(keepA), restore(keepB), tag)
	end)
end

-- Closes a hole with one face over its rim. Returns the face.
function EditMesh:fill(edges, tag)
	local cycle = rimCycle(self, edges)
	local reversed = {}
	for index = #cycle, 1, -1 do
		table.insert(reversed, cycle[index])
	end
	return self:addFace(reversed, tag and { [tag] = true } or nil)
end

-- Removes the edges between pairs of faces, joining each pair into one.
function EditMesh:dissolve(edges)
	self:rebuilding(function()
		for _, edge in sortedKeys(edges:edges().ids) do
			local e = self.edges[edge]
			if not e then
				continue
			end
			local faces = sortedKeys(self.edgeFaces[edge])
			if #faces ~= 2 then
				continue
			end
			local f1, f2 = self.faces[faces[1]].verts, self.faces[faces[2]].verts
			-- Walk f1 from e.b round to e.a, then f2 from e.a round to e.b.
			local function from(verts, start, stop)
				local list, index = {}, table.find(verts, start)
				while verts[index] ~= stop do
					table.insert(list, verts[index])
					index = index % #verts + 1
				end
				return list
			end
			local i1 = table.find(f1, e.a)
			local runsAB = f1[i1 % #f1 + 1] == e.b
			local first = if runsAB then from(f1, e.b, e.a) else from(f1, e.a, e.b)
			local second = if runsAB then from(f2, e.a, e.b) else from(f2, e.b, e.a)
			local joined = table.clone(first)
			for _, vert in second do
				table.insert(joined, vert)
			end
			local tags = self.faces[faces[1]].tags
			self:removeFace(faces[2])
			self:replaceFace(faces[1], joined)
			for name in tags do
				self.faces[faces[1]].tags[name] = true
			end
		end
	end)
end

-- Merges vertices closer than `distance` (default 1e-4) into one.
function EditMesh:weld(distance)
	distance = distance or 1e-4
	local cell = math.max(distance * 4, 1e-6)
	local grid = {}
	local merged = 0
	for _, vert in sortedKeys(self.verts) do
		local v = self.verts[vert]
		if not v then
			continue
		end
		local p = v.position
		local cx, cy, cz = p[1] // cell, p[2] // cell, p[3] // cell
		local target = nil
		for dx = -1, 1 do
			for dy = -1, 1 do
				for dz = -1, 1 do
					for _, other in grid[`{cx + dx},{cy + dy},{cz + dz}`] or {} do
						if self.verts[other] and vec.length(vec.sub(self.verts[other].position, p)) <= distance then
							target = other
						end
					end
				end
			end
		end
		if target then
			self:mergeVertices(target, vert)
			merged += 1
		else
			local key = `{cx},{cy},{cz}`
			grid[key] = grid[key] or {}
			table.insert(grid[key], vert)
		end
	end
	return merged
end

-- A vertex in the middle of each face, joined to its corners (triangles).
function EditMesh:poke(faces)
	faces = asFaces(self, faces)
	local made = {}
	self:rebuilding(function()
		for _, face in sortedKeys(faces.ids) do
			local verts = table.clone(self.faces[face].verts)
			local c = self:faceCentre(face)
			local tags = self.faces[face].tags
			local middle = self:addVertex(c[1], c[2], c[3])
			self:removeFace(face)
			for index, vert in verts do
				local id = self:addFace({ vert, verts[index % #verts + 1], middle }, tags)
				made[id] = true
			end
		end
	end)
	return setmetatable({ mesh = self, kind = "face", ids = made }, EditMesh.Selection)
end

-- ---------------------------------------------------------------- reshaping

-- Moves every vertex (or the selection's) to `change(position) -> new`.
function EditMesh:transform(change, selection)
	for vert in asVerts(self, selection).ids do
		local p = self.verts[vert].position
		local q = change({ p[1], p[2], p[3] })
		self.verts[vert].position = q
	end
	return self
end

local AXES = { x = 1, y = 2, z = 3 }

-- Bends along `along` (the axis the shape runs on) towards `toward`, by
-- `degrees` over the whole length of the mesh (or selection), about its
-- low end. A strip along x bent 180 degrees toward z makes an arch.
function EditMesh:bend(degrees, along, toward, selection)
	local i, j = AXES[along or "x"], AXES[toward or "z"]
	local low, high = self:bounds()
	local length = high[i] - low[i]
	local angle = math.rad(degrees)
	if math.abs(angle) < 1e-9 or length <= 0 then
		return self
	end
	local radius = length / angle
	return self:transform(function(p)
		local theta = (p[i] - low[i]) / length * angle
		local r = radius - (p[j] - low[j])
		local q = table.clone(p)
		q[i] = low[i] + r * math.sin(theta)
		q[j] = low[j] + radius - r * math.cos(theta)
		return q
	end, selection)
end

-- Scales across `axis` from `from` at its low end to `to` at its high end.
function EditMesh:taper(axis, from, to, selection)
	local k = AXES[axis or "z"]
	local low, high = self:bounds()
	local centre = vec.lerp(low, high, 0.5)
	local length = math.max(1e-9, high[k] - low[k])
	return self:transform(function(p)
		local t = (p[k] - low[k]) / length
		local factor = from + (to - from) * t
		local q = table.clone(p)
		for axisIndex = 1, 3 do
			if axisIndex ~= k then
				q[axisIndex] = centre[axisIndex] + (p[axisIndex] - centre[axisIndex]) * factor
			end
		end
		return q
	end, selection)
end

-- Twists about `axis` through the middle, `degrees` from end to end.
function EditMesh:twist(axis, degrees, selection)
	local k = AXES[axis or "z"]
	local u, w = (k % 3) + 1, ((k + 1) % 3) + 1
	local low, high = self:bounds()
	local centre = vec.lerp(low, high, 0.5)
	local length = math.max(1e-9, high[k] - low[k])
	return self:transform(function(p)
		local angle = math.rad(degrees) * (p[k] - low[k]) / length
		local c, s = math.cos(angle), math.sin(angle)
		local du, dw = p[u] - centre[u], p[w] - centre[w]
		local q = table.clone(p)
		q[u] = centre[u] + du * c - dw * s
		q[w] = centre[w] + du * s + dw * c
		return q
	end, selection)
end

-- Relaxes vertices towards the average of their neighbours, `amount`
-- (0-1) each round. options.keepBorder leaves open edges where they are.
function EditMesh:smooth(selection, amount, rounds, options)
	options = options or {}
	local verts = asVerts(self, selection).ids
	for _ = 1, rounds or 1 do
		local moved = {}
		for vert in verts do
			local neighbours = self:neighbours(vert)
			if #neighbours == 0 then
				continue
			end
			if options.keepBorder then
				local border = false
				for edge in self.vertEdges[vert] do
					if self:count(self.edgeFaces[edge]) < 2 then
						border = true
					end
				end
				if border then
					continue
				end
			end
			local sum = { 0, 0, 0 }
			for _, other in neighbours do
				sum = vec.add(sum, self.verts[other].position)
			end
			moved[vert] = vec.lerp(self.verts[vert].position, vec.scale(sum, 1 / #neighbours), amount or 0.5)
		end
		for vert, p in moved do
			self.verts[vert].position = p
		end
	end
	return self
end

-- Moves vertices along their normals (negative to shrink).
function EditMesh:push(selection, distance)
	local moves = {}
	for vert in asVerts(self, selection).ids do
		moves[vert] = vec.add(self.verts[vert].position, vec.scale(self:vertexNormal(vert), distance))
	end
	for vert, p in moves do
		self.verts[vert].position = p
	end
	return self
end

-- Pulls a loop (or any set) of vertices round into a circle in their own
-- plane, about their middle, at their average distance from it.
function EditMesh:toCircle(selection, amount)
	local verts = sortedKeys(selection:verts().ids)
	local centre = { 0, 0, 0 }
	for _, vert in verts do
		centre = vec.add(centre, self.verts[vert].position)
	end
	centre = vec.scale(centre, 1 / #verts)
	-- The plane: the normal from summing cross products round the centre.
	local normal = { 0, 0, 0 }
	for index, vert in verts do
		local p = vec.sub(self.verts[vert].position, centre)
		local q = vec.sub(self.verts[verts[index % #verts + 1]].position, centre)
		local n = vec.cross(p, q)
		if vec.dot(n, normal) < 0 then
			n = vec.scale(n, -1)
		end
		normal = vec.add(normal, n)
	end
	normal = vec.unit(normal)
	local radius = 0
	for _, vert in verts do
		local d = vec.sub(self.verts[vert].position, centre)
		d = vec.sub(d, vec.scale(normal, vec.dot(d, normal)))
		radius += vec.length(d)
	end
	radius /= #verts
	for _, vert in verts do
		local p = self.verts[vert].position
		local d = vec.sub(p, centre)
		local inPlane = vec.sub(d, vec.scale(normal, vec.dot(d, normal)))
		local target = vec.add(centre, vec.scale(vec.unit(inPlane), radius))
		self.verts[vert].position = vec.lerp(p, target, amount or 1)
	end
	return selection
end

-- Pulls vertices towards a sphere about their middle (amount 1: all the
-- way), at their average distance from it, or `radius`.
function EditMesh:toSphere(selection, amount, radius)
	local verts = sortedKeys(asVerts(self, selection).ids)
	local centre = { 0, 0, 0 }
	for _, vert in verts do
		centre = vec.add(centre, self.verts[vert].position)
	end
	centre = vec.scale(centre, 1 / #verts)
	if not radius then
		radius = 0
		for _, vert in verts do
			radius += vec.length(vec.sub(self.verts[vert].position, centre))
		end
		radius /= #verts
	end
	for _, vert in verts do
		local p = self.verts[vert].position
		local target = vec.add(centre, vec.scale(vec.unit(vec.sub(p, centre)), radius))
		self.verts[vert].position = vec.lerp(p, target, amount or 1)
	end
	return self
end

-- ---------------------------------------------------------------- bevel

-- Bevels edges: each selected edge becomes a strip `width` wide on each of
-- its two faces, flat (segments 1) or rounded (more). Edges that meet at a
-- vertex aren't joined there: bevel one edge per corner at a time, or use
-- creases with smoothSubdivide, or a rounded box, to round every edge of a
-- block. Returns the strip faces.
function EditMesh:bevel(edges, width, segments)
	segments = segments or 1
	local made = {}
	for _, edge in sortedKeys(edges:edges().ids) do
		local e = self.edges[edge]
		if not e then
			continue
		end
		local faces = sortedKeys(self.edgeFaces[edge])
		if #faces ~= 2 then
			continue
		end
		local a, b = e.a, e.b
		local pa, pb = self.verts[a].position, self.verts[b].position
		-- In each face, the corner next to a and to b away from the edge.
		local function awayFrom(face, vert, other)
			local verts = self.faces[face].verts
			local index = table.find(verts, vert)
			local before, after = verts[(index - 2) % #verts + 1], verts[index % #verts + 1]
			return if before == other then after else before
		end
		local sides = {}
		for _, face in faces do
			local na, nb = awayFrom(face, a, b), awayFrom(face, b, a)
			local da = vec.unit(vec.sub(self.verts[na].position, pa))
			local db = vec.unit(vec.sub(self.verts[nb].position, pb))
			table.insert(sides, { face = face, da = da, db = db })
		end
		-- New corners: a1/b1 into face 1, a2/b2 into face 2.
		local a1p, b1p = vec.add(pa, vec.scale(sides[1].da, width)), vec.add(pb, vec.scale(sides[1].db, width))
		local a2p, b2p = vec.add(pa, vec.scale(sides[2].da, width)), vec.add(pb, vec.scale(sides[2].db, width))
		-- Rows across the strip from side 1 to side 2: straight for a chamfer,
		-- bowed out towards the old edge for a round.
		local rowsA, rowsB = {}, {}
		for k = 0, segments do
			local t = k / segments
			local qa = vec.lerp(a1p, a2p, t)
			local qb = vec.lerp(b1p, b2p, t)
			if segments > 1 then
				-- Quadratic Bezier with the old corner as the control point.
				local s = 1 - t
				qa = vec.add(vec.add(vec.scale(a1p, s * s), vec.scale(pa, 2 * s * t)), vec.scale(a2p, t * t))
				qb = vec.add(vec.add(vec.scale(b1p, s * s), vec.scale(pb, 2 * s * t)), vec.scale(b2p, t * t))
			end
			rowsA[k] = self:addVertex(qa[1], qa[2], qa[3])
			rowsB[k] = self:addVertex(qb[1], qb[2], qb[3])
		end
		self:rebuilding(function()
			-- Face 1 and 2 lose the old edge's corners for the strip's sides.
			for index, side in sides do
				local verts = table.clone(self.faces[side.face].verts)
				local edgeA = if index == 1 then rowsA[0] else rowsA[segments]
				local edgeB = if index == 1 then rowsB[0] else rowsB[segments]
				for i, vert in verts do
					if vert == a then
						verts[i] = edgeA
					elseif vert == b then
						verts[i] = edgeB
					end
				end
				self:replaceFace(side.face, verts)
			end
			-- Other faces at a and b take the strip's end rows in a's place.
			for _, pair in { { a, rowsA }, { b, rowsB } } do
				local vert, rows = pair[1], pair[2]
				for _, face in sortedKeys(self.vertFaces[vert] or {}) do
					local verts = self.faces[face].verts
					local index = table.find(verts, vert)
					local before, after = verts[(index - 2) % #verts + 1], verts[index % #verts + 1]
					-- The row runs from the end that touches `before`.
					local list = {}
					for k = 0, segments do
						table.insert(list, rows[k])
					end
					if self:edge(before, rows[segments]) or self:edge(rows[0], after) then
						local reversed = {}
						for k = #list, 1, -1 do
							table.insert(reversed, list[k])
						end
						list = reversed
					end
					local replaced = {}
					for i, v in verts do
						if v == vert then
							for _, r in list do
								table.insert(replaced, r)
							end
						else
							table.insert(replaced, v)
						end
					end
					self:replaceFace(face, replaced)
				end
			end
			-- The strip itself, wound to match face 1 (it runs rowsA[k] -> rowsB[k]
			-- the way face 1 ran a -> b).
			local verts1 = self.faces[sides[1].face].verts
			local i1 = table.find(verts1, rowsA[0])
			local forward = verts1[i1 % #verts1 + 1] == rowsB[0]
			for k = 0, segments - 1 do
				local quad = if forward
					then { rowsA[k + 1], rowsB[k + 1], rowsB[k], rowsA[k] }
					else { rowsB[k + 1], rowsA[k + 1], rowsA[k], rowsB[k] }
				local id = self:addFace(quad)
				made[id] = true
			end
		end)
		-- The old edge's corners belong to no face now.
		for _, vert in { a, b } do
			if self.verts[vert] and next(self.vertFaces[vert]) == nil then
				self.verts[vert] = nil
				self.vertFaces[vert] = nil
				self.vertEdges[vert] = nil
			end
		end
	end
	return setmetatable({ mesh = self, kind = "face", ids = made }, EditMesh.Selection)
end

-- ---------------------------------------------------------------- whole-mesh tools

-- Appends a copy of another mesh into this one. Returns the copy's faces.
function EditMesh:append(other)
	local map, made = {}, {}
	for _, vert in sortedKeys(other.verts) do
		local p = other.verts[vert].position
		map[vert] = self:addVertex(p[1], p[2], p[3])
	end
	for _, face in sortedKeys(other.faces) do
		local verts = {}
		for index, vert in other.faces[face].verts do
			verts[index] = map[vert]
		end
		made[self:addFace(verts, other.faces[face].tags)] = true
	end
	for _, edge in sortedKeys(other.edges) do
		local e = other.edges[edge]
		local mine = self:edge(map[e.a], map[e.b])
		if mine then
			self.edges[mine].crease = e.crease
		end
	end
	return setmetatable({ mesh = self, kind = "face", ids = made }, EditMesh.Selection)
end

-- Mirrors across the plane where `axis` (x, y or z) equals `at` (default
-- 0): adds a flipped copy and welds the seam, for shapes built one side at
-- a time. Faces lying on the plane should be removed first (the seam is
-- then an open rim the two halves close up).
function EditMesh:mirror(axis, at, distance)
	local k = AXES[axis or "x"]
	at = at or 0
	local half = self:copy()
	half:transform(function(p)
		p[k] = 2 * at - p[k]
		return p
	end)
	half:flip()
	local made = self:append(half)
	self:weld(distance or 1e-4)
	return made
end

-- Gives an open sheet thickness: an offset copy along the vertex normals
-- (inward for negative), turned over, joined to the sheet round its rims.
function EditMesh:solidify(thickness)
	local inner = self:copy()
	local normals = {}
	for vert in self.verts do
		normals[vert] = self:vertexNormal(vert)
	end
	local ids = sortedKeys(self.verts)
	local innerIds = sortedKeys(inner.verts)
	for index, vert in ids do
		local p = inner.verts[innerIds[index]].position
		inner.verts[innerIds[index]].position = vec.sub(p, vec.scale(normals[vert], thickness))
	end
	local rims = {}
	for edge, _ in self.edges do
		if self:count(self.edgeFaces[edge]) == 1 then
			rims[edge] = true
		end
	end
	inner:flip()
	local before = self.nextVert
	self:append(inner)
	-- Join each rim edge to its copy: vertices map by order of creation.
	local offset = {}
	for index, vert in ids do
		offset[vert] = before + index - 1
	end
	for edge in rims do
		local e = self.edges[edge]
		local face = sortedKeys(self.edgeFaces[edge])[1]
		local verts = self.faces[face].verts
		local i = table.find(verts, e.a)
		local a, b = e.a, e.b
		if verts[i % #verts + 1] ~= e.b then
			a, b = e.b, e.a
		end
		self:addFace({ b, a, offset[a], offset[b] })
	end
	return self
end

-- Adds `count - 1` copies, each `offset` ({x, y, z}) on from the last.
function EditMesh:array(count, offset, weldDistance)
	local base = self:copy()
	for k = 1, count - 1 do
		local piece = base:copy()
		piece:transform(function(p)
			return vec.add(p, vec.scale(offset, k))
		end)
		self:append(piece)
	end
	if weldDistance then
		self:weld(weldDistance)
	end
	return self
end
-- Edit Shapes: starting shapes for an Edit Mesh, each built with
-- four-sided faces (no triangle fans at caps or poles) so every operation
-- works on them. Include after EditMesh and EditOps: `-- include: EditShapes`.
--
-- Every shape is centred on the origin unless it says otherwise; move it
-- with m:translate. Sizes are studs, z up.
--
--   EditMesh.box({sx, sy, sz}, {nx, ny, nz})        cuts per side, default 1
--   EditMesh.lattice(xs, ys, zs)                    a box with cuts at the
--                                                   given coordinates
--   EditMesh.roundedBox({sx, sy, sz}, radius, segments, {nx, ny, nz})
--                                                   cuts across the flat faces
--   EditMesh.grid(sx, sy, nx, ny)                   flat, facing +z, open
--   EditMesh.disk(radius, sides)                    flat, facing +z, open
--   EditMesh.circle(radius, sides)                  one face, facing +z
--   EditMesh.cylinder(radius, height, sides, rings) sides a multiple of 4
--   EditMesh.cone(bottom, top, height, sides, rings)
--   EditMesh.sphere(radius, segments)
--   EditMesh.capsule(radius, length, segments)
--   EditMesh.torus(major, minor, sides, ringSides)
--   EditMesh.tube(outer, inner, height, sides)      a pipe with thickness
--   EditMesh.prism(sides, radius, height)           n-sided caps
--   EditMesh.wedge({sx, sy, sz})                    slopes up toward +y
--   EditMesh.arch(radius, thickness, depth, segments) a half ring over x
--   EditMesh.spin(profile, sides, degrees)          lathe a {r, z} profile
--   EditMesh.sweep(profile, path, options)          a {u, v} outline along
--                                                   a path of {x, y, z}
--   EditMesh.coil(radius, wire, turns, pitch, sides, steps)

local function shapeRange(low, high, cuts)
	local list = {}
	for i = 0, cuts do
		list[i + 1] = low + (high - low) * i / cuts
	end
	return list
end

function EditMesh:translate(x, y, z)
	return self:transform(function(p)
		return { p[1] + x, p[2] + y, p[3] + z }
	end)
end

-- The surface of a box whose cuts fall at the given coordinates along each
-- axis (each list low to high).
function EditMesh.lattice(xs, ys, zs)
	local m = EditMesh.new()
	local nx, ny, nz = #xs - 1, #ys - 1, #zs - 1
	local ids = {}
	local function at(i, j, k)
		local key = i .. "," .. j .. "," .. k
		if not ids[key] then
			ids[key] = m:addVertex(xs[i + 1], ys[j + 1], zs[k + 1])
		end
		return ids[key]
	end
	for i = 0, nx - 1 do
		for j = 0, ny - 1 do
			m:addFace({ at(i, j, 0), at(i, j + 1, 0), at(i + 1, j + 1, 0), at(i + 1, j, 0) })
			m:addFace({ at(i, j, nz), at(i + 1, j, nz), at(i + 1, j + 1, nz), at(i, j + 1, nz) })
		end
	end
	for i = 0, nx - 1 do
		for k = 0, nz - 1 do
			m:addFace({ at(i, 0, k), at(i + 1, 0, k), at(i + 1, 0, k + 1), at(i, 0, k + 1) })
			m:addFace({ at(i, ny, k), at(i, ny, k + 1), at(i + 1, ny, k + 1), at(i + 1, ny, k) })
		end
	end
	for j = 0, ny - 1 do
		for k = 0, nz - 1 do
			m:addFace({ at(0, j, k), at(0, j, k + 1), at(0, j + 1, k + 1), at(0, j + 1, k) })
			m:addFace({ at(nx, j, k), at(nx, j + 1, k), at(nx, j + 1, k + 1), at(nx, j, k + 1) })
		end
	end
	return m
end

function EditMesh.box(size, cuts)
	size = size or { 1, 1, 1 }
	cuts = cuts or { 1, 1, 1 }
	return EditMesh.lattice(
		shapeRange(-size[1] / 2, size[1] / 2, cuts[1]),
		shapeRange(-size[2] / 2, size[2] / 2, cuts[2]),
		shapeRange(-size[3] / 2, size[3] / 2, cuts[3])
	)
end

-- A box with its edges and corners rounded to `radius`, in `segments`
-- quads round each edge, its flat faces cut `cuts` times along each axis.
function EditMesh.roundedBox(size, radius, segments, cuts)
	segments = segments or 3
	cuts = cuts or { 1, 1, 1 }
	local axisIndex = 0
	local function axis(length)
		axisIndex += 1
		local h = length / 2
		local r = math.min(radius, h)
		local list = {}
		for k = 0, segments do
			table.insert(list, -h + r * k / segments)
		end
		if h - r > -h + r + 1e-9 then
			local middle = cuts[axisIndex]
			for k = 1, middle do
				table.insert(list, -h + r + (2 * (h - r)) * k / middle)
			end
		end
		for k = 1, segments do
			table.insert(list, h - r + r * k / segments)
		end
		return list, h - r
	end
	local xs, ix = axis(size[1])
	local ys, iy = axis(size[2])
	local zs, iz = axis(size[3])
	local m = EditMesh.lattice(xs, ys, zs)
	local inner = { ix, iy, iz }
	m:transform(function(p)
		local core = {}
		for a = 1, 3 do
			core[a] = math.clamp(p[a], -inner[a], inner[a])
		end
		local out = EditMesh.vec.sub(p, core)
		if EditMesh.vec.length(out) < 1e-9 then
			return p
		end
		return EditMesh.vec.add(core, EditMesh.vec.scale(EditMesh.vec.unit(out), math.min(radius, size[1] / 2, size[2] / 2, size[3] / 2)))
	end)
	m:weld(1e-7)
	return m
end

-- A flat open sheet sx by sy at z = 0, facing +z.
function EditMesh.grid(sx, sy, nx, ny)
	nx, ny = nx or 1, ny or 1
	local m = EditMesh.new()
	local ids = {}
	for j = 0, ny do
		for i = 0, nx do
			ids[i .. "," .. j] = m:addVertex(-sx / 2 + sx * i / nx, -sy / 2 + sy * j / ny, 0)
		end
	end
	for j = 0, ny - 1 do
		for i = 0, nx - 1 do
			m:addFace({ ids[i .. "," .. j], ids[(i + 1) .. "," .. j], ids[(i + 1) .. "," .. (j + 1)], ids[i .. "," .. (j + 1)] })
		end
	end
	return m
end

-- Maps a point of the square [-1, 1]^2 onto the unit disk, keeping grid
-- lines smooth (so a square grid becomes a round one of quads).
local function squareToDisk(x, y)
	return x * math.sqrt(math.max(0, 1 - y * y / 2)), y * math.sqrt(math.max(0, 1 - x * x / 2))
end

-- A flat open disk of quads at z = 0, facing +z: `sides` round the rim (a
-- multiple of 4).
function EditMesh.disk(radius, sides)
	local n = math.max(1, (sides or 16) // 4)
	local m = EditMesh.grid(2, 2, n, n)
	return m:transform(function(p)
		local x, y = squareToDisk(p[1], p[2])
		return { x * radius, y * radius, 0 }
	end)
end

-- One flat face with `sides` corners at z = 0, facing +z (to extrude from).
function EditMesh.circle(radius, sides)
	local m = EditMesh.new()
	local verts = {}
	for k = 0, sides - 1 do
		local t = k / sides * 2 * math.pi
		verts[k + 1] = m:addVertex(math.cos(t) * radius, math.sin(t) * radius, 0)
	end
	m:addFace(verts)
	return m
end

-- A cylinder along z: caps of quads, `sides` round (a multiple of 4),
-- `rings` cuts along its height.
function EditMesh.cylinder(radius, height, sides, rings)
	local n = math.max(1, (sides or 16) // 4)
	local m = EditMesh.box({ 2, 2, height }, { n, n, rings or 1 })
	return m:transform(function(p)
		local x, y = squareToDisk(math.clamp(p[1], -1, 1), math.clamp(p[2], -1, 1))
		return { x * radius, y * radius, p[3] }
	end)
end

-- A cylinder whose radius runs from `bottom` to `top` (top may be small,
-- never zero: cap it with a point by poking the top face if needed).
function EditMesh.cone(bottom, top, height, sides, rings)
	local m = EditMesh.cylinder(1, height, sides, rings)
	return m:transform(function(p)
		local t = (p[3] + height / 2) / height
		local r = bottom + (top - bottom) * t
		return { p[1] * r, p[2] * r, p[3] }
	end)
end

-- A sphere of quads: a cut box pulled round evenly.
function EditMesh.sphere(radius, segments)
	local n = math.max(1, (segments or 16) // 4)
	local m = EditMesh.box({ 2, 2, 2 }, { n, n, n })
	return m:transform(function(p)
		local x, y, z = p[1], p[2], p[3]
		local x2, y2, z2 = x * x, y * y, z * z
		return {
			radius * x * math.sqrt(math.max(0, 1 - y2 / 2 - z2 / 2 + y2 * z2 / 3)),
			radius * y * math.sqrt(math.max(0, 1 - z2 / 2 - x2 / 2 + z2 * x2 / 3)),
			radius * z * math.sqrt(math.max(0, 1 - x2 / 2 - y2 / 2 + x2 * y2 / 3)),
		}
	end)
end

-- A pill along z: a sphere split at its middle and drawn apart by `length`.
function EditMesh.capsule(radius, length, segments)
	segments = segments or 16
	-- An even number of cuts puts a ring exactly on the equator.
	local n = math.max(2, (segments // 4) // 2 * 2)
	local m = EditMesh.sphere(radius, n * 4)
	m:transform(function(p)
		if p[3] > 1e-9 then
			return { p[1], p[2], p[3] + length / 2 }
		elseif p[3] < -1e-9 then
			return { p[1], p[2], p[3] - length / 2 }
		end
		return p
	end)
	return m
end

-- A ring: `major` from the centre to the middle of the tube, `minor` the
-- tube's radius, in the xy plane.
function EditMesh.torus(major, minor, sides, ringSides)
	sides, ringSides = sides or 24, ringSides or 12
	local m = EditMesh.new()
	local ids = {}
	for i = 0, sides - 1 do
		local u = i / sides * 2 * math.pi
		for j = 0, ringSides - 1 do
			local v = j / ringSides * 2 * math.pi
			local r = major + minor * math.cos(v)
			ids[i * ringSides + j] = m:addVertex(r * math.cos(u), r * math.sin(u), minor * math.sin(v))
		end
	end
	for i = 0, sides - 1 do
		local i2 = (i + 1) % sides
		for j = 0, ringSides - 1 do
			local j2 = (j + 1) % ringSides
			m:addFace({ ids[i * ringSides + j], ids[i2 * ringSides + j], ids[i2 * ringSides + j2], ids[i * ringSides + j2] })
		end
	end
	return m
end

-- A pipe along z with a wall: `outer` and `inner` radii.
function EditMesh.tube(outer, inner, height, sides)
	sides = sides or 16
	local m = EditMesh.new()
	local rings = {}
	-- Four rings round the section: outer bottom, outer top, inner top, inner bottom.
	local section = { { outer, -height / 2 }, { outer, height / 2 }, { inner, height / 2 }, { inner, -height / 2 } }
	for i = 0, sides - 1 do
		local t = i / sides * 2 * math.pi
		rings[i] = {}
		for k, point in section do
			rings[i][k] = m:addVertex(math.cos(t) * point[1], math.sin(t) * point[1], point[2])
		end
	end
	for i = 0, sides - 1 do
		local a, b = rings[i], rings[(i + 1) % sides]
		for k = 1, 4 do
			local k2 = k % 4 + 1
			m:addFace({ a[k], b[k], b[k2], a[k2] })
		end
	end
	return m
end

-- An upright prism with n-sided caps.
function EditMesh.prism(sides, radius, height)
	local m = EditMesh.circle(radius, sides)
	m:translate(0, 0, -height / 2)
	-- Lifting the cap makes the sides; the hole it leaves below is closed.
	m:extrude(m:select("face", "all"), { 0, 0, height })
	m:fill(m:select("edge", "where", function(p)
		return p[3] < 0
	end))
	return m
end

-- A wedge: a box whose top slopes from nothing at -y to full height at +y.
function EditMesh.wedge(size)
	local sx, sy, sz = size[1] / 2, size[2] / 2, size[3]
	local m = EditMesh.new()
	local a = m:addVertex(-sx, -sy, 0)
	local b = m:addVertex(sx, -sy, 0)
	local c = m:addVertex(sx, sy, 0)
	local d = m:addVertex(-sx, sy, 0)
	local e = m:addVertex(-sx, sy, sz)
	local f = m:addVertex(sx, sy, sz)
	m:addFace({ a, d, c, b }) -- bottom
	m:addFace({ d, e, f, c }) -- back (+y)
	m:addFace({ a, b, f, e }) -- slope
	m:addFace({ a, e, d }) -- left
	m:addFace({ b, c, f }) -- right
	return m
end

-- A half ring standing over the x axis, its ends on the ground at
-- x = +-(radius + thickness): inner radius `radius`, `thickness` thick,
-- `depth` deep along y, in `segments` quads round.
function EditMesh.arch(radius, thickness, depth, segments)
	segments = segments or 12
	local m = EditMesh.box({ 1, depth, thickness }, { segments, 1, 1 })
	m:transform(function(p)
		local angle = (p[1] + 0.5) * math.pi
		local r = radius + p[3] + thickness / 2
		return { r * math.cos(angle), p[2], r * math.sin(angle) }
	end)
	-- The map turns the box inside out; turn it back.
	m:flip()
	return m
end

-- Lathe: turns a profile of {r, z} points (bottom to top) about z. A full
-- turn closes up; ends on the axis (r = 0) close with a point.
function EditMesh.spin(profile, sides, degrees)
	sides = sides or 16
	degrees = degrees or 360
	local full = degrees >= 360 - 1e-9
	local steps = if full then sides else sides + 1
	local m = EditMesh.new()
	local columns = {}
	for s = 0, steps - 1 do
		local t = math.rad(degrees) * s / sides
		columns[s] = {}
		for k, point in profile do
			if point[1] < 1e-9 and s > 0 then
				columns[s][k] = columns[0][k]
			else
				columns[s][k] = m:addVertex(point[1] * math.cos(t), point[1] * math.sin(t), point[2])
			end
		end
	end
	local last = if full then steps - 1 else steps - 2
	for s = 0, last do
		local a, b = columns[s], columns[(s + 1) % steps]
		for k = 1, #profile - 1 do
			local quad = { a[k], b[k], b[k + 1], a[k + 1] }
			local unique, seen = {}, {}
			for _, vert in quad do
				if not seen[vert] then
					seen[vert] = true
					table.insert(unique, vert)
				end
			end
			if #unique >= 3 then
				m:addFace(unique)
			end
		end
	end
	return m
end

-- A frame along a path that turns as little as it can (parallel
-- transport), as {tangent, normal, binormal} per point.
local function pathFrames(path, closed)
	local frames = {}
	local count = #path
	local function tangent(i)
		local prev = path[if i > 1 then i - 1 elseif closed then count else i]
		local nxt = path[if i < count then i + 1 elseif closed then 1 else i]
		return EditMesh.vec.unit(EditMesh.vec.sub(nxt, prev))
	end
	local t = tangent(1)
	local helper = if math.abs(t[3]) < 0.9 then { 0, 0, 1 } else { 1, 0, 0 }
	local n = EditMesh.vec.unit(EditMesh.vec.cross(helper, t))
	for i = 1, count do
		local ti = tangent(i)
		-- Remove the part of the last normal along the new tangent.
		n = EditMesh.vec.unit(EditMesh.vec.sub(n, EditMesh.vec.scale(ti, EditMesh.vec.dot(n, ti))))
		frames[i] = { ti, n, EditMesh.vec.cross(ti, n) }
	end
	return frames
end

-- Sweeps an outline of {u, v} points (counter-clockwise looking down the
-- path) along a path of {x, y, z} points. options.closed joins the path
-- into a loop; otherwise each end gets a cap face (options.caps = false
-- leaves them open). options.scale(t) sizes the outline along the path
-- (t from 0 to 1), options.twist degrees over its length.
function EditMesh.sweep(profile, path, options)
	options = options or {}
	local m = EditMesh.new()
	local frames = pathFrames(path, options.closed)
	local rings = {}
	for i, point in path do
		local t = (i - 1) / math.max(1, #path - 1)
		local size = if options.scale then options.scale(t) else 1
		local turn = math.rad((options.twist or 0) * t)
		local c, s = math.cos(turn), math.sin(turn)
		local frame = frames[i]
		rings[i] = {}
		for k, uv in profile do
			local u = (uv[1] * c - uv[2] * s) * size
			local v = (uv[1] * s + uv[2] * c) * size
			local p = EditMesh.vec.add(point, EditMesh.vec.add(EditMesh.vec.scale(frame[2], u), EditMesh.vec.scale(frame[3], v)))
			rings[i][k] = m:addVertex(p[1], p[2], p[3])
		end
	end
	local count = #path
	local segments = if options.closed then count else count - 1
	for i = 1, segments do
		local a, b = rings[i], rings[i % count + 1]
		for k = 1, #profile do
			local k2 = k % #profile + 1
			m:addFace({ a[k], a[k2], b[k2], b[k] })
		end
	end
	if not options.closed and options.caps ~= false then
		local first, lastRing = {}, {}
		for k = #profile, 1, -1 do
			table.insert(first, rings[1][k])
		end
		for k = 1, #profile do
			table.insert(lastRing, rings[count][k])
		end
		m:addFace(first)
		m:addFace(lastRing)
	end
	return m
end

-- A coil spring: `turns` turns of radius `radius` rising `pitch` per turn,
-- wound from wire `wire` thick with `sides` round it.
function EditMesh.coil(radius, wire, turns, pitch, sides, steps)
	sides, steps = sides or 8, steps or 24
	local path = {}
	local total = math.ceil(turns * steps)
	for i = 0, total do
		local t = i / steps * 2 * math.pi
		table.insert(path, { radius * math.cos(t), radius * math.sin(t), pitch * i / steps })
	end
	local outline = {}
	for k = 0, sides - 1 do
		local t = k / sides * 2 * math.pi
		table.insert(outline, { math.cos(t) * wire, math.sin(t) * wire })
	end
	return EditMesh.sweep(outline, path)
end
-- The hand-painted finish for a model's parts: `coats` names a part's hand coat
-- ("metal", "wood" or "rock"), `plain` lists parts left alone, such as lamps. A
-- crisp part with a hand coat keeps its exact shapes and takes only the
-- brushwork's tone. `finish` maps coat names and part names to a preset below,
-- for props standing alone on open ground; the town models leave it nil.
-- Call it just before finishParts().
local SMALL_MARKS = {
	big_length_min = 0.4,
	big_length_max = 0.75,
	big_width_min = 0.14,
	big_width_max = 0.28,
	mid_length_min = 0.2,
	mid_length_max = 0.4,
	mid_width_min = 0.07,
	mid_width_max = 0.13,
	edge_opacity = 0,
}

-- One preset per material, so tuning concrete never moves steel. A number a
-- model set on the part before handFinish wins over the preset's. `bands`
-- paints the stepped gradient: `steps` (default by height), `drop` (how dark
-- the lowest step goes), `top` (the top step's brightness), `facing` (loose
-- pieces each lit from above) and `stain` (how far a short part's steps wander
-- as blotches instead of bands; high values fleck a dark surface).
local PRESETS = {
	-- Steel standing alone on open ground.
	propMetal = { gradient = 0.2, shade = 2, rustEdges = true, edge = 0.3, lit = 1.6, litUneven = 0.85, bands = { drop = 0.48, top = 1 } },
	-- Concrete footings and plinths.
	propConcrete = { gradient = 0.4, shade = 2, rustEdges = true, edge = 0.3, lit = 1.28, litUneven = 0.85, bands = { drop = 0.48, top = 1 } },
	-- Stones on the map, banded from the turf up by the bandDepth the layout gives them.
	rock = { gradient = 0.4, shade = 1, rustEdges = true, edge = 0.3, lit = 1.28, litUneven = 0.85, bands = { steps = 4, drop = 0.32, top = 1 } },
	-- Loose pieces lying on a heap, each banded on its own from the model's bandPieces.
	heapPiece = { gradient = 0.2, shade = 1.4, rustEdges = true, edge = 0.3, lit = 1.8, litUneven = 0.85, bands = { steps = 4, drop = 0.58, top = 1, facing = true } },
	-- The earth body of a heap: it darkens well under everything resting on it.
	heapBody = { gradient = 0.4, shade = 1.8, rustEdges = true, edge = 0.45, lit = 1.0, litUneven = 0.85, softLit = 0, bands = { drop = 0.48, top = 1, stain = 0.08 } },
}
-- The finish most props take.
local PROP_FINISH = { metal = "propMetal", rock = "propConcrete" }

-- Light at the top, stepping down to dark and cool at the base. The hand coat
-- samples this per stroke, so each step's edge comes out brushed, not ruled.
local function paintStepBands(entry, bands)
	if entry.crisp and not entry.bandCrisp then
		return
	end
	-- The part's height range, read off a scratch paint of its surface.
	local low, high = math.huge, -math.huge
	entry.mesh:paint(Image.new(32, 32), function(_x, _y, z)
		low, high = math.min(low, z), math.max(high, z)
		return 0, 0, 0
	end)
	if high - low < 0.25 then
		return
	end
	-- Loose pieces listed as { x, y, z, radius } each band from their own top to
	-- their own foot, instead of all sharing the part's height.
	if entry.bandPieces then
		local pieces = entry.bandPieces
		entry.bandDepth = function(x: number, y: number, z: number): number
			local nearest, best = pieces[1], math.huge
			for _, piece in pieces do
				local d = (x - piece[1]) ^ 2 + (y - piece[2]) ^ 2 + (z - piece[3]) ^ 2
				if d < best then
					nearest, best = piece, d
				end
			end
			return 1 - math.clamp((z - nearest[3] + nearest[4]) / (2 * nearest[4]), 0, 1)
		end
	end
	-- Tall parts get more steps, so any stretch of them shows some.
	local steps = bands.steps or math.clamp(math.round((high - low) / 1.5), 4, 8)
	local drop, top = bands.drop, bands.top
	local paint = entry.paint
	entry.custom = true
	entry.paint = function(x: number, y: number, z: number, nx: number, ny: number, nz: number)
		local r, g, b = paint(x, y, z, nx, ny, nz)
		local depth = if entry.bandDepth then entry.bandDepth(x, y, z) else 1 - (z - low) / (high - low)
		if bands.facing then
			depth = depth * 0.3 + (1 - nz) * 0.35
		end
		depth += 0.07 * math.noise(x * 0.7, y * 0.7, z * 0.35)
		-- A short part has no height to band, so it stains in steps instead.
		if high - low < 1.5 then
			depth += (bands.stain or 0.4) * math.noise(x * 0.5, y * 0.5, z * 0.3)
		end
		local step = math.clamp(math.floor(depth * steps), 0, steps - 1) / (steps - 1)
		-- A small lift at the top, so near-black paint still shows its steps.
		local lift = (1 - step) * 0.22 * (1 - math.max(r, g, b)) ^ 2
		return r * (top - drop * step) + lift, g * (top - (drop + 0.02) * step) + lift, b * (top - (drop - 0.08) * step) + lift
	end
end

local function applyPreset(entry, preset)
	entry.gradient = entry.gradient or preset.gradient
	entry.shade = entry.shade or preset.shade
	entry.edge = entry.edge or preset.edge
	entry.lit = entry.lit or preset.lit
	entry.litUneven = preset.litUneven
	if entry.rustEdges == nil then
		entry.rustEdges = preset.rustEdges
	end
	-- Earth has no edge for the soft highlight to glow along; it flecks the rim.
	if preset.softLit then
		entry.softLit = preset.softLit
	end
	entry.handTune = SMALL_MARKS
	paintStepBands(entry, preset.bands)
end

local function handFinish(coats, plain, finish)
	for _, entry in parts do
		-- A chunked part takes the coat of the name it was built under.
		local name = string.match(entry.name, "^(.-)_%-?%d+_%-?%d+_%-?%d+$") or entry.name
		if plain[name] then
			continue
		end
		entry.hand = coats[name]
		if entry.hand == nil then
			entry.litMotion = "worn"
		elseif entry.hand == "metal" then
			entry.handTune = SMALL_MARKS
		end
		entry.softLit, entry.softEdge, entry.softUneven, entry.softTaper = 0.25, 0.22, 0, 0.8
		entry.softToZero, entry.softPower = true, 2
		entry.taper = entry.taper or 0.5
		entry.litToZero, entry.litUneven, entry.litUnevenStep = true, 0.6, 0.5
		entry.brushes = { shade = { motion = "feather", tune = { width = 0.02 } } }
		local presetName = finish and (finish[name] or finish[entry.hand])
		if presetName then
			applyPreset(entry, PRESETS[presetName] or error(`no finish preset {presetName}`))
		end
	end
end
useTexelDensity(16)

local BELT_RADIUS, BELT_HALF_WIDTH = 72, 2.5
local BELT_TOP, RAIL_TOP, RAIL_WIDE = 0.6, 0.95, 0.45
-- The shed: its middle out from the hub (so each mouth is centred on the
-- belt where the belt crosses it), half its width and length, its height.
local SHED_X, SHED_HALF_WIDE, SHED_HALF_LONG, SHED_TALL = 71.55, 7, 8, 8.35
local MOUTH_HALF, MOUTH_TALL = 3.5, 6.6
local FRAME = 0.8
-- The roof: its eaves' overhang, the height of its eaves and of its ridge,
-- which runs along the belt.
local ROOF_OVER, EAVES, RIDGE = 0.6, 8.3, 11

local STEEL = { 0.42, 0.5, 0.56 }
local ROOF_STEEL = { 0.3, 0.36, 0.42 }
local DARK_STEEL = { 0.2, 0.21, 0.24 }
local CONCRETE = { 0.62, 0.6, 0.56 }
local YELLOW = { 0.86, 0.64, 0.16 }
local BLACK_PAINT = { 0.08, 0.08, 0.09 }
local RUBBER = { 0.14, 0.14, 0.15 }
local RAIL_STEEL = { 0.36, 0.37, 0.4 }
local ORANGE = { 0.72, 0.4, 0.16 }
local BRASS = { 0.86, 0.68, 0.32 }
local SILVER = { 0.72, 0.74, 0.77 }

-- A steady pseudo-random number in -1..1 for whole numbers a, b.
local function jitter(a: number, b: number): number
	local s = math.sin(a * 127.1 + b * 311.7) * 43758.5453
	return 2 * (s - math.floor(s)) - 1
end
-- Turns a closed mesh's faces outward if they were built facing in.
local function faceOut(m)
	local volume = 0
	for face in m.faces do
		local c, n = m:faceCentre(face), m:faceNormal(face)
		volume += EditMesh.vec.dot(c, n) * m:faceArea(face)
	end
	if volume < 0 then
		m:flip()
	end
end
-- Height of the roof's top `dx` out from the shed's middle.
local function roofAt(dx: number): number
	return RIDGE - math.abs(dx) * (RIDGE - EAVES) / (SHED_HALF_WIDE + ROOF_OVER)
end
-- The last part added gets bold painted rims with a wide soft highlight
-- under them.
local function paintedRims()
	parts[#parts].painted = true
	parts[#parts].blend = 0.7
	parts[#parts].taper = 0.8
	parts[#parts].softLit = 0.18
	parts[#parts].softEdge = 1.2
	parts[#parts].softUneven = 0.6
	parts[#parts].softTaper = 1.5
end
-- Machine finishes (hazard tape, ribbed rubber) go on crisp, texel by
-- texel, instead of as brush strokes that would smear them: the last part,
-- or every chunk of the chunked part `group`.
local function crisp(group: string?)
	for _, entry in parts do
		if (group == nil and entry == parts[#parts]) or (group ~= nil and entry.group == group) then
			entry.crisp = true
		end
	end
end

-- ---------------------------------------------------------- the factory

-- Corrugated steel on a concrete footing: each sheet its own tone, a dark
-- seam with rivets halfway up, rust weeping down from the rivets.
local function shedPaint(x: number, y: number, z: number): (number, number, number)
	if z < 0.5 then
		local k = 0.92 + 0.08 * math.noise(x * 0.8, y * 0.8, 3.1)
		return CONCRETE[1] * k, CONCRETE[2] * k, CONCRETE[3] * k
	end
	local along = if math.abs(x - SHED_X) > SHED_HALF_WIDE - 0.5 then y else x
	local sheet = math.floor(along / 2)
	local k = 0.94 + 0.09 * jitter(sheet, if z > SHED_TALL / 2 then 1 else 2) + 0.09 * math.sin(along * math.pi * 2.5)
	local seam = math.abs(z - SHED_TALL / 2)
	-- The upper sheets lap the lower ones: a row of rivet heads along the
	-- lap, a little rust streaking down from it, no open seam line.
	local rust = math.clamp(0.2 + math.noise(along * 0.5, z * 0.25, 7.3) - 0.3 * seam, 0, 1) * (if seam < 1.5 and z < SHED_TALL / 2 then 0.3 else 0.1)
	local rivet = (along - math.floor(along)) - 0.5
	if seam < 0.12 and math.abs(rivet) < 0.08 then
		k *= 0.72
	end
	return STEEL[1] * k + (0.46 - STEEL[1] * k) * rust, STEEL[2] * k + (0.27 - STEEL[2] * k) * rust, STEEL[3] * k + (0.16 - STEEL[3] * k) * rust
end
part("Shed", nil, STEEL, function(mesh)
	-- The long walls.
	for _, flank in { -1, 1 } do
		box(mesh, SHED_X + flank * (SHED_HALF_WIDE - 0.2), 0, 0, 0.4, 2 * SHED_HALF_LONG, SHED_TALL)
		box(mesh, SHED_X + flank * SHED_HALF_WIDE, 0, 0, 0.9, 2 * SHED_HALF_LONG + 0.9, 0.5)
	end
	-- The end walls, either side of each mouth and over it.
	for _, side in { -1, 1 } do
		local y = side * (SHED_HALF_LONG - 0.2)
		-- Each end panel runs a little into the long wall beside it.
		local wide = SHED_HALF_WIDE - MOUTH_HALF - 0.2
		for _, flank in { -1, 1 } do
			box(mesh, SHED_X + flank * (MOUTH_HALF + wide / 2), y, 0, wide, 0.38, SHED_TALL - 0.02)
			box(mesh, SHED_X + flank * (MOUTH_HALF + wide / 2), side * SHED_HALF_LONG, 0, wide, 0.86, 0.46)
			-- A concrete sill from the jamb to the belt's rail.
			box(mesh, SHED_X + flank * (MOUTH_HALF - 0.45), y, 0, 0.9, 0.3, 0.26)
		end
		box(mesh, SHED_X, y, MOUTH_TALL, 2 * MOUTH_HALF + 0.1, 0.36, SHED_TALL - MOUTH_TALL)
	end
end, nil, shedPaint, nil, nil, true, 0.35)
paintedRims()

part("Roof", nil, ROOF_STEEL, function(mesh)
	local x0, x1 = SHED_X - SHED_HALF_WIDE - ROOF_OVER, SHED_X + SHED_HALF_WIDE + ROOF_OVER
	local y0, y1 = -SHED_HALF_LONG - ROOF_OVER, SHED_HALF_LONG + ROOF_OVER
	local a, b, c = mesh:vertex(x0, y0, EAVES), mesh:vertex(x1, y0, EAVES), mesh:vertex(SHED_X, y0, RIDGE)
	local d, e, f = mesh:vertex(x0, y1, EAVES), mesh:vertex(x1, y1, EAVES), mesh:vertex(SHED_X, y1, RIDGE)
	mesh:face({ a, b, c })
	mesh:face({ d, f, e })
	mesh:face({ a, c, f, d })
	mesh:face({ b, e, f, c })
	mesh:face({ a, d, e, b })
end, nil, function(x, y, z)
	-- Standing seams up each slope, a little rust along the eaves.
	local sheet = math.floor(y / 1.6)
	local k = 0.93 + 0.08 * jitter(sheet, 5) + (if y / 1.6 - sheet < 0.09 then 0.22 else 0)
	local rust = math.clamp(0.55 + 0.7 * math.noise(x * 0.4, y * 0.4, 2.2) - (z - EAVES) * 0.5, 0, 1) * 0.3
	return ROOF_STEEL[1] * k + (0.42 - ROOF_STEEL[1] * k) * rust, ROOF_STEEL[2] * k + (0.25 - ROOF_STEEL[2] * k) * rust, ROOF_STEEL[3] * k + (0.16 - ROOF_STEEL[3] * k) * rust
end, nil, nil, true, 0.35)
paintedRims()

part("Frames", nil, YELLOW, function(mesh)
	for _, side in { -1, 1 } do
		local y = side * (SHED_HALF_LONG + 0.1)
		for _, flank in { -1, 1 } do
			box(mesh, SHED_X + flank * (MOUTH_HALF + FRAME / 2), y, 0, FRAME, 0.6, MOUTH_TALL + FRAME)
		end
		box(mesh, SHED_X, y, MOUTH_TALL + 0.01, 2 * MOUTH_HALF + 0.1, 0.56, FRAME - 0.06)
	end
end, nil, function(x, _y, z)
	-- Factory hazard tape down the uprights: crisp even 45-degree stripes,
	-- no brush marks; the top beam stays yellow.
	if z < MOUTH_TALL and (z + math.abs(x - SHED_X)) % 1.1 < 0.55 then
		return BLACK_PAINT[1], BLACK_PAINT[2], BLACK_PAINT[3]
	end
	return YELLOW[1], YELLOW[2], YELLOW[3]
end, nil, nil, true, 0.12, nil, 0.35)
