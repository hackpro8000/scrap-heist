# Place files are built from source, never committed
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Wally installs these
Packages/
ServerPackages/
DevPackages/

# Generated by Rojo / luau-lsp
sourcemap.json

# Blender backup saves
*.blend1

# Python bytecode
__pycache__/

# modelkit build cache
.cache/

# modelkit outputs (.glb, textures, previews, screenshots) are rebuilt from model.luau
art/models/*/*
!art/models/*/model.luau
!art/models/*/sketch.png

# UI kit outputs; only the kit scripts are source.
art/ui/*/*
!art/ui/*/ui.luau
tools/uikit/target/
